---
/* =========================================================
   PSG WORLD
   Radio Garden Style Interactive Globe

   FEATURES
   ---------------------------------------------------------
   • Interactive 3D globe
   • Click location → smooth close zoom
   • Selected location moves to exact center
   • Fixed glowing center target
   • Location marker
   • Search
   • Location list
   • Details panel
   • Random location
   • Reset globe
   • Auto rotation
   • Country polygons
========================================================= */
---

<style is:global>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;

    font-family:
      Inter,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    background: #020609;
    color: #ffffff;
  }

  body {
    min-height: 100vh;
  }

  button,
  input {
    font: inherit;
  }

  /* =======================================================
     MAIN
  ======================================================= */

  .psg-world {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 50% 45%,
        rgba(0, 255, 150, 0.05),
        transparent 38%
      ),
      #020609;
  }

  /* =======================================================
     GLOBE AREA
  ======================================================= */

  .globe-panel {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  #globe-container {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  #globe-container canvas {
    display: block;
  }

  .globe-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;

    background:
      radial-gradient(
        circle at center,
        transparent 48%,
        rgba(0, 0, 0, 0.08) 65%,
        rgba(0, 0, 0, 0.55) 100%
      );
  }

  /* =======================================================
     TOP HEADER
  ======================================================= */

  .top-bar {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 20px;

    display: flex;
    justify-content: space-between;
    align-items: center;

    z-index: 15;

    pointer-events: none;
  }

  .brand {
    pointer-events: auto;

    display: flex;
    align-items: center;
    gap: 12px;

    padding: 10px 16px;

    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;

    background: rgba(2, 8, 11, 0.72);
    backdrop-filter: blur(16px);

    box-shadow:
      0 10px 40px rgba(0, 0, 0, 0.3),
      inset 0 1px rgba(255, 255, 255, 0.04);
  }

  .brand-dot {
    width: 10px;
    height: 10px;

    border-radius: 50%;

    background: #00ff88;

    box-shadow:
      0 0 8px #00ff88,
      0 0 20px rgba(0, 255, 136, 0.75);

    animation: brandPulse 2s infinite;
  }

  .brand-title {
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 1.2px;
  }

  .brand-subtitle {
    margin-top: 2px;

    color: rgba(255, 255, 255, 0.48);

    font-size: 10px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }

  @keyframes brandPulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }

    50% {
      opacity: 0.55;
      transform: scale(0.8);
    }
  }

  /* =======================================================
     SEARCH
  ======================================================= */

  .search-box {
    pointer-events: auto;

    width: 300px;

    position: relative;
  }

  .search-input {
    width: 100%;
    height: 44px;

    padding: 0 16px 0 42px;

    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 13px;

    outline: none;

    color: #ffffff;

    background: rgba(2, 8, 11, 0.78);
    backdrop-filter: blur(16px);

    box-shadow:
      0 10px 40px rgba(0, 0, 0, 0.3),
      inset 0 1px rgba(255, 255, 255, 0.04);

    transition: 0.2s ease;
  }

  .search-input:focus {
    border-color: rgba(0, 255, 136, 0.5);

    box-shadow:
      0 0 0 3px rgba(0, 255, 136, 0.06),
      0 10px 40px rgba(0, 0, 0, 0.3);
  }

  .search-input::placeholder {
    color: rgba(255, 255, 255, 0.38);
  }

  .search-icon {
    position: absolute;

    left: 15px;
    top: 50%;

    transform: translateY(-50%);

    color: rgba(255, 255, 255, 0.5);

    font-size: 15px;

    pointer-events: none;
  }

  /* =======================================================
     CENTER MARKER
  ======================================================= */

  .center-marker {
    position: absolute;

    left: 50%;
    top: 50%;

    width: 110px;
    height: 110px;

    transform: translate(-50%, -50%);

    z-index: 12;

    pointer-events: none;

    display: none;
  }

  .center-marker.visible {
    display: block;
  }

  .center-marker-dot {
    position: absolute;

    left: 50%;
    top: 50%;

    width: 12px;
    height: 12px;

    transform: translate(-50%, -50%);

    border-radius: 50%;

    background: #ffffff;

    box-shadow:
      0 0 6px #ffffff,
      0 0 14px #00ff88,
      0 0 32px #00ff88,
      0 0 55px rgba(0, 255, 136, 0.8);

    z-index: 5;
  }

  .center-marker-ring {
    position: absolute;

    left: 50%;
    top: 50%;

    width: 30px;
    height: 30px;

    transform: translate(-50%, -50%);

    border: 2px solid #00ff88;

    border-radius: 50%;

    box-shadow:
      0 0 10px #00ff88,
      0 0 28px rgba(0, 255, 136, 0.8);

    animation: centerRing 1.7s ease-out infinite;
  }

  .center-marker-ring-2 {
    position: absolute;

    left: 50%;
    top: 50%;

    width: 60px;
    height: 60px;

    transform: translate(-50%, -50%);

    border: 1px solid rgba(0, 255, 136, 0.35);

    border-radius: 50%;

    animation: centerRing2 2.2s ease-out infinite;
  }

  .center-cross-horizontal,
  .center-cross-vertical {
    position: absolute;

    background: rgba(0, 255, 136, 0.65);

    box-shadow: 0 0 7px rgba(0, 255, 136, 0.5);
  }

  .center-cross-horizontal {
    left: 10px;
    right: 10px;

    top: 54px;

    height: 1px;
  }

  .center-cross-vertical {
    top: 10px;
    bottom: 10px;

    left: 54px;

    width: 1px;
  }

  .center-label {
    position: absolute;

    left: 50%;
    top: 83px;

    transform: translateX(-50%);

    padding: 6px 11px;

    white-space: nowrap;

    color: #ffffff;

    font-size: 11px;
    font-weight: 700;

    border: 1px solid rgba(0, 255, 136, 0.35);

    border-radius: 20px;

    background: rgba(0, 0, 0, 0.78);

    backdrop-filter: blur(10px);

    box-shadow:
      0 5px 20px rgba(0, 0, 0, 0.5),
      0 0 15px rgba(0, 255, 136, 0.08);
  }

  @keyframes centerRing {
    0% {
      width: 22px;
      height: 22px;
      opacity: 1;
    }

    70% {
      width: 72px;
      height: 72px;
      opacity: 0.12;
    }

    100% {
      width: 78px;
      height: 78px;
      opacity: 0;
    }
  }

  @keyframes centerRing2 {
    0% {
      width: 45px;
      height: 45px;
      opacity: 0.5;
    }

    100% {
      width: 90px;
      height: 90px;
      opacity: 0;
    }
  }

  /* =======================================================
     LOCATION MARKERS
  ======================================================= */

  .station-marker {
    position: relative;

    width: 30px;
    height: 30px;

    transform: translate(-50%, -50%);

    cursor: pointer;

    pointer-events: auto;
  }

  .station-marker-ring {
    position: absolute;

    left: 50%;
    top: 50%;

    width: 18px;
    height: 18px;

    transform: translate(-50%, -50%);

    border: 1px solid rgba(0, 255, 136, 0.8);

    border-radius: 50%;

    animation: markerPulse 2s infinite;
  }

  .station-marker-core {
    position: absolute;

    left: 50%;
    top: 50%;

    width: 7px;
    height: 7px;

    transform: translate(-50%, -50%);

    border-radius: 50%;

    background: #00ff88;

    box-shadow:
      0 0 5px #ffffff,
      0 0 12px #00ff88,
      0 0 25px rgba(0, 255, 136, 0.9);
  }

  .station-marker.selected .station-marker-core {
    width: 11px;
    height: 11px;

    background: #ffffff;

    box-shadow:
      0 0 8px #ffffff,
      0 0 18px #00ff88,
      0 0 38px #00ff88;
  }

  .station-marker.selected .station-marker-ring {
    width: 30px;
    height: 30px;

    border-color: #00ff88;

    box-shadow:
      0 0 12px rgba(0, 255, 136, 0.8),
      inset 0 0 10px rgba(0, 255, 136, 0.2);
  }

  .station-tooltip {
    position: absolute;

    left: 50%;
    top: 23px;

    transform: translateX(-50%);

    white-space: nowrap;

    padding: 4px 8px;

    border-radius: 5px;

    color: rgba(255, 255, 255, 0.88);

    font-size: 9px;
    font-weight: 600;

    background: rgba(0, 0, 0, 0.68);

    opacity: 0;

    pointer-events: none;

    transition: 0.18s ease;
  }

  .station-marker:hover .station-tooltip {
    opacity: 1;
  }

  @keyframes markerPulse {
    0% {
      transform: translate(-50%, -50%) scale(0.65);
      opacity: 0.9;
    }

    70% {
      transform: translate(-50%, -50%) scale(1.35);
      opacity: 0;
    }

    100% {
      opacity: 0;
    }
  }

  /* =======================================================
     LEFT LOCATION PANEL
  ======================================================= */

  .location-panel {
    position: absolute;

    left: 24px;
    top: 50%;

    width: 310px;
    max-height: calc(100vh - 150px);

    transform: translateY(-50%);

    z-index: 14;

    display: flex;
    flex-direction: column;

    overflow: hidden;

    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;

    background: rgba(3, 10, 13, 0.76);

    backdrop-filter: blur(20px);

    box-shadow:
      0 25px 80px rgba(0, 0, 0, 0.5),
      inset 0 1px rgba(255, 255, 255, 0.04);
  }

  .panel-head {
    padding: 18px 18px 14px;

    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .panel-title {
    font-size: 13px;
    font-weight: 800;

    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .panel-count {
    margin-top: 5px;

    color: rgba(255, 255, 255, 0.42);

    font-size: 10px;
  }

  .location-list {
    padding: 8px;

    overflow-y: auto;
  }

  .location-list::-webkit-scrollbar {
    width: 4px;
  }

  .location-list::-webkit-scrollbar-thumb {
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.15);
  }

  .location-item {
    width: 100%;
    margin-bottom: 4px;

    border: 1px solid transparent;
    border-radius: 12px;

    background: transparent;
    color: #ffffff;

    overflow: hidden;

    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .location-item:hover {
    background: rgba(255, 255, 255, 0.045);
  }

  .location-item.active {
    border-color: rgba(0, 255, 136, 0.22);
    background: rgba(0, 255, 136, 0.055);
  }

  /* Main location row */
  .location-main {
    width: 100%;
    min-height: 52px;

    display: flex;
    align-items: center;
    gap: 11px;

    padding: 9px 8px;

    border: 0;
    background: transparent;
    color: #ffffff;

    text-align: left;
    cursor: pointer;
  }

  .location-main:focus-visible {
    outline: 1px solid rgba(0, 255, 136, 0.5);
    outline-offset: -2px;
  }

  .location-icon {
    flex: 0 0 auto;

    width: 30px;
    height: 30px;

    display: grid;
    place-items: center;

    border-radius: 9px;

    background: rgba(0, 255, 136, 0.08);
    border: 1px solid rgba(0, 255, 136, 0.16);
  }

  .location-icon-dot {
    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: #00ff88;

    box-shadow:
      0 0 6px #00ff88,
      0 0 12px rgba(0, 255, 136, 0.8);
  }

  .location-info {
    min-width: 0;
    flex: 1;
  }

  .location-name {
    overflow: hidden;

    text-overflow: ellipsis;
    white-space: nowrap;

    font-size: 12px;
    font-weight: 750;
  }

  .location-country {
    margin-top: 3px;

    color: rgba(255, 255, 255, 0.4);

    font-size: 9px;
  }

  /* Right-side arrow */
  .location-arrow {
    flex: 0 0 auto;

    width: 30px;
    height: 30px;

    display: grid;
    place-items: center;

    padding: 0;

    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;

    background: rgba(255, 255, 255, 0.025);
    color: rgba(255, 255, 255, 0.52);

    cursor: pointer;

    font-size: 18px;
    line-height: 1;

    transition:
      transform 0.2s ease,
      color 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .location-arrow:hover {
    color: #00ff88;

    background: rgba(0, 255, 136, 0.08);

    border-color: rgba(0, 255, 136, 0.2);
  }

  .location-item.expanded .location-arrow {
    color: #00ff88;

    background: rgba(0, 255, 136, 0.08);

    border-color: rgba(0, 255, 136, 0.2);

    transform: rotate(90deg);
  }

  /* Dropdown details */
  .location-extra {
    display: none;

    margin: 0 8px 10px 49px;

    padding: 10px;

    border-radius: 10px;

    background: rgba(0, 0, 0, 0.22);

    border: 1px solid rgba(255, 255, 255, 0.055);
  }

  .location-item.expanded .location-extra {
    display: block;
    animation: locationDrop 0.18s ease;
  }

  @keyframes locationDrop {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .location-extra-row {
    min-height: 24px;

    display: flex;
    align-items: center;

    gap: 7px;
  }

  .location-extra-icon {
    flex: 0 0 18px;

    width: 18px;

    color: #00ff88;

    font-size: 10px;
    text-align: center;
  }

  .location-extra-label {
    flex: 0 0 48px;

    width: 48px;

    color: rgba(255, 255, 255, 0.35);

    font-size: 9px;
  }

  .location-extra-value {
    min-width: 0;
    flex: 1;

    overflow: hidden;

    text-overflow: ellipsis;
    white-space: nowrap;

    color: rgba(255, 255, 255, 0.82);

    font-size: 9px;
    font-weight: 600;
  }

  /* =======================================================
     PEOPLE LIST INSIDE LOCATION DROPDOWN
     MODERN NAME CARD UI
  ======================================================= */

  .location-extra-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 8px;
    padding: 3px 3px 9px;
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }

  .location-extra-heading span:first-child {
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .1px;
  }

  .location-extra-heading span:last-child {
    padding: 4px 7px;
    border-radius: 20px;
    border: 1px solid rgba(0,255,136,.14);
    background: rgba(0,255,136,.06);
    color: #00ff88;
    font-size: 8px;
    font-weight: 700;
  }

  .location-people-list {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .location-person-card {
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.065);
    border-radius: 11px;
    background: linear-gradient(
      135deg,
      rgba(255,255,255,.035),
      rgba(255,255,255,.012)
    );
    transition:
      border-color .18s ease,
      background .18s ease,
      transform .18s ease;
  }

  .location-person-card:hover {
    border-color: rgba(0,255,136,.18);
    background: rgba(0,255,136,.035);
    transform: translateX(1px);
  }

  .location-person-card.person-expanded {
    border-color: rgba(0,255,136,.24);
    background: rgba(0,255,136,.045);
  }

  .location-person-header {
    width: 100%;
    min-height: 51px;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 7px 8px;
    border: 0;
    background: transparent;
    color: #fff;
    text-align: left;
    cursor: pointer;
  }

  .location-person-number {
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    background: rgba(0,255,136,.075);
    border: 1px solid rgba(0,255,136,.16);
    color: #00ff88;
    font-size: 10px;
    font-weight: 850;
    box-shadow: inset 0 0 12px rgba(0,255,136,.035);
  }

  .location-person-header > div:nth-child(2) {
    min-width: 0;
    flex: 1;
  }

  .location-person-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    line-height: 1.25;
  }

  .location-person-role-preview {
    margin-top: 3px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: rgba(255,255,255,.42);
    font-size: 8px;
    line-height: 1.2;
  }

  .location-person-arrow {
    width: 27px;
    height: 27px;
    flex: 0 0 27px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 8px;
    background: rgba(255,255,255,.025);
    color: rgba(255,255,255,.48);
    font-size: 16px;
    line-height: 1;
    transition:
      transform .2s ease,
      color .2s ease,
      background .2s ease,
      border-color .2s ease;
  }

  .location-person-header:hover .location-person-arrow {
    color: #00ff88;
    border-color: rgba(0,255,136,.2);
    background: rgba(0,255,136,.07);
  }

  .location-person-card.person-expanded .location-person-arrow {
    transform: rotate(90deg);
    color: #00ff88;
    border-color: rgba(0,255,136,.22);
    background: rgba(0,255,136,.08);
  }

  .location-person-details {
    display: none;
    margin: 0 8px 8px 47px;
    padding: 9px;
    border-radius: 9px;
    border: 1px solid rgba(0,255,136,.09);
    background: rgba(0,0,0,.22);
  }

  .location-person-card.person-expanded .location-person-details {
    display: block;
    animation: personDrop .18s ease;
  }

  @keyframes personDrop {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .person-detail-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    min-height: 24px;
    padding: 3px 0;
  }

  .person-detail-row + .person-detail-row {
    border-top: 1px solid rgba(255,255,255,.035);
  }

  .person-detail-label {
    flex: 0 0 58px;
    color: rgba(255,255,255,.32);
    font-size: 7px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .45px;
  }

  .person-detail-value {
    min-width: 0;
    flex: 1;
    color: rgba(255,255,255,.82);
    font-size: 8px;
    font-weight: 600;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  /* =======================================================
     DETAILS PANEL
  ======================================================= */

  .details-panel {
    position: absolute;

    right: 24px;
    bottom: 24px;

    width: 350px;

    z-index: 14;

    padding: 18px;

    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;

    background: rgba(3, 10, 13, 0.8);

    backdrop-filter: blur(20px);

    box-shadow:
      0 25px 80px rgba(0, 0, 0, 0.5),
      inset 0 1px rgba(255, 255, 255, 0.04);
  }

  .details-top {
    display: flex;

    align-items: center;

    gap: 12px;

    padding-bottom: 14px;

    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .details-avatar {
    width: 44px;
    height: 44px;

    display: grid;
    place-items: center;

    flex: 0 0 auto;

    border-radius: 13px;

    color: #00ff88;

    background:
      radial-gradient(
        circle,
        rgba(0, 255, 136, 0.18),
        rgba(0, 255, 136, 0.04)
      );

    border: 1px solid rgba(0, 255, 136, 0.2);

    font-size: 18px;
    font-weight: 800;
  }

  .details-name {
    font-size: 15px;
    font-weight: 800;
  }

  .details-role {
    margin-top: 3px;

    color: rgba(255, 255, 255, 0.48);

    font-size: 10px;
  }

  .details-grid {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 9px;

    margin-top: 15px;
  }

  .detail-item {
    min-width: 0;

    padding: 9px;

    border-radius: 9px;

    background: rgba(255, 255, 255, 0.035);

    border: 1px solid rgba(255, 255, 255, 0.055);
  }

  .detail-label {
    color: rgba(255, 255, 255, 0.35);

    font-size: 8px;

    text-transform: uppercase;
    letter-spacing: 0.7px;
  }

  .detail-value {
    margin-top: 4px;

    overflow: hidden;

    text-overflow: ellipsis;
    white-space: nowrap;

    color: rgba(255, 255, 255, 0.85);

    font-size: 10px;
    font-weight: 600;
  }

  .details-address {
    margin-top: 9px;

    padding: 10px;

    border-radius: 9px;

    background: rgba(255, 255, 255, 0.035);

    border: 1px solid rgba(255, 255, 255, 0.055);
  }

  .details-panel.hidden {
    display: none;
  }

  /* =======================================================
     CONTROLS
  ======================================================= */

  .control-bar {
    position: absolute;

    right: 24px;
    top: 82px;

    z-index: 15;

    display: flex;

    gap: 7px;
  }

  .control-button {

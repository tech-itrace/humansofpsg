---
/* =========================================================
   PSG WORLD
   Radio Garden Style Interactive Globe
========================================================= */
---

<style is:global>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #020609;
    color: #ffffff;
  }

  body {
    min-height: 100vh;
  }

  button,
  input {
    font: inherit;
  }

  /* ================= MAIN ================= */

  .psg-world {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 45%, rgba(0, 255, 150, 0.05), transparent 38%),
      #020609;
  }

  .globe-panel {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  #globe-container {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  #globe-container canvas {
    display: block;
  }

  .globe-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background: radial-gradient(
      circle at center,
      transparent 48%,
      rgba(0, 0, 0, 0.08) 65%,
      rgba(0, 0, 0, 0.55) 100%
    );
  }

  /* ================= TOP BAR ================= */

  .top-bar {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 15;
    pointer-events: none;
  }

  .brand {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    background: rgba(2, 8, 11, 0.72);
    backdrop-filter: blur(16px);
    box-shadow:
      0 10px 40px rgba(0, 0, 0, 0.3),
      inset 0 1px rgba(255, 255, 255, 0.04);
  }

  .brand-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #00ff88;
    box-shadow: 0 0 8px #00ff88, 0 0 20px rgba(0, 255, 136, 0.75);
    animation: brandPulse 2s infinite;
  }

  .brand-title {
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 1.2px;
  }

  .brand-subtitle {
    margin-top: 2px;
    color: rgba(255, 255, 255, 0.48);
    font-size: 10px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }

  @keyframes brandPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.55; transform: scale(0.8); }
  }

  /* ================= SEARCH ================= */

  .search-box {
    pointer-events: auto;
    width: 300px;
    position: relative;
  }

  .search-input {
    width: 100%;
    height: 44px;
    padding: 0 16px 0 42px;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 13px;
    outline: none;
    color: #ffffff;
    background: rgba(2, 8, 11, 0.78);
    backdrop-filter: blur(16px);
    box-shadow:
      0 10px 40px rgba(0, 0, 0, 0.3),
      inset 0 1px rgba(255, 255, 255, 0.04);
    transition: 0.2s ease;
  }

  .search-input:focus {
    border-color: rgba(0, 255, 136, 0.5);
    box-shadow:
      0 0 0 3px rgba(0, 255, 136, 0.06),
      0 10px 40px rgba(0, 0, 0, 0.3);
  }

  .search-input::placeholder {
    color: rgba(255, 255, 255, 0.38);
  }

  .search-icon {
    position: absolute;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255, 255, 255, 0.5);
    font-size: 15px;
    pointer-events: none;
  }

  /* ================= CENTER MARKER ================= */

  .center-marker {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 110px;
    height: 110px;
    transform: translate(-50%, -50%);
    z-index: 12;
    pointer-events: auto;
    cursor: pointer;
    display: none;
  }

  .center-marker.visible {
    display: block;
  }

  .center-marker-dot {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 12px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: #ffffff;
    box-shadow:
      0 0 6px #ffffff,
      0 0 14px #00ff88,
      0 0 32px #00ff88,
      0 0 55px rgba(0, 255, 136, 0.8);
    z-index: 5;
  }

  .center-marker-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 30px;
    height: 30px;
    transform: translate(-50%, -50%);
    border: 2px solid #00ff88;
    border-radius: 50%;
    box-shadow: 0 0 10px #00ff88, 0 0 28px rgba(0, 255, 136, 0.8);
    animation: centerRing 1.7s ease-out infinite;
  }

  .center-marker-ring-2 {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 60px;
    height: 60px;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(0, 255, 136, 0.35);
    border-radius: 50%;
    animation: centerRing2 2.2s ease-out infinite;
  }

  .center-cross-horizontal,
  .center-cross-vertical {
    position: absolute;
    background: rgba(0, 255, 136, 0.65);
    box-shadow: 0 0 7px rgba(0, 255, 136, 0.5);
  }

  .center-cross-horizontal {
    left: 10px;
    right: 10px;
    top: 54px;
    height: 1px;
  }

  .center-cross-vertical {
    top: 10px;
    bottom: 10px;
    left: 54px;
    width: 1px;
  }

  .center-label {
    position: absolute;
    left: 50%;
    top: 83px;
    transform: translateX(-50%);
    padding: 6px 11px;
    white-space: nowrap;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    border: 1px solid rgba(0, 255, 136, 0.35);
    border-radius: 20px;
    background: rgba(0, 0, 0, 0.78);
    backdrop-filter: blur(10px);
    box-shadow:
      0 5px 20px rgba(0, 0, 0, 0.5),
      0 0 15px rgba(0, 255, 136, 0.08);
  }

  @keyframes centerRing {
    0% { width: 22px; height: 22px; opacity: 1; }
    70% { width: 72px; height: 72px; opacity: 0.12; }
    100% { width: 78px; height: 78px; opacity: 0; }
  }

  @keyframes centerRing2 {
    0% { width: 45px; height: 45px; opacity: 0.5; }
    100% { width: 90px; height: 90px; opacity: 0; }
  }

  /* ================= MAP MARKERS ================= */

  .station-marker {
    position: relative;
    width: 30px;
    height: 30px;
    transform: translate(-50%, -50%);
    cursor: pointer;
    pointer-events: auto;
  }

  .station-marker-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18px;
    height: 18px;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(0, 255, 136, 0.8);
    border-radius: 50%;
    animation: markerPulse 2s infinite;
  }

  .station-marker-core {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 7px;
    height: 7px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: #00ff88;
    box-shadow:
      0 0 5px #ffffff,
      0 0 12px #00ff88,
      0 0 25px rgba(0, 255, 136, 0.9);
  }

  .station-marker.selected .station-marker-core {
    width: 11px;
    height: 11px;
    background: #ffffff;
    box-shadow: 0 0 8px #ffffff, 0 0 18px #00ff88, 0 0 38px #00ff88;
  }

  .station-marker.selected .station-marker-ring {
    width: 30px;
    height: 30px;
    border-color: #00ff88;
    box-shadow:
      0 0 12px rgba(0, 255, 136, 0.8),
      inset 0 0 10px rgba(0, 255, 136, 0.2);
  }

  .station-tooltip {
    position: absolute;
    left: 50%;
    top: 23px;
    transform: translateX(-50%);
    white-space: nowrap;
    padding: 4px 8px;
    border-radius: 5px;
    color: rgba(255, 255, 255, 0.88);
    font-size: 9px;
    font-weight: 600;
    background: rgba(0, 0, 0, 0.68);
    opacity: 0;
    pointer-events: none;
    transition: 0.18s ease;
  }

  .station-marker:hover .station-tooltip {
    opacity: 1;
  }

  @keyframes markerPulse {
    0% { transform: translate(-50%, -50%) scale(0.65); opacity: 0.9; }
    70% { transform: translate(-50%, -50%) scale(1.35); opacity: 0; }
    100% { opacity: 0; }
  }

  /* ================= LEFT LOCATION PANEL (CITY NAMES ONLY) ================= */

  .location-panel {
    position: absolute;
    left: 24px;
    top: 92px;
    width: 310px;
    max-height: calc(100vh - 116px);
    transform: none;
    z-index: 14;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    background: rgba(3, 10, 13, 0.76);
    backdrop-filter: blur(20px);
    box-shadow:
      0 25px 80px rgba(0, 0, 0, 0.5),
      inset 0 1px rgba(255, 255, 255, 0.04);
  }

  .panel-head {
    padding: 18px 18px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .panel-title {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .panel-count {
    margin-top: 5px;
    color: rgba(255, 255, 255, 0.42);
    font-size: 10px;
  }

  .location-list {
    padding: 8px;
    overflow-y: auto;
  }

  .location-list::-webkit-scrollbar {
    width: 4px;
  }

  .location-list::-webkit-scrollbar-thumb {
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.15);
  }

  .location-item {
    width: 100%;
    margin-bottom: 4px;
    border: 1px solid transparent;
    border-radius: 12px;
    background: transparent;
    color: #ffffff;
    overflow: hidden;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .location-item:hover {
    background: rgba(255, 255, 255, 0.045);
  }

  .location-item.active {
    border-color: rgba(0, 255, 136, 0.22);
    background: rgba(0, 255, 136, 0.055);
  }

  .location-main {
    width: 100%;
    min-height: 52px;
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 9px 8px;
    border: 0;
    background: transparent;
    color: #ffffff;
    text-align: left;
    cursor: pointer;
  }

  .location-main:focus-visible {
    outline: 1px solid rgba(0, 255, 136, 0.5);
    outline-offset: -2px;
  }

  .location-icon {
    flex: 0 0 auto;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    background: rgba(0, 255, 136, 0.08);
    border: 1px solid rgba(0, 255, 136, 0.16);
  }

  .location-icon-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #00ff88;
    box-shadow: 0 0 6px #00ff88, 0 0 12px rgba(0, 255, 136, 0.8);
  }

  .location-info {
    min-width: 0;
    flex: 1;
  }

  .location-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 12px;
    font-weight: 750;
  }

  .location-country {
    margin-top: 3px;
    color: rgba(255, 255, 255, 0.4);
    font-size: 9px;
  }

  /* ================= PEOPLE BOX (RIGHT PANEL ONLY) ================= */

  .location-extra {
    margin: 0;
    padding: 10px;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.055);
  }

  .location-extra-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 8px;
    padding: 3px 3px 9px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .location-extra-heading span:first-child {
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1px;
  }

  .location-extra-heading span:last-child {
    padding: 4px 7px;
    border-radius: 20px;
    border: 1px solid rgba(0, 255, 136, 0.14);
    background: rgba(0, 255, 136, 0.06);
    color: #00ff88;
    font-size: 8px;
    font-weight: 700;
  }

  .location-people-list {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .location-person-card {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.065);
    border-radius: 11px;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.035),
      rgba(255, 255, 255, 0.012)
    );
    transition: border-color 0.18s ease, background 0.18s ease, transform 0.18s ease;
  }

  .location-person-card:hover {
    border-color: rgba(0, 255, 136, 0.18);
    background: rgba(0, 255, 136, 0.035);
    transform: translateX(1px);
  }

  .location-person-card.person-expanded {
    border-color: rgba(0, 255, 136, 0.24);
    background: rgba(0, 255, 136, 0.045);
  }

  .location-person-header {
    width: 100%;
    min-height: 51px;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 7px 8px;
    border: 0;
    background: transparent;
    color: #fff;
    text-align: left;
    cursor: pointer;
  }

  .location-person-number {
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    background: rgba(0, 255, 136, 0.075);
    border: 1px solid rgba(0, 255, 136, 0.16);
    color: #00ff88;
    font-size: 10px;
    font-weight: 850;
    box-shadow: inset 0 0 12px rgba(0, 255, 136, 0.035);
  }

  .location-person-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    line-height: 1.25;
  }

  .location-person-role-preview {
    margin-top: 3px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.42);
    font-size: 8px;
    line-height: 1.2;
  }

  .location-person-arrow {
    width: 27px;
    height: 27px;
    flex: 0 0 27px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.025);
    color: rgba(255, 255, 255, 0.48);
    font-size: 16px;
    line-height: 1;
    transition:
      transform 0.2s ease,
      color 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .location-person-header:hover .location-person-arrow {
    color: #00ff88;
    border-color: rgba(0, 255, 136, 0.2);
    background: rgba(0, 255, 136, 0.07);
  }

  .location-person-card.person-expanded .location-person-arrow {
    transform: rotate(90deg);
    color: #00ff88;
    border-color: rgba(0, 255, 136, 0.22);
    background: rgba(0, 255, 136, 0.08);
  }

  .location-person-details {
    display: none;
    margin: 0 8px 8px 47px;
    padding: 9px;
    border-radius: 9px;
    border: 1px solid rgba(0, 255, 136, 0.09);
    background: rgba(0, 0, 0, 0.22);
  }

  .location-person-card.person-expanded .location-person-details {
    display: block;
    animation: personDrop 0.18s ease;
  }

  @keyframes personDrop {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .person-detail-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    min-height: 24px;
    padding: 3px 0;
  }

  .person-detail-row + .person-detail-row {
    border-top: 1px solid rgba(255, 255, 255, 0.035);
  }

  .person-detail-label {
    flex: 0 0 66px;
    color: rgba(255, 255, 255, 0.32);
    font-size: 7px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.45px;
  }

  .person-detail-value {
    min-width: 0;
    flex: 1;
    color: rgba(255, 255, 255, 0.82);
    font-size: 8px;
    font-weight: 600;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  /* ================= RIGHT DETAILS PANEL ================= */

  .details-panel {
    position: absolute;
    right: 24px;
    bottom: 24px;
    width: 350px;
    max-height: min(440px, calc(100vh - 150px));
    overflow: hidden;
    z-index: 14;
    padding: 18px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    background: rgba(3, 10, 13, 0.8);
    backdrop-filter: blur(20px);
    box-shadow:
      0 25px 80px rgba(0, 0, 0, 0.5),
      inset 0 1px rgba(255, 255, 255, 0.04);
  }

  .details-panel.hidden {
    display: none;
  }

  .details-content {
    max-height: min(400px, calc(100vh - 190px));
    overflow-y: auto;
    padding-right: 3px;
  }

  .details-content::-webkit-scrollbar {
    width: 4px;
  }

  .details-content::-webkit-scrollbar-thumb {
    background: rgba(0, 255, 136, 0.22);
    border-radius: 10px;
  }

  .details-top {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 14px;
    margin-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .details-avatar {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 13px;
    color: #00ff88;
    background: radial-gradient(
      circle,
      rgba(0, 255, 136, 0.18),
      rgba(0, 255, 136, 0.04)
    );
    border: 1px solid rgba(0, 255, 136, 0.2);
    font-size: 18px;
    font-weight: 800;
  }

  .details-name {
    font-size: 15px;
    font-weight: 800;
  }

  .details-role {
    margin-top: 3px;
    color: rgba(255, 255, 255, 0.48);
    font-size: 10px;
  }

  .details-location-count {
    margin-top: 3px;
    color: rgba(255, 255, 255, 0.42);
    font-size: 9px;
  }

  /* ================= CONTROLS ================= */

  .control-bar {
    position: absolute;
    right: 24px;
    top: 82px;
    z-index: 15;
    display: flex;
    gap: 7px;
  }

  .control-button {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    color: rgba(255, 255, 255, 0.75);
    background: rgba(3, 10, 13, 0.75);
    backdrop-filter: blur(12px);
    cursor: pointer;
    transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
  }

  .control-button:hover {
    color: #ffffff;
    background: rgba(0, 255, 136, 0.1);
    border-color: rgba(0, 255, 136, 0.25);
    transform: translateY(-1px);
  }

  /* ================= LOADING ================= */

  .map-loading {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 30;
    padding: 12px 18px;
    border-radius: 12px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 11px;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .map-loading.hidden {
    display: none;
  }

  /* ================= MOBILE ================= */

  @media (max-width: 900px) {
    .top-bar { left: 12px; right: 12px; top: 12px; }
    .brand-subtitle { display: none; }
    .search-box { width: 210px; }

    .location-panel {
      left: 12px;
      top: auto;
      bottom: 12px;
      width: 250px;
      max-height: 42vh;
      transform: none;
    }

    .details-panel { right: 12px; bottom: 12px; width: 290px; }
    .control-bar { right: 12px; top: 68px; }
  }

  @media (max-width: 650px) {
    .brand { padding: 9px 11px; }
    .brand-title { font-size: 11px; }
    .search-box { width: 170px; }
    .location-panel { display: none; }

    .details-panel {
      left: 12px;
      right: 12px;
      bottom: 12px;
      width: auto;
    }

    .control-bar { top: 66px; }
    .center-label { font-size: 9px; }
  }
</style>

<div class="psg-world">

  <!-- GLOBE -->
  <div class="globe-panel">

    <div id="globe-container"></div>

    <div class="globe-vignette"></div>

    <div id="center-marker" class="center-marker">
      <div class="center-marker-ring"></div>
      <div class="center-marker-ring-2"></div>
      <div class="center-cross-horizontal"></div>
      <div class="center-cross-vertical"></div>
      <div class="center-marker-dot"></div>
      <div id="center-label" class="center-label">Location</div>
    </div>

  </div>

  <!-- HEADER -->
  <div class="top-bar">

    <div class="brand">
      <div class="brand-dot"></div>
      <div>
        <div class="brand-title">HUMANS OF PSG</div>

      </div>
    </div>

    <div class="search-box">
      <span class="search-icon">⌕</span>
      <input
        id="location-search"
        class="search-input"
        type="text"
        placeholder="Search location..."
        autocomplete="off"
      />
    </div>

  </div>

  <!-- MAP CONTROLS -->
  <div class="control-bar">
    <button id="zoom-in" class="control-button" title="Zoom in" type="button">+</button>
    <button id="zoom-out" class="control-button" title="Zoom out" type="button">−</button>
    <button id="random-location" class="control-button" title="Random location" type="button">⤨</button>
    <button id="reset-globe" class="control-button" title="Reset globe" type="button">◉</button>
  </div>

  <!-- LOCATION LIST (LEFT) : city names only -->
  <aside class="location-panel">

    <div class="panel-head">
      <div class="panel-title">PSG Alumni Members</div>
      <div id="panel-count" class="panel-count">0 locations</div>
    </div>

    <div id="location-list" class="location-list"></div>

  </aside>

  <!-- DETAILS (RIGHT) : people list -->
  <section id="details-panel" class="details-panel hidden">
    <div id="details-content" class="details-content"></div>
  </section>

  <!-- LOADING -->
  <div id="map-loading" class="map-loading">Loading map...</div>

</div>


<script is:inline type="module">

  /* =======================================================
     IMPORTS
  ======================================================= */

  import Globe from "https://esm.sh/globe.gl@2.45.0";
  import * as topojson from "https://esm.sh/topojson-client@3";

  /* Data lives in a separate file: public/data/psg-members.js */
  import { members, DEFAULT_CITY, CITY_COORDS } from "/data/psg-members.js";


  /* =======================================================
     SETTINGS
     false = opening one person closes the others
     true  = many people can stay open together
  ======================================================= */

  const ALLOW_MULTIPLE_OPEN = false;


  /* =======================================================
     DATA  (members, cities -> public/data/psg-members.js)
  ======================================================= */

  /* Group members by city -> one globe location per city */
  function buildLocations(list) {

    const groups = new Map();

    list.forEach(member => {

      const city = member.city || DEFAULT_CITY;

      if (!CITY_COORDS[city]) {
        console.warn("City missing in CITY_COORDS:", city);
        return;
      }

      if (!groups.has(city)) groups.set(city, []);

      groups.get(city).push({
        name: member.name,
        role: member.jobTitle || member.organization || "Member",
        department: member.department,
        organization: member.organization,
        batch: member.batch,
        degree: member.degree,
        industry: member.industry,
        phone: member.phone,
        email: member.email,
        linkedin: member.linkedin
      });

    });

    return [...groups.entries()].map(([city, people], index) => ({
      id: index + 1,
      name: city,
      branch: "PSG",
      ...CITY_COORDS[city],
      people
    }));

  }

  const locations = buildLocations(members);


  /* =======================================================
     GLOBAL STATE
  ======================================================= */

  let globe = null;
  let selectedLocation = null;
  let autoRotateTimeout = null;
  let focusTimeout = null;
  let countryData = [];


  /* =======================================================
     DOM
  ======================================================= */

  const globeContainer = document.getElementById("globe-container");
  const locationList = document.getElementById("location-list");
  const searchInput = document.getElementById("location-search");
  const panelCount = document.getElementById("panel-count");
  const centerMarker = document.getElementById("center-marker");
  const centerLabel = document.getElementById("center-label");
  const loading = document.getElementById("map-loading");
  const detailsPanel = document.getElementById("details-panel");


  /* Clicking the center label/target re-opens the right panel */
  centerMarker?.addEventListener("click", event => {
    event.preventDefault();
    event.stopPropagation();

    if (!selectedLocation) return;

    showLocation(selectedLocation);
  });


  /* =======================================================
     ESCAPE HTML
  ======================================================= */

  function escapeHtml(value) {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }


  /* =======================================================
     PEOPLE ACCORDION (RIGHT PANEL ONLY)
  ======================================================= */

  function getPeople(location) {
    return Array.isArray(location.people) ? location.people : [];
  }


  /* Numbered name cards. openFirst = first person starts open. */
  function buildPeopleCards(location, openFirst = false) {

    return getPeople(location).map((person, index) => {

      const isOpen = openFirst && index === 0;

      return `

        <div class="location-person-card ${isOpen ? "person-expanded" : ""}">

          <button
            type="button"
            class="location-person-header"
            aria-expanded="${isOpen}"
          >

            <div class="location-person-number">${index + 1}</div>

            <div style="min-width:0;flex:1;">
              <div class="location-person-name">
                ${escapeHtml(person.name || "-")}
              </div>
              <div class="location-person-role-preview">
                ${escapeHtml(person.role || "-")}
              </div>
            </div>

            <span class="location-person-arrow">›</span>

          </button>

          <div class="location-person-details">

            <div class="person-detail-row">
              <span class="person-detail-label">Role</span>
              <span class="person-detail-value">${escapeHtml(person.role || "-")}</span>
            </div>

            <div class="person-detail-row">
              <span class="person-detail-label">Organization</span>
              <span class="person-detail-value">${escapeHtml(person.organization || "-")}</span>
            </div>

            <div class="person-detail-row">
              <span class="person-detail-label">Batch</span>
              <span class="person-detail-value">${escapeHtml(person.batch || "-")}</span>
            </div>

            <div class="person-detail-row">
              <span class="person-detail-label">Degree</span>
              <span class="person-detail-value">${escapeHtml(person.degree || "-")}</span>
            </div>

            <div class="person-detail-row">
              <span class="person-detail-label">Department</span>
              <span class="person-detail-value">${escapeHtml(person.department || "-")}</span>
            </div>

            <div class="person-detail-row">
              <span class="person-detail-label">Industry</span>
              <span class="person-detail-value">${escapeHtml(person.industry || "-")}</span>
            </div>

            <div class="person-detail-row">
              <span class="person-detail-label">Phone</span>
              <span class="person-detail-value">${escapeHtml(person.phone || "-")}</span>
            </div>

            <div class="person-detail-row">
              <span class="person-detail-label">Email</span>
              <span class="person-detail-value">${escapeHtml(person.email || "-")}</span>
            </div>

            <div class="person-detail-row">
              <span class="person-detail-label">LinkedIn</span>
              <span class="person-detail-value">${escapeHtml(person.linkedin || "-")}</span>
            </div>

          </div>

        </div>

      `;

    }).join("");

  }


  /* One click handler per container (event delegation).
     Safe to call many times - it binds only once. */
  function bindPersonAccordion(container) {

    if (!container || container.dataset.accordionBound) return;

    container.dataset.accordionBound = "true";

    container.addEventListener("click", event => {

      const header = event.target.closest(".location-person-header");

      if (!header || !container.contains(header)) return;

      event.preventDefault();
      event.stopPropagation();

      const card = header.closest(".location-person-card");

      if (!card) return;

      const willOpen = !card.classList.contains("person-expanded");

      /* Close the other people in the same city */
      if (!ALLOW_MULTIPLE_OPEN) {

        card.parentElement
          ?.querySelectorAll(".location-person-card.person-expanded")
          .forEach(other => {

            other.classList.remove("person-expanded");

            other
              .querySelector(".location-person-header")
              ?.setAttribute("aria-expanded", "false");

          });

      }

      card.classList.toggle("person-expanded", willOpen);

      header.setAttribute("aria-expanded", String(willOpen));

    });

  }


  /* =======================================================
     RIGHT PANEL
     City header + all people as dropdowns.
     All dropdowns start CLOSED; click a name to open it.
  ======================================================= */

  function showLocation(location) {

    if (!location) return;

    selectedLocation = location;

    if (detailsPanel) {
      detailsPanel.classList.remove("hidden");
    }

    const content = document.getElementById("details-content");

    if (!content) return;

    const count = getPeople(location).length;
    const label = count === 1 ? "person" : "people";

    content.innerHTML = `

      <!-- CITY HEADER -->
      <div class="details-top">

        <div class="details-avatar">
          ${escapeHtml(location.name?.charAt(0).toUpperCase() || "P")}
        </div>

        <div style="min-width:0;flex:1;">
          <div class="details-name">${escapeHtml(location.name)}</div>
          <div class="details-role">
            ${escapeHtml(location.branch || "PSG")} · ${count} ${label}
          </div>
          <div class="details-location-count">
            ${escapeHtml(location.country || "")} · ${escapeHtml(location.address || location.name || "")}
          </div>
        </div>

      </div>

      <!-- ALL PEOPLE IN THIS CITY (closed at first) -->
      <div class="location-extra">

        <div class="location-extra-heading">
          <span>People in ${escapeHtml(location.name)}</span>
          <span>${count} ${label}</span>
        </div>

        <div class="location-people-list">
          ${buildPeopleCards(location, false)}
        </div>

      </div>

    `;

    bindPersonAccordion(content);

    updateActiveLocation();
    updateSelectedMapMarker();

  }


  /* =======================================================
     CENTER MARKER
  ======================================================= */

  function showCenterMarker(location) {

    if (!centerMarker || !location) return;

    centerMarker.classList.add("visible");

    if (centerLabel) {
      centerLabel.textContent = location.name;
    }

  }


  function hideCenterMarker() {

    if (!centerMarker) return;

    centerMarker.classList.remove("visible");

  }


  /* The target follows the REAL place on the globe, so when the
     globe is dragged or rotated the target moves with Chennai
     (and hides when Chennai turns to the back of the globe). */
  function trackCenterMarker() {

    requestAnimationFrame(trackCenterMarker);

    if (
      !globe ||
      !centerMarker ||
      !selectedLocation ||
      !centerMarker.classList.contains("visible")
    ) return;

    const lat = Number(selectedLocation.lat);
    const lng = Number(selectedLocation.lng);

    const point = globe.getCoords(lat, lng, 0.025);
    const cam = globe.camera().position;
    const radius = globe.getGlobeRadius();

    const facingCamera =
      point.x * cam.x + point.y * cam.y + point.z * cam.z > radius * radius;

    if (!facingCamera) {
      centerMarker.style.opacity = "0";
      centerMarker.style.pointerEvents = "none";
      return;
    }

    const screen = globe.getScreenCoords(lat, lng, 0.025);

    centerMarker.style.opacity = "1";
    centerMarker.style.pointerEvents = "auto";
    centerMarker.style.left = screen.x + "px";
    centerMarker.style.top = screen.y + "px";

  }


  /* =======================================================
     SELECTED MAP MARKER
  ======================================================= */

  function updateSelectedMapMarker() {

    document.querySelectorAll(".station-marker").forEach(marker => {

      const id = Number(marker.dataset.locationId);

      marker.classList.toggle(
        "selected",
        selectedLocation && id === Number(selectedLocation.id)
      );

    });

  }


  /* =======================================================
     ACTIVE LIST ITEM
  ======================================================= */

  function updateActiveLocation() {

    document.querySelectorAll(".location-item").forEach(item => {

      const id = Number(item.dataset.locationId);

      item.classList.toggle(
        "active",
        selectedLocation && id === Number(selectedLocation.id)
      );

    });

  }


  /* =======================================================
     SYNC LEFT LIST
     Map click -> scroll the left list to that city
     (no dropdown on the left any more)
  ======================================================= */

  function syncLocationDropdown(locationId) {

    if (!locationList) return;

    const item = locationList.querySelector(
      `.location-item[data-location-id="${Number(locationId)}"]`
    );

    if (!item) return;

    item.scrollIntoView({
      block: "nearest",
      behavior: "smooth"
    });

  }


  /* =======================================================
     RADIO GARDEN STYLE FOCUS
  ======================================================= */

  function focusLocation(location) {

    if (!globe || !location) return;

    selectedLocation = location;

    const lat = Number(location.lat);
    const lng = Number(location.lng);

    if (!Number.isFinite(lat) || !Number.isFinite(lng)) {
      return;
    }

    clearTimeout(autoRotateTimeout);
    clearTimeout(focusTimeout);

    const controls = globe.controls();

    if (controls) {
      controls.autoRotate = false;
      controls.enabled = false;
    }

    showCenterMarker(location);

    showLocation(location);

    syncLocationDropdown(location.id);

    globe.pointOfView(
      {
        lat: lat,
        lng: lng,
        altitude: 0.42
      },
      1700
    );

    focusTimeout = setTimeout(() => {

      if (!globe) return;

      const currentControls = globe.controls();

      if (currentControls) {
        currentControls.enabled = true;
        currentControls.autoRotate = false;
      }

    }, 1750);

  }


  /* =======================================================
     CREATE LOCATION MARKERS
  ======================================================= */

  function createLocationMarkers() {

    if (!globe) return;

    globe
      .htmlElementsData(locations)

      .htmlLat(location => Number(location.lat))

      .htmlLng(location => Number(location.lng))

      .htmlAltitude(0.025)

      .htmlElement(location => {

        const wrapper = document.createElement("div");

        wrapper.className = "station-marker";

        wrapper.dataset.locationId = String(location.id);

        wrapper.innerHTML = `

          <div class="station-marker-ring"></div>

          <div class="station-marker-core"></div>

          <div class="station-tooltip">
            ${escapeHtml(location.name)} · ${escapeHtml(location.country)}
          </div>

        `;

        wrapper.addEventListener("click", event => {

          event.preventDefault();
          event.stopPropagation();

          focusLocation(location);

        });

        return wrapper;

      });

    updateSelectedMapMarker();

  }


  /* =======================================================
     LEFT LOCATION LIST  (CITY NAMES ONLY)
     No arrow, no dropdown, no people on the left.
     Click a city -> fly to it + open the right panel.
  ======================================================= */

  /* Search matches city, country and every person in the city */
  function locationMatches(location, query) {

    if (
      String(location.name || "").toLowerCase().includes(query) ||
      String(location.country || "").toLowerCase().includes(query)
    ) return true;

    return getPeople(location).some(person =>
      [person.name, person.role, person.organization, person.department]
        .some(value => String(value || "").toLowerCase().includes(query))
    );

  }


  function renderLocationList(filterText = "") {

    if (!locationList) return;

    const query = String(filterText).trim().toLowerCase();

    const filtered = locations.filter(location => {

      if (!query) return true;

      return locationMatches(location, query);

    });

    if (panelCount) {
      panelCount.textContent =
        `${filtered.length} location${filtered.length === 1 ? "" : "s"}`;
    }

    locationList.innerHTML = filtered.map(location => {

      const isActive =
        selectedLocation &&
        Number(selectedLocation.id) === Number(location.id);

      return `

        <div
          class="location-item ${isActive ? "active" : ""}"
          data-location-id="${location.id}"
        >

          <div
            class="location-main"
            role="button"
            tabindex="0"
          >

            <div class="location-icon">
              <span class="location-icon-dot"></span>
            </div>

            <div class="location-info">
              <div class="location-name">${escapeHtml(location.name)}</div>
              <div class="location-country">${escapeHtml(location.country)}</div>
            </div>

          </div>

        </div>

      `;

    }).join("");


    /* Click a city -> fly to it + open right panel */
    locationList.querySelectorAll(".location-main").forEach(main => {

      const item = main.closest(".location-item");

      if (!item) return;

      const handleFocus = () => {

        const id = Number(item.dataset.locationId);

        const location = locations.find(
          itemLocation => Number(itemLocation.id) === id
        );

        if (location) focusLocation(location);

      };

      main.addEventListener("click", handleFocus);

      main.addEventListener("keydown", event => {

        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          handleFocus();
        }

      });

    });

  }


  /* =======================================================
     COUNTRY POLYGONS
  ======================================================= */

  async function loadCountries() {

    try {

      const response = await fetch(
        "https://unpkg.com/world-atlas@2/countries-110m.json"
      );

      if (!response.ok) {
        throw new Error("Country map request failed");
      }

      const world = await response.json();

      countryData = topojson.feature(
        world,
        world.objects.countries
      ).features;

      if (globe) {

        globe
          .polygonsData(countryData)
          .polygonCapColor(() => "rgba(20, 42, 46, 0.52)")
          .polygonSideColor(() => "rgba(0, 255, 136, 0.025)")
          .polygonStrokeColor(() => "rgba(0, 255, 136, 0.18)")
          .polygonAltitude(0.004);

      }

    } catch (error) {

      console.error("Country map error:", error);

    }

  }


  /* =======================================================
     CREATE GLOBE
  ======================================================= */

  function createGlobe() {

    if (!globeContainer) return;

    globe = new Globe(globeContainer, {
      animateIn: true
    });

    globe
      .globeImageUrl(
        "https://unpkg.com/three-globe/example/img/earth-blue-marble.jpg"
      )
      .bumpImageUrl(
        "https://unpkg.com/three-globe/example/img/earth-topology.png"
      )
      .backgroundColor("rgba(0,0,0,0)")
      .showAtmosphere(true)
      .atmosphereColor("#00ff88")
      .atmosphereAltitude(0.12);

    createLocationMarkers();

    const controls = globe.controls();

    if (controls) {
      controls.enablePan = false;
      controls.enableZoom = true;
      controls.enableDamping = true;
      controls.dampingFactor = 0.08;
      controls.minDistance = 105;
      controls.maxDistance = 430;
      controls.autoRotate = true;
      controls.autoRotateSpeed = 0.18;
    }

    globe.pointOfView(
      { lat: 18, lng: 80, altitude: 2.05 },
      0
    );


    /* Click near a city on the map -> select that city */

    globe.onGlobeClick(({ lat, lng }) => {

      let nearest = null;
      let nearestDistance = Infinity;

      locations.forEach(location => {

        const dLat = Number(location.lat) - Number(lat);
        const dLng = Number(location.lng) - Number(lng);

        const distance = Math.sqrt(dLat * dLat + dLng * dLng);

        if (distance < nearestDistance) {
          nearestDistance = distance;
          nearest = location;
        }

      });

      /* Click anywhere on the map -> select the nearest city
         (only Chennai now, so any click shows Chennai) */
      if (nearest) {
        focusLocation(nearest);
      }

    });

    globe.onZoom(() => {});


    /* Resize */

    function resizeGlobe() {

      if (!globe || !globeContainer) return;

      const width = globeContainer.clientWidth;
      const height = globeContainer.clientHeight;

      if (width > 0) globe.width(width);
      if (height > 0) globe.height(height);

    }

    window.addEventListener("resize", resizeGlobe);

    resizeGlobe();


    requestAnimationFrame(trackCenterMarker);


    /* Hide loading */

    setTimeout(() => {
      loading?.classList.add("hidden");
    }, 900);

  }


  /* =======================================================
     SEARCH
  ======================================================= */

  if (searchInput) {

    searchInput.addEventListener("input", () => {
      renderLocationList(searchInput.value);
    });

    searchInput.addEventListener("keydown", event => {

      if (event.key !== "Enter") return;

      const query = searchInput.value.trim().toLowerCase();

      if (!query) return;

      const location = locations.find(item => locationMatches(item, query));

      if (location) {
        focusLocation(location);
      }

    });

  }


  /* =======================================================
     ZOOM IN / OUT
  ======================================================= */

  document.getElementById("zoom-in")?.addEventListener("click", () => {

    if (!globe) return;

    const controls = globe.controls();

    if (controls && typeof controls.dollyIn === "function") {
      controls.dollyIn(1.25);
    }

  });

  document.getElementById("zoom-out")?.addEventListener("click", () => {

    if (!globe) return;

    const controls = globe.controls();

    if (controls && typeof controls.dollyOut === "function") {
      controls.dollyOut(1.25);
    }

  });


  /* =======================================================
     RANDOM LOCATION
  ======================================================= */

  document.getElementById("random-location")?.addEventListener("click", () => {

    if (!locations.length) return;

    let location;

    do {

      location = locations[Math.floor(Math.random() * locations.length)];

    } while (
      locations.length > 1 &&
      selectedLocation &&
      location.id === selectedLocation.id
    );

    focusLocation(location);

  });


  /* =======================================================
     RESET
  ======================================================= */

  document.getElementById("reset-globe")?.addEventListener("click", () => {

    if (!globe) return;

    clearTimeout(autoRotateTimeout);
    clearTimeout(focusTimeout);

    hideCenterMarker();

    selectedLocation = null;

    detailsPanel?.classList.add("hidden");

    updateActiveLocation();
    updateSelectedMapMarker();

    const controls = globe.controls();

    if (controls) {
      controls.enabled = false;
      controls.autoRotate = false;
    }

    globe.pointOfView(
      { lat: 18, lng: 80, altitude: 2.05 },
      1200
    );

    setTimeout(() => {

      if (!globe) return;

      const currentControls = globe.controls();

      if (currentControls) {
        currentControls.enabled = true;
        currentControls.autoRotate = true;
      }

    }, 1250);

  });


  /* =======================================================
     INITIALIZE
  ======================================================= */

  renderLocationList();

  createGlobe();

  loadCountries();


  /* =======================================================
     INITIAL STATE
     Nothing is selected on page load:
     no right panel, no active city, no center target.
  ======================================================= */

  selectedLocation = null;

  hideCenterMarker();

  detailsPanel?.classList.add("hidden");

  updateActiveLocation();
  updateSelectedMapMarker();

</script>

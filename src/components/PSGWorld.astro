---
/* PSG WORLD - globe page, styled like the Humans of PSG website
   (white background, peach divider, Fredoka headings, Jost body, blue accent) */
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Jost:wght@400;500;600&display=swap"
  rel="stylesheet"
/>

<style is:global>
  :root {
    --bg: #ffffff;
    --ink: #2a1b14;
    --muted: #7d6e66;
    --blue: #2a6fba;
    --blue-soft: #eaf2fb;
    --line: #f1dccd;
    --peach: #fff7f1;
    --shadow: 0 12px 40px rgba(60, 35, 20, 0.1);
    --head: "Fredoka", "Baloo 2", system-ui, sans-serif;
    --body: "Jost", "Segoe UI", system-ui, sans-serif;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0; padding: 0; width: 100%; height: 100%;
    overflow: hidden; background: var(--bg); color: var(--ink);
    font-family: var(--body);
  }

  button, input { font: inherit; }

  .psg-world { position: relative; width: 100vw; height: 100vh; overflow: hidden; background: var(--bg); }
  .globe-panel { position: absolute; inset: 0; overflow: hidden; }
  #globe-container { position: absolute; inset: 0; z-index: 1; }
  #globe-container canvas { display: block; }

  /* ---------- TOP BAR (like website nav) ---------- */
  .top-bar {
    position: absolute; left: 0; right: 0; top: 0; height: 76px;
    padding: 0 48px; display: flex; align-items: center; justify-content: space-between;
    z-index: 15; background: #fff; border-bottom: 1px solid var(--line);
  }
  .brand { display: flex; align-items: center; gap: 10px; }
  .brand-title { font-family: var(--head); font-size: 18px; font-weight: 700; color: var(--ink); }
  .brand-title b { color: var(--blue); font-style: italic; font-weight: 700; }

  .search-box { position: relative; width: 340px; }
  .search-input {
    width: 100%; height: 44px; padding: 0 18px 0 44px;
    border: 1px solid var(--line); border-radius: 999px; outline: none;
    background: #fff; color: var(--ink); font-size: 15px; transition: 0.2s ease;
  }
  .search-input:focus { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(42, 111, 186, 0.12); }
  .search-input::placeholder { color: #9a8b83; }
  .search-icon {
    position: absolute; left: 17px; top: 50%; transform: translateY(-50%);
    color: var(--muted); font-size: 17px; pointer-events: none;
  }

  /* ---------- CENTER TARGET ---------- */
  .center-marker {
    position: absolute; left: 50%; top: 50%; width: 110px; height: 110px;
    transform: translate(-50%, -50%); z-index: 12; cursor: pointer; display: none;
  }
  .center-marker.visible { display: block; }
  .center-marker-dot {
    position: absolute; left: 50%; top: 50%; width: 12px; height: 12px;
    transform: translate(-50%, -50%); border-radius: 50%;
    background: var(--blue); border: 2px solid #fff;
    box-shadow: 0 0 0 4px rgba(42, 111, 186, 0.25), 0 4px 14px rgba(42, 111, 186, 0.6);
    z-index: 5;
  }
  .center-marker-ring {
    position: absolute; left: 50%; top: 50%; width: 30px; height: 30px;
    transform: translate(-50%, -50%); border: 2px solid var(--blue); border-radius: 50%;
    animation: centerRing 1.7s ease-out infinite;
  }
  .center-marker-ring-2 {
    position: absolute; left: 50%; top: 50%; width: 60px; height: 60px;
    transform: translate(-50%, -50%); border: 1px solid rgba(42, 111, 186, 0.4); border-radius: 50%;
    animation: centerRing2 2.2s ease-out infinite;
  }
  .center-cross-horizontal, .center-cross-vertical { position: absolute; background: rgba(42, 111, 186, 0.55); }
  .center-cross-horizontal { left: 10px; right: 10px; top: 54px; height: 1px; }
  .center-cross-vertical { top: 10px; bottom: 10px; left: 54px; width: 1px; }
  .center-label {
    position: absolute; left: 50%; top: 86px; transform: translateX(-50%);
    padding: 6px 14px; white-space: nowrap; font-family: var(--head);
    font-size: 13px; font-weight: 600; color: var(--ink);
    background: #fff; border: 1px solid var(--line); border-radius: 999px; box-shadow: var(--shadow);
  }
  @keyframes centerRing {
    0% { width: 22px; height: 22px; opacity: 1; }
    70% { width: 72px; height: 72px; opacity: 0.12; }
    100% { width: 78px; height: 78px; opacity: 0; }
  }
  @keyframes centerRing2 {
    0% { width: 45px; height: 45px; opacity: 0.5; }
    100% { width: 90px; height: 90px; opacity: 0; }
  }

  /* ---------- MAP MARKERS ---------- */
  .station-marker { position: relative; width: 30px; height: 30px; transform: translate(-50%, -50%); cursor: pointer; pointer-events: auto; }
  .station-marker-ring {
    position: absolute; left: 50%; top: 50%; width: 18px; height: 18px;
    transform: translate(-50%, -50%); border: 1.5px solid var(--blue); border-radius: 50%;
    animation: markerPulse 2s infinite;
  }
  .station-marker-core {
    position: absolute; left: 50%; top: 50%; width: 9px; height: 9px;
    transform: translate(-50%, -50%); border-radius: 50%;
    background: var(--blue); border: 1.5px solid #fff; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.45);
  }
  .station-marker.selected .station-marker-core { width: 13px; height: 13px; background: #fff; border: 3px solid var(--blue); }
  .station-marker.selected .station-marker-ring { width: 30px; height: 30px; }
  .station-tooltip {
    position: absolute; left: 50%; top: 24px; transform: translateX(-50%);
    white-space: nowrap; padding: 4px 10px; border-radius: 999px;
    font-size: 12px; font-weight: 500; color: var(--ink);
    background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow);
    opacity: 0; pointer-events: none; transition: 0.18s ease;
  }
  .station-marker:hover .station-tooltip { opacity: 1; }
  @keyframes markerPulse {
    0% { transform: translate(-50%, -50%) scale(0.65); opacity: 0.9; }
    70% { transform: translate(-50%, -50%) scale(1.35); opacity: 0; }
    100% { opacity: 0; }
  }

  /* ---------- LEFT LOCATION PANEL ---------- */
  .location-panel {
    position: absolute; left: 32px; top: 100px; width: 300px;
    max-height: calc(100vh - 124px); z-index: 14; display: flex; flex-direction: column;
    overflow: hidden; background: #fff; border: 1px solid var(--line);
    border-radius: 22px; box-shadow: var(--shadow);
  }
  .panel-head { padding: 18px 20px 14px; border-bottom: 1px solid var(--line); }
  .panel-title { font-family: var(--head); font-size: 17px; font-weight: 700; }
  .panel-count { margin-top: 3px; color: var(--muted); font-size: 13px; }
  .location-list { padding: 8px; overflow-y: auto; }
  .location-list::-webkit-scrollbar, .details-content::-webkit-scrollbar { width: 5px; }
  .location-list::-webkit-scrollbar-thumb, .details-content::-webkit-scrollbar-thumb { border-radius: 20px; background: var(--line); }

  .location-item { margin-bottom: 3px; border: 1px solid transparent; border-radius: 14px; transition: 0.2s ease; }
  .location-item:hover { background: var(--peach); }
  .location-item.active { background: var(--blue-soft); border-color: rgba(42, 111, 186, 0.25); }
  .location-main { display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 8px 10px; cursor: pointer; }
  .location-main:focus-visible { outline: 2px solid var(--blue); outline-offset: -2px; border-radius: 14px; }
  .location-icon { flex: 0 0 auto; width: 32px; height: 32px; display: grid; place-items: center; border-radius: 50%; background: var(--blue-soft); }
  .location-icon-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--blue); }
  .location-info { min-width: 0; flex: 1; }
  .location-name { font-size: 15px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .location-country { margin-top: 1px; color: var(--muted); font-size: 12px; }

  /* ---------- RIGHT DETAILS PANEL ---------- */
  .details-panel {
    position: absolute; right: 32px; top: 100px; bottom: 24px; width: 400px;
    display: flex; flex-direction: column; overflow: hidden; z-index: 14; padding: 20px;
    background: #fff; border: 1px solid var(--line); border-radius: 22px; box-shadow: var(--shadow);
  }
  .details-panel.hidden { display: none; }
  .details-content { flex: 1; min-height: 0; overflow-y: auto; padding-right: 3px; }
  .details-top { display: flex; align-items: center; gap: 14px; padding-bottom: 16px; margin-bottom: 14px; border-bottom: 1px solid var(--line); }
  .details-avatar {
    width: 50px; height: 50px; flex: 0 0 auto; display: grid; place-items: center;
    border-radius: 50%; background: var(--blue); color: #fff;
    font-family: var(--head); font-size: 22px; font-weight: 700;
  }
  .details-name { font-family: var(--head); font-size: 22px; font-weight: 700; line-height: 1.1; }
  .details-role { margin-top: 4px; color: var(--blue); font-size: 14px; font-weight: 600; }
  .details-location-count { margin-top: 2px; color: var(--muted); font-size: 12px; }

  .location-extra-heading { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 10px; }
  .location-extra-heading span:first-child { font-family: var(--head); font-size: 15px; font-weight: 600; }
  .location-extra-heading span:last-child {
    padding: 3px 10px; border-radius: 999px; background: var(--blue-soft);
    color: var(--blue); font-size: 12px; font-weight: 600;
  }
  .location-people-list { display: flex; flex-direction: column; gap: 8px; }

  .location-person-card { overflow: hidden; border: 1px solid var(--line); border-radius: 16px; background: #fff; transition: 0.18s ease; }
  .location-person-card.person-expanded { border-color: rgba(42, 111, 186, 0.4); background: #fff; }
  .location-person-header {
    width: 100%; display: flex; align-items: center; gap: 10px;
    padding: 12px 14px 10px; border: 0; background: transparent; color: var(--ink); text-align: left; cursor: default;
  }
  .location-person-number {
    width: 34px; height: 34px; flex: 0 0 34px; display: grid; place-items: center;
    border-radius: 50%; background: var(--blue-soft); color: var(--blue);
    border: 1px solid rgba(42, 111, 186, 0.18);
  }
  .location-person-name { font-family: var(--head); font-size: 14px; font-weight: 600; line-height: 1.25; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .location-person-designation {
    margin-top: 1px; color: var(--blue); font-size: 12px; font-weight: 600; line-height: 1.3;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .location-person-org {
    margin-top: 1px; color: var(--muted); font-size: 11px; line-height: 1.3;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .location-person-arrow {
    width: 28px; height: 28px; flex: 0 0 28px; display: grid; place-items: center;
    border: 1px solid var(--line); border-radius: 50%; color: var(--muted);
    font-size: 17px; line-height: 1; transition: 0.2s ease;
  }
  .location-person-header:hover .location-person-arrow { color: var(--blue); border-color: var(--blue); }
  .location-person-card.person-expanded .location-person-arrow { transform: rotate(90deg); color: #fff; background: var(--blue); border-color: var(--blue); }

  .location-person-details { display: block; margin: 0 14px 14px; padding-top: 10px; border-top: 1px dashed var(--line); }
  .location-person-card.person-expanded .location-person-details { display: block; animation: personDrop 0.18s ease; }
  @keyframes personDrop { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }

  /* chips: batch / degree / department */
  .person-chips { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 10px; }
  .person-chip {
    display: inline-flex; align-items: center; gap: 5px; padding: 4px 9px;
    border-radius: 999px; background: var(--blue-soft); color: var(--blue);
    font-size: 11px; font-weight: 600; line-height: 1;
  }
  .person-chip small { color: var(--muted); font-size: 10px; font-weight: 500; }

  /* info rows with icons */
  .person-info { display: flex; flex-direction: column; gap: 8px; }
  .person-info-row { display: flex; align-items: center; gap: 10px; }
  .person-info-icon {
    width: 26px; height: 26px; flex: 0 0 26px; display: grid; place-items: center;
    border-radius: 9px; background: var(--peach); color: var(--blue); border: 1px solid var(--line);
  }
  .person-info-text { min-width: 0; flex: 1; }
  .person-info-label { color: var(--muted); font-size: 10px; font-weight: 500; line-height: 1.2; }
  .person-info-value { margin-top: 0; color: var(--ink); font-size: 12px; font-weight: 500; line-height: 1.35; overflow-wrap: anywhere; }
  .person-info-value a { color: var(--blue); text-decoration: none; font-weight: 600; }
  .person-info-value a:hover { text-decoration: underline; }

  /* contact buttons */
  .person-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--line); }
  .person-action {
    display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px;
    border-radius: 999px; border: 1px solid var(--line); background: #fff;
    color: var(--ink); font-size: 11.5px; font-weight: 600; text-decoration: none; transition: 0.18s ease;
  }
  .person-action:hover { border-color: var(--blue); color: var(--blue); }
  .person-action.primary { background: var(--blue); border-color: var(--blue); color: #fff; }
  .person-action.primary:hover { background: #225c9e; color: #fff; }

  /* ---------- CONTROLS ---------- */
  .control-bar { position: absolute; right: 32px; top: 92px; z-index: 16; display: none; }
  .zoom-bar { position: absolute; left: 50%; bottom: 24px; transform: translateX(-50%); z-index: 15; display: flex; gap: 8px; }
  .control-button {
    width: 42px; height: 42px; display: grid; place-items: center; cursor: pointer;
    border: 1px solid var(--line); border-radius: 50%; background: #fff;
    color: var(--ink); font-size: 18px; box-shadow: var(--shadow); transition: 0.18s ease;
  }
  .control-button:hover { color: var(--blue); border-color: var(--blue); transform: translateY(-1px); }

  /* ---------- LOADING ---------- */
  .map-loading {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 30;
    padding: 12px 20px; border-radius: 999px; color: var(--muted); font-size: 14px;
    background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow);
  }
  .map-loading.hidden { display: none; }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 900px) {
    .top-bar { padding: 0 16px; }
    .search-box { width: 220px; }
    .location-panel { left: 12px; top: auto; bottom: 12px; width: 250px; max-height: 42vh; }
    .details-panel { right: 12px; top: auto; bottom: 12px; width: 300px; max-height: 60vh; }
    .zoom-bar { bottom: auto; top: 92px; left: auto; right: 12px; transform: none; flex-direction: column; }
  }
  @media (max-width: 650px) {
    .brand-title { font-size: 15px; }
    .search-box { width: 170px; }
    .location-panel { display: none; }
    .details-panel { left: 12px; right: 12px; width: auto; }
  }
</style>

<div class="psg-world">

  <div class="globe-panel">
    <div id="globe-container"></div>

    <div id="center-marker" class="center-marker">
      <div class="center-marker-ring"></div>
      <div class="center-marker-ring-2"></div>
      <div class="center-cross-horizontal"></div>
      <div class="center-cross-vertical"></div>
      <div class="center-marker-dot"></div>
      <div id="center-label" class="center-label">Location</div>
    </div>
  </div>

  <div class="top-bar">
    <div class="brand">
      <div class="brand-title">Humans of <b>PSG</b></div>
    </div>

    <div class="search-box">
      <span class="search-icon">⌕</span>
      <input id="location-search" class="search-input" type="text" placeholder="Search city, name, company..." autocomplete="off" />
    </div>
  </div>

  <div class="zoom-bar">
    <button id="zoom-in" class="control-button" title="Zoom in" type="button">+</button>
    <button id="zoom-out" class="control-button" title="Zoom out" type="button">−</button>
    <button id="random-location" class="control-button" title="Random location" type="button">⤨</button>
    <button id="reset-globe" class="control-button" title="Reset globe" type="button">◉</button>
  </div>

  <aside class="location-panel">
    <div class="panel-head">
      <div class="panel-title">PSG Alumni Members</div>
      <div id="panel-count" class="panel-count">0 locations</div>
    </div>
    <div id="location-list" class="location-list"></div>
  </aside>

  <section id="details-panel" class="details-panel hidden">
    <div id="details-content" class="details-content"></div>
  </section>

  <div id="map-loading" class="map-loading">Loading map...</div>

</div>

<script is:inline type="module">

  import Globe from "https://esm.sh/globe.gl@2.45.0";
  import * as topojson from "https://esm.sh/topojson-client@3";

  /* Data lives in public/data/psg-members.js */
  import { members, DEFAULT_CITY, CITY_COORDS } from "/data/psg-members.js";

  /* false = opening one person closes the others */
  const ALLOW_MULTIPLE_OPEN = false;

  /* ================= DATA ================= */

  function buildLocations(list) {
    const groups = new Map();

    list.forEach(member => {
      const city = member.city || DEFAULT_CITY;

      if (!CITY_COORDS[city]) {
        console.warn("City missing in CITY_COORDS:", city);
        return;
      }

      if (!groups.has(city)) groups.set(city, []);

      groups.get(city).push({
        name: member.name,
        role: member.jobTitle || member.organization || "Member",
        department: member.department,
        organization: member.organization,
        batch: member.batch,
        degree: member.degree,
        industry: member.industry,
        phone: member.phone,
        email: member.email,
        linkedin: member.linkedin
      });
    });

    return [...groups.entries()].map(([city, people], index) => ({
      id: index + 1,
      name: city,
      branch: "PSG",
      ...CITY_COORDS[city],
      people
    }));
  }

  const locations = buildLocations(members);

  /* ================= STATE / DOM ================= */

  let globe = null;
  let selectedLocation = null;
  let focusTimeout = null;
  let countryData = [];

  const globeContainer = document.getElementById("globe-container");
  const locationList = document.getElementById("location-list");
  const searchInput = document.getElementById("location-search");
  const panelCount = document.getElementById("panel-count");
  const centerMarker = document.getElementById("center-marker");
  const centerLabel = document.getElementById("center-label");
  const loading = document.getElementById("map-loading");
  const detailsPanel = document.getElementById("details-panel");

  centerMarker?.addEventListener("click", event => {
    event.preventDefault();
    event.stopPropagation();
    if (selectedLocation) showLocation(selectedLocation);
  });

  function escapeHtml(value) {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  /* ================= PEOPLE ACCORDION ================= */

  function getPeople(location) {
    return Array.isArray(location.people) ? location.people : [];
  }

  const ICONS = {
    work: '<path d="M3 8h18v11H3z"></path><path d="M9 8V6a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path><path d="M3 13h18"></path>',
    industry: '<path d="M3 20V9l6 3V9l6 3V5h3v15z"></path>',
    phone: '<path d="M6.5 3.5h3l1.5 4-2 1.3a11 11 0 0 0 6.2 6.2l1.3-2 4 1.5v3a2 2 0 0 1-2 2A15.5 15.5 0 0 1 4.5 5.5a2 2 0 0 1 2-2z"></path>',
    mail: '<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3.5 7 8.5 6 8.5-6"></path>',
    linkedin: '<path d="M6 9v10M6 5.5v.01M11 19v-6a3 3 0 0 1 6 0v6M11 9v10"></path>',
    batch: '<rect x="3.5" y="5" width="17" height="15" rx="2"></rect><path d="M3.5 10h17M8 3v4M16 3v4"></path>',
    degree: '<path d="m2.5 9 9.5-4.5L21.5 9 12 13.5z"></path><path d="M6.5 11.5V16c1.5 1.4 3.4 2 5.5 2s4-.6 5.5-2v-4.5"></path>',
    dept: '<rect x="4" y="3.5" width="16" height="17" rx="2"></rect><path d="M9 8h.01M15 8h.01M9 12h.01M15 12h.01M10 20.5v-4h4v4"></path>'
  };

  function icon(name, size = 16) {
    return `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[name]}</svg>`;
  }

  const clean = v => (v && String(v).trim() && String(v).trim() !== "-") ? String(v).trim() : "";

  function linkedinUrl(v) {
    const value = clean(v);
    if (!value) return "";
    return /^https?:\/\//i.test(value) ? value : "https://" + value.replace(/^\/+/, "");
  }

  /* data only: icon + value, no title text */
  function infoRow(iconName, label, valueHtml) {
    return `
      <div class="person-info-row" title="${label}">
        <div class="person-info-icon">${icon(iconName, 13)}</div>
        <div class="person-info-text">
          <div class="person-info-value">${valueHtml}</div>
        </div>
      </div>`;
  }

  function buildPersonDetails(person) {
    const val = v => clean(v);
    const phone = clean(person.phone);
    const email = clean(person.email);
    const linkedin = linkedinUrl(person.linkedin);

    const phoneHtml = phone
      ? `<a href="tel:${escapeHtml(phone.replace(/[^+\d]/g, ""))}">${escapeHtml(phone)}</a>` : "";
    const emailHtml = email
      ? `<a href="mailto:${escapeHtml(email)}">${escapeHtml(email)}</a>` : "";
    const linkedinHtml = linkedin
      ? `<a href="${escapeHtml(linkedin)}" target="_blank" rel="noopener noreferrer">${escapeHtml(clean(person.linkedin))}</a>` : "";

    const rows = [
      ["work", "Designation", escapeHtml(val(person.role))],
      ["work", "Organization", escapeHtml(val(person.organization))],
      ["batch", "Batch", escapeHtml(val(person.batch))],
      ["degree", "Degree", escapeHtml(val(person.degree))],
      ["dept", "Department", escapeHtml(val(person.department))],
      ["industry", "Industry", escapeHtml(val(person.industry))],
      ["phone", "Phone", phoneHtml],
      ["mail", "Email", emailHtml],
      ["linkedin", "LinkedIn", linkedinHtml]
    ];

    /* only the data is shown (no label text); empty fields are skipped */
    return `<div class="person-info">${rows
      .filter(([, , html]) => html)
      .map(([ic, label, html]) => infoRow(ic, label, html))
      .join("")}</div>`;
  }

  function buildPeopleCards(location) {
    return getPeople(location).map((person, index) => `
      <div class="location-person-card">
        <div class="location-person-header">
          <div class="location-person-number">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="8" r="3.6"></circle>
              <path d="M4.5 20c.9-3.7 3.9-5.6 7.5-5.6s6.6 1.9 7.5 5.6"></path>
            </svg>
          </div>
          <div style="min-width:0;flex:1;">
            <div class="location-person-name">${escapeHtml(person.name || "-")}</div>
            <div class="location-person-designation">${escapeHtml(person.role || "-")}</div>
            ${person.organization && person.organization !== person.role
              ? `<div class="location-person-org">${escapeHtml(person.organization)}</div>`
              : ""}
          </div>
        </div>

        <div class="location-person-details">${buildPersonDetails(person)}</div>
      </div>
    `).join("");
  }

  function bindPersonAccordion(container) {
    if (!container || container.dataset.accordionBound) return;
    container.dataset.accordionBound = "true";

    container.addEventListener("click", event => {
      const header = event.target.closest(".location-person-header");
      if (!header || !container.contains(header)) return;

      event.preventDefault();
      event.stopPropagation();

      const card = header.closest(".location-person-card");
      if (!card) return;

      const willOpen = !card.classList.contains("person-expanded");

      if (!ALLOW_MULTIPLE_OPEN) {
        card.parentElement
          ?.querySelectorAll(".location-person-card.person-expanded")
          .forEach(other => {
            other.classList.remove("person-expanded");
            other.querySelector(".location-person-header")?.setAttribute("aria-expanded", "false");
          });
      }

      card.classList.toggle("person-expanded", willOpen);
      header.setAttribute("aria-expanded", String(willOpen));
    });
  }

  /* ================= RIGHT PANEL ================= */

  function showLocation(location) {
    if (!location) return;

    selectedLocation = location;
    detailsPanel?.classList.remove("hidden");

    const content = document.getElementById("details-content");
    if (!content) return;

    const count = getPeople(location).length;
    const label = count === 1 ? "person" : "people";

    content.innerHTML = `
      <div class="details-top">
        <div class="details-avatar">${escapeHtml(location.name?.charAt(0).toUpperCase() || "P")}</div>
        <div style="min-width:0;flex:1;">
          <div class="details-name">${escapeHtml(location.name)}</div>
          <div class="details-role">${count} ${label} from PSG</div>
          <div class="details-location-count">${escapeHtml(location.address || location.country || "")}</div>
        </div>
      </div>

      <div class="location-extra">
        <div class="location-extra-heading">
          <span>People in ${escapeHtml(location.name)}</span>
          <span>${count} ${label}</span>
        </div>
        <div class="location-people-list">${buildPeopleCards(location)}</div>
      </div>
    `;

    updateActiveLocation();
    updateSelectedMapMarker();
  }

  /* ================= CENTER MARKER ================= */

  function showCenterMarker(location) {
    if (!centerMarker || !location) return;
    centerMarker.classList.add("visible");
    if (centerLabel) centerLabel.textContent = location.name;
  }

  function hideCenterMarker() {
    centerMarker?.classList.remove("visible");
  }

  /* The target follows the real place on the globe */
  function trackCenterMarker() {
    requestAnimationFrame(trackCenterMarker);

    if (!globe || !centerMarker || !selectedLocation || !centerMarker.classList.contains("visible")) return;

    const lat = Number(selectedLocation.lat);
    const lng = Number(selectedLocation.lng);

    const point = globe.getCoords(lat, lng, 0.025);
    const cam = globe.camera().position;
    const radius = globe.getGlobeRadius();

    const facing = point.x * cam.x + point.y * cam.y + point.z * cam.z > radius * radius;

    if (!facing) {
      centerMarker.style.opacity = "0";
      centerMarker.style.pointerEvents = "none";
      return;
    }

    const screen = globe.getScreenCoords(lat, lng, 0.025);

    centerMarker.style.opacity = "1";
    centerMarker.style.pointerEvents = "auto";
    centerMarker.style.left = screen.x + "px";
    centerMarker.style.top = screen.y + "px";
  }

  /* ================= SELECTION HELPERS ================= */

  function updateSelectedMapMarker() {
    document.querySelectorAll(".station-marker").forEach(marker => {
      marker.classList.toggle(
        "selected",
        !!selectedLocation && Number(marker.dataset.locationId) === Number(selectedLocation.id)
      );
    });
  }

  function updateActiveLocation() {
    document.querySelectorAll(".location-item").forEach(item => {
      item.classList.toggle(
        "active",
        !!selectedLocation && Number(item.dataset.locationId) === Number(selectedLocation.id)
      );
    });
  }

  function syncLocationDropdown(locationId) {
    const item = locationList?.querySelector(`.location-item[data-location-id="${Number(locationId)}"]`);
    item?.scrollIntoView({ block: "nearest", behavior: "smooth" });
  }

  /* ================= FOCUS ================= */

  function focusLocation(location) {
    if (!globe || !location) return;

    const lat = Number(location.lat);
    const lng = Number(location.lng);
    if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;

    selectedLocation = location;
    clearTimeout(focusTimeout);

    const controls = globe.controls();
    if (controls) {
      controls.autoRotate = false;
      controls.enabled = false;
    }

    showCenterMarker(location);
    showLocation(location);
    syncLocationDropdown(location.id);

    globe.pointOfView({ lat, lng, altitude: 0.42 }, 1700);

    focusTimeout = setTimeout(() => {
      const c = globe?.controls();
      if (c) {
        c.enabled = true;
        c.autoRotate = false;
      }
    }, 1750);
  }

  /* ================= MARKERS ================= */

  function createLocationMarkers() {
    if (!globe) return;

    globe
      .htmlElementsData(locations)
      .htmlLat(location => Number(location.lat))
      .htmlLng(location => Number(location.lng))
      .htmlAltitude(0.025)
      .htmlElement(location => {
        const wrapper = document.createElement("div");
        wrapper.className = "station-marker";
        wrapper.dataset.locationId = String(location.id);

        wrapper.innerHTML = `
          <div class="station-marker-ring"></div>
          <div class="station-marker-core"></div>
          <div class="station-tooltip">${escapeHtml(location.name)}, ${escapeHtml(location.country)}</div>
        `;

        wrapper.addEventListener("click", event => {
          event.preventDefault();
          event.stopPropagation();
          focusLocation(location);
        });

        return wrapper;
      });

    updateSelectedMapMarker();
  }

  /* ================= LEFT LIST ================= */

  function locationMatches(location, query) {
    if (
      String(location.name || "").toLowerCase().includes(query) ||
      String(location.country || "").toLowerCase().includes(query)
    ) return true;

    return getPeople(location).some(person =>
      [person.name, person.role, person.organization, person.department]
        .some(value => String(value || "").toLowerCase().includes(query))
    );
  }

  function renderLocationList(filterText = "") {
    if (!locationList) return;

    const query = String(filterText).trim().toLowerCase();
    const filtered = locations.filter(location => !query || locationMatches(location, query));

    if (panelCount) {
      panelCount.textContent = `${filtered.length} location${filtered.length === 1 ? "" : "s"}`;
    }

    locationList.innerHTML = filtered.map(location => {
      const isActive = selectedLocation && Number(selectedLocation.id) === Number(location.id);

      return `
        <div class="location-item ${isActive ? "active" : ""}" data-location-id="${location.id}">
          <div class="location-main" role="button" tabindex="0">
            <div class="location-icon"><span class="location-icon-dot"></span></div>
            <div class="location-info">
              <div class="location-name">${escapeHtml(location.name)}</div>
              <div class="location-country">${escapeHtml(location.country)}</div>
            </div>
          </div>
        </div>
      `;
    }).join("");

    locationList.querySelectorAll(".location-main").forEach(main => {
      const item = main.closest(".location-item");
      if (!item) return;

      const handleFocus = () => {
        const id = Number(item.dataset.locationId);
        const location = locations.find(l => Number(l.id) === id);
        if (location) focusLocation(location);
      };

      main.addEventListener("click", handleFocus);
      main.addEventListener("keydown", event => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          handleFocus();
        }
      });
    });
  }

  /* ================= COUNTRIES ================= */

  async function loadCountries() {
    try {
      const response = await fetch("https://unpkg.com/world-atlas@2/countries-110m.json");
      if (!response.ok) throw new Error("Country map request failed");

      const world = await response.json();
      countryData = topojson.feature(world, world.objects.countries).features;

      globe
        ?.polygonsData(countryData)
        .polygonCapColor(() => "#ffe3d0")
        .polygonSideColor(() => "rgba(241, 220, 205, 0.6)")
        .polygonStrokeColor(() => "#e3b99d")
        .polygonAltitude(0.006);
    } catch (error) {
      console.error("Country map error:", error);
    }
  }

  /* ================= GLOBE ================= */

  function createGlobe() {
    if (!globeContainer) return;

    globe = new Globe(globeContainer, { animateIn: true });

    /* Website-colored globe: soft blue ocean, peach land, blue borders */
    globe
      .backgroundColor("rgba(0,0,0,0)")
      .showAtmosphere(true)
      .atmosphereColor("#7fb0e6")
      .atmosphereAltitude(0.14)
      .showGraticules(true);

    /* flat ocean colour (no satellite photo) */
    const ocean = globe.globeMaterial();
    ocean.color.set("#000000");
    ocean.emissive.set("#dcebf9");
    ocean.emissiveIntensity = 1;
    ocean.specular?.set("#000000");
    ocean.shininess = 0;

    /* even lighting so land colours stay true to the website palette */
    try {
      (globe.lights?.() || []).forEach(light => {
        if (light.isAmbientLight) { light.color.set("#ffffff"); light.intensity = 1.1; }
        if (light.isDirectionalLight) light.intensity = 0.25;
      });
    } catch (e) { /* lights API not available */ }

    createLocationMarkers();

    const controls = globe.controls();
    if (controls) {
      controls.enablePan = false;
      controls.enableZoom = true;
      controls.enableDamping = true;
      controls.dampingFactor = 0.08;
      controls.minDistance = 105;
      controls.maxDistance = 430;
      controls.autoRotate = true;
      controls.autoRotateSpeed = 0.18;
    }

    globe.pointOfView({ lat: 18, lng: 80, altitude: 2.05 }, 0);

    /* Click on the map -> nearest city */
    globe.onGlobeClick(({ lat, lng }) => {
      let nearest = null;
      let best = Infinity;

      locations.forEach(location => {
        const d = Math.hypot(Number(location.lat) - Number(lat), Number(location.lng) - Number(lng));
        if (d < best) { best = d; nearest = location; }
      });

      if (nearest) focusLocation(nearest);
    });

    function resizeGlobe() {
      if (!globe || !globeContainer) return;
      const w = globeContainer.clientWidth;
      const h = globeContainer.clientHeight;
      if (w > 0) globe.width(w);
      if (h > 0) globe.height(h);
    }

    window.addEventListener("resize", resizeGlobe);
    resizeGlobe();

    requestAnimationFrame(trackCenterMarker);

    setTimeout(() => loading?.classList.add("hidden"), 900);
  }

  /* ================= SEARCH ================= */

  searchInput?.addEventListener("input", () => renderLocationList(searchInput.value));

  searchInput?.addEventListener("keydown", event => {
    if (event.key !== "Enter") return;
    const query = searchInput.value.trim().toLowerCase();
    if (!query) return;
    const location = locations.find(item => locationMatches(item, query));
    if (location) focusLocation(location);
  });

  /* ================= BUTTONS ================= */

  document.getElementById("zoom-in")?.addEventListener("click", () => {
    const c = globe?.controls();
    if (c && typeof c.dollyIn === "function") { c.dollyIn(1.25); c.update(); }
  });

  document.getElementById("zoom-out")?.addEventListener("click", () => {
    const c = globe?.controls();
    if (c && typeof c.dollyOut === "function") { c.dollyOut(1.25); c.update(); }
  });

  document.getElementById("random-location")?.addEventListener("click", () => {
    if (!locations.length) return;

    let location;
    do {
      location = locations[Math.floor(Math.random() * locations.length)];
    } while (locations.length > 1 && selectedLocation && location.id === selectedLocation.id);

    focusLocation(location);
  });

  document.getElementById("reset-globe")?.addEventListener("click", () => {
    if (!globe) return;

    clearTimeout(focusTimeout);
    hideCenterMarker();
    selectedLocation = null;
    detailsPanel?.classList.add("hidden");
    updateActiveLocation();
    updateSelectedMapMarker();

    const controls = globe.controls();
    if (controls) {
      controls.enabled = false;
      controls.autoRotate = false;
    }

    globe.pointOfView({ lat: 18, lng: 80, altitude: 2.05 }, 1200);

    setTimeout(() => {
      const c = globe?.controls();
      if (c) {
        c.enabled = true;
        c.autoRotate = true;
      }
    }, 1250);
  });

  /* ================= INIT ================= */

  renderLocationList();
  createGlobe();
  loadCountries();

  selectedLocation = null;
  hideCenterMarker();
  detailsPanel?.classList.add("hidden");

</script>

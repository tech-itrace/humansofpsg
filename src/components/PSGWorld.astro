---
/* PSG WORLD - globe page, styled like the Humans of PSG website
   (white background, peach divider, Fredoka headings, Jost body, blue accent)
   v3: professional directory-style right panel
       - blue banner header with city + quick facts
       - filter + sort toolbar
       - collapsible people rows with copy-to-clipboard contact details */
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Jost:wght@300;400;500;600&display=swap"
  rel="stylesheet"
/>

<style is:global>
  :root {
    --bg: #ffffff;
    --ink: #1f1410;
    --muted: #6b5d56;
    --blue: #2b76c0;
    --blue-dark: #1f5fa6;
    --blue-soft: #eaf3fb;
    --line: #f4dfd1;
    --peach: #fff8f3;
    --shadow: 0 12px 40px rgba(60, 35, 20, 0.1);
    --head: "Fredoka", "Baloo 2", system-ui, sans-serif;
    --body: "Jost", "Segoe UI", system-ui, sans-serif;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0; padding: 0; width: 100%; height: 100%;
    overflow: hidden; background: var(--bg); color: var(--ink);
    font-family: var(--body); font-size: 15px; font-weight: 400;
    -webkit-font-smoothing: antialiased;
  }

  button, input { font: inherit; }

  .psg-world { position: relative; width: 100vw; height: 100vh; overflow: hidden; background: var(--bg); }
  .globe-panel { position: absolute; inset: 0; overflow: hidden; }
  #globe-container { position: absolute; inset: 0; z-index: 1; }
  #globe-container canvas { display: block; }

  /* ---------- TOP BAR (same as website nav) ---------- */
  .top-bar {
    position: absolute; left: 0; right: 0; top: 0; height: 90px;
    padding: 0 72px; display: flex; align-items: center; justify-content: space-between;
    z-index: 15; background: #fff; border-bottom: 1px solid var(--line);
    box-shadow: 0 2px 14px rgba(60, 35, 20, 0.05);
  }
  .brand { display: flex; align-items: center; gap: 10px; }
  .brand-title { font-family: var(--head); font-size: 15px; font-weight: 700; color: var(--ink); letter-spacing: 0.01em; }
  .brand-title b { color: inherit; font-style: normal; font-weight: 700; }

  .search-box { position: relative; width: 360px; }
  .search-input {
    width: 100%; height: 42px; padding: 0 18px 0 44px;
    border: 1px solid var(--line); border-radius: 999px; outline: none;
    background: #fff; color: var(--ink);
    font-family: var(--body); font-size: 14px; font-weight: 400; transition: 0.2s ease;
  }
  .search-input:focus { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(43, 118, 192, 0.12); }
  .search-input::placeholder { color: #8a7b73; font-weight: 400; }
  .search-icon {
    position: absolute; left: 17px; top: 50%; transform: translateY(-50%);
    color: var(--muted); font-size: 17px; pointer-events: none;
  }

  /* ---------- CENTER TARGET ---------- */
  .center-marker {
    position: absolute; left: 50%; top: 50%; width: 110px; height: 110px;
    transform: translate(-50%, -50%); z-index: 12; cursor: pointer; display: none;
  }
  .center-marker.visible { display: block; }
  .center-marker-dot {
    position: absolute; left: 50%; top: 50%; width: 12px; height: 12px;
    transform: translate(-50%, -50%); border-radius: 50%;
    background: var(--blue); border: 2px solid #fff;
    box-shadow: 0 0 0 4px rgba(43, 118, 192, 0.25), 0 4px 14px rgba(43, 118, 192, 0.6);
    z-index: 5;
  }
  .center-marker-ring {
    position: absolute; left: 50%; top: 50%; width: 30px; height: 30px;
    transform: translate(-50%, -50%); border: 2px solid var(--blue); border-radius: 50%;
    animation: centerRing 1.7s ease-out infinite;
  }
  .center-marker-ring-2 {
    position: absolute; left: 50%; top: 50%; width: 60px; height: 60px;
    transform: translate(-50%, -50%); border: 1px solid rgba(43, 118, 192, 0.4); border-radius: 50%;
    animation: centerRing2 2.2s ease-out infinite;
  }
  .center-cross-horizontal, .center-cross-vertical { position: absolute; background: rgba(43, 118, 192, 0.55); }
  .center-cross-horizontal { left: 10px; right: 10px; top: 54px; height: 1px; }
  .center-cross-vertical { top: 10px; bottom: 10px; left: 54px; width: 1px; }
  .center-label {
    position: absolute; left: 50%; top: 86px; transform: translateX(-50%);
    padding: 6px 14px; white-space: nowrap; font-family: var(--head);
    font-size: 13px; font-weight: 600; color: var(--ink);
    background: #fff; border: 1px solid var(--line); border-radius: 999px; box-shadow: var(--shadow);
  }
  @keyframes centerRing {
    0% { width: 22px; height: 22px; opacity: 1; }
    70% { width: 72px; height: 72px; opacity: 0.12; }
    100% { width: 78px; height: 78px; opacity: 0; }
  }
  @keyframes centerRing2 {
    0% { width: 45px; height: 45px; opacity: 0.5; }
    100% { width: 90px; height: 90px; opacity: 0; }
  }

  /* ---------- MAP MARKERS ---------- */
  .station-marker { position: relative; width: 30px; height: 30px; transform: translate(-50%, -50%); cursor: pointer; pointer-events: auto; }
  .station-marker-ring {
    position: absolute; left: 50%; top: 50%; width: 18px; height: 18px;
    transform: translate(-50%, -50%); border: 1.5px solid var(--blue); border-radius: 50%;
    animation: markerPulse 2s infinite;
  }
  .station-marker-core {
    position: absolute; left: 50%; top: 50%; width: 9px; height: 9px;
    transform: translate(-50%, -50%); border-radius: 50%;
    background: var(--blue); border: 1.5px solid #fff; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.45);
  }
  .station-marker.selected .station-marker-core { width: 13px; height: 13px; background: #fff; border: 3px solid var(--blue); }
  .station-marker.selected .station-marker-ring { width: 30px; height: 30px; }
  .station-tooltip {
    position: absolute; left: 50%; top: 24px; transform: translateX(-50%);
    white-space: nowrap; padding: 4px 10px; border-radius: 999px;
    font-family: var(--body); font-size: 13px; font-weight: 500; color: var(--ink);
    background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow);
    opacity: 0; pointer-events: none; transition: 0.18s ease;
  }
  .station-marker:hover .station-tooltip { opacity: 1; }
  @keyframes markerPulse {
    0% { transform: translate(-50%, -50%) scale(0.65); opacity: 0.9; }
    70% { transform: translate(-50%, -50%) scale(1.35); opacity: 0; }
    100% { opacity: 0; }
  }

  /* ---------- LEFT LOCATION PANEL ---------- */
  .location-panel {
    position: absolute; left: 32px; top: 114px; width: 300px;
    max-height: calc(100vh - 138px); z-index: 14; display: flex; flex-direction: column;
    overflow: hidden; background: #fff; border: 1px solid var(--line);
    border-radius: 22px; box-shadow: var(--shadow);
  }
  .panel-head { padding: 18px 20px 14px; border-bottom: 1px solid var(--line); }
  .panel-title { font-family: var(--head); font-size: 18px; font-weight: 700; color: var(--ink); }
  .panel-count { margin-top: 3px; color: var(--muted); font-size: 13px; font-weight: 400; }
  .location-list { padding: 8px; overflow-y: auto; }
  .location-list::-webkit-scrollbar { width: 5px; }
  .location-list::-webkit-scrollbar-thumb { border-radius: 20px; background: var(--line); }

  .location-item { margin-bottom: 3px; border: 1px solid transparent; border-radius: 14px; transition: 0.2s ease; }
  .location-item:hover { background: var(--peach); }
  .location-item.active { background: var(--blue-soft); border-color: rgba(43, 118, 192, 0.25); }
  .location-main { display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 8px 10px; cursor: pointer; }
  .location-main:focus-visible { outline: 2px solid var(--blue); outline-offset: -2px; border-radius: 14px; }
  .location-icon { flex: 0 0 auto; width: 32px; height: 32px; display: grid; place-items: center; border-radius: 50%; background: var(--blue-soft); }
  .location-icon-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--blue); }
  .location-info { min-width: 0; flex: 1; }
  .location-name { font-family: var(--body); font-size: 15px; font-weight: 500; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .location-item.active .location-name { color: var(--blue); font-weight: 600; }
  .location-country { margin-top: 1px; color: var(--muted); font-size: 13px; font-weight: 400; }

  /* ---------- RIGHT PANEL SHELL ----------
     Fits its content, scrolls only inside the people list. */
  .details-panel {
    position: absolute; right: 32px; top: 114px; width: 440px;
    max-height: calc(100vh - 138px);
    display: flex; flex-direction: column; overflow: hidden; z-index: 14;
    background: #fff; border: 1px solid var(--line); border-radius: 20px; box-shadow: var(--shadow);
    animation: panelIn 0.28s ease both;
  }
  .details-panel.hidden { display: none; }
  .details-content { flex: 1; min-height: 0; display: flex; flex-direction: column; overflow: hidden; }
  @keyframes panelIn {
    from { opacity: 0; transform: translateX(14px); }
    to { opacity: 1; transform: none; }
  }

  .details-close {
    position: absolute; right: 16px; top: 16px; z-index: 3;
    width: 34px; height: 34px; display: grid; place-items: center; cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.4); border-radius: 50%;
    background: rgba(255, 255, 255, 0.16); color: #fff; transition: 0.18s ease;
  }
  .details-close:hover { background: rgba(255, 255, 255, 0.3); }
  .details-close:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

  /* ---------- CONTROLS ---------- */
  .control-bar { position: absolute; right: 32px; top: 106px; z-index: 16; display: none; }
  .zoom-bar { position: absolute; left: 50%; bottom: 24px; transform: translateX(-50%); z-index: 15; display: flex; gap: 8px; }
  .control-button {
    width: 42px; height: 42px; display: grid; place-items: center; cursor: pointer;
    border: 1px solid var(--line); border-radius: 50%; background: #fff;
    color: var(--ink); font-size: 18px; box-shadow: var(--shadow); transition: 0.18s ease;
  }
  .control-button:hover { color: var(--blue); border-color: var(--blue); transform: translateY(-1px); }

  /* ---------- LOADING ---------- */
  .map-loading {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 30;
    padding: 12px 20px; border-radius: 999px; color: var(--muted); font-size: 14px;
    background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow);
  }
  .map-loading.hidden { display: none; }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 900px) {
    .top-bar { padding: 0 20px; height: 76px; }
    .search-box { width: 240px; }
    .location-panel { left: 12px; top: auto; bottom: 12px; width: 250px; max-height: 42vh; }
    .details-panel { right: 12px; top: auto; bottom: 12px; width: 340px; max-height: 66vh; }
    .zoom-bar { bottom: auto; top: 92px; left: auto; right: 12px; transform: none; flex-direction: column; }
  }
  @media (max-width: 650px) {
    .brand-title { font-size: 14px; }
    .search-box { width: 180px; }
    .location-panel { display: none; }
    .details-panel { left: 12px; right: 12px; width: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .details-panel { animation: none; }
  }
</style>

<div class="psg-world">

  <div class="globe-panel">
    <div id="globe-container"></div>

    <div id="center-marker" class="center-marker">
      <div class="center-marker-ring"></div>
      <div class="center-marker-ring-2"></div>
      <div class="center-cross-horizontal"></div>
      <div class="center-cross-vertical"></div>
      <div class="center-marker-dot"></div>
      <div id="center-label" class="center-label">Location</div>
    </div>
  </div>

  <div class="top-bar">
    <div class="brand">
      <div class="brand-title">Humans of <b>PSG</b></div>
    </div>

    <div class="search-box">
      <span class="search-icon">⌕</span>
      <input id="location-search" class="search-input" type="text" placeholder="Search by name, place, keyword..." autocomplete="off" />
    </div>
  </div>

  <div class="zoom-bar">
    <button id="zoom-in" class="control-button" title="Zoom in" type="button">+</button>
    <button id="zoom-out" class="control-button" title="Zoom out" type="button">−</button>
    <button id="random-location" class="control-button" title="Random location" type="button">⤨</button>
    <button id="reset-globe" class="control-button" title="Reset globe" type="button">◉</button>
  </div>

  <aside class="location-panel">
    <div class="panel-head">
      <div class="panel-title">PSG Alumni Members</div>
      <div id="panel-count" class="panel-count">0 locations</div>
    </div>
    <div id="location-list" class="location-list"></div>
  </aside>

  <section id="details-panel" class="details-panel hidden" aria-live="polite">
    <button id="details-close" class="details-close" type="button" aria-label="Close details">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
    <div id="details-content" class="details-content"></div>
  </section>

  <div id="map-loading" class="map-loading">Loading map...</div>

</div>

<script is:inline type="module">

  import Globe from "https://esm.sh/globe.gl@2.45.0";
  import * as topojson from "https://esm.sh/topojson-client@3";

  /* Data lives in public/data/psg-members.js */
  import { members, DEFAULT_CITY, CITY_COORDS } from "/data/psg-members.js";

  /* ================================================================
     RIGHT PANEL STYLES (professional directory design)
     Injected from JS so the panel is ALWAYS styled.
     ================================================================ */
  const PANEL_CSS = `
    .rp, .rp * { box-sizing:border-box; }
    .rp { display:flex; flex-direction:column; min-height:0; flex:1; font-family:"Jost","Segoe UI",system-ui,sans-serif; color:#1f1410; }

    /* ----- banner header ----- */
    .rp-head {
      position:relative; flex:0 0 auto; overflow:hidden; color:#fff;
      padding:26px 64px 22px 26px;
      background:linear-gradient(135deg,#1f5fa6 0%,#2b76c0 58%,#4a93d9 100%);
    }
    .rp-head::after {
      content:""; position:absolute; right:-70px; bottom:-90px; width:230px; height:230px;
      border-radius:50%; border:1px solid rgba(255,255,255,0.22);
      box-shadow:0 0 0 34px rgba(255,255,255,0.05), 0 0 0 68px rgba(255,255,255,0.04);
      pointer-events:none;
    }
    .rp-city {
      position:relative; z-index:1;
      font-family:"Fredoka","Baloo 2",system-ui,sans-serif; font-size:30px; font-weight:700;
      line-height:1.1; letter-spacing:-0.01em; overflow-wrap:anywhere;
    }
    .rp-sub { position:relative; z-index:1; margin-top:4px; font-size:14px; font-weight:300; color:rgba(255,255,255,0.86); }
    .rp-chips { position:relative; z-index:1; display:flex; flex-wrap:wrap; gap:8px; margin-top:16px; }
    .rp-chip {
      display:inline-flex; align-items:center; gap:6px; padding:4px 12px; border-radius:999px;
      background:rgba(255,255,255,0.16); border:1px solid rgba(255,255,255,0.3);
      font-size:12.5px; font-weight:500; line-height:1.4; white-space:nowrap;
    }

    /* ----- toolbar ----- */
    .rp-toolbar {
      flex:0 0 auto; display:flex; align-items:center; gap:10px;
      padding:14px 20px; border-bottom:1px solid #f4dfd1; background:#fff;
    }
    .rp-filter { position:relative; flex:1; min-width:0; }
    .rp-filter svg { position:absolute; left:11px; top:50%; transform:translateY(-50%); color:#8a7b73; pointer-events:none; }
    .rp-filter input {
      width:100%; height:38px; padding:0 12px 0 33px; border:1px solid #f4dfd1; border-radius:10px;
      background:#fff; color:#1f1410; font-size:13.5px; outline:none; transition:0.18s ease;
    }
    .rp-filter input::placeholder { color:#8a7b73; }
    .rp-filter input:focus { border-color:#2b76c0; box-shadow:0 0 0 3px rgba(43,118,192,0.12); }

    .rp-seg { display:inline-flex; padding:3px; border:1px solid #f4dfd1; border-radius:10px; background:#fff8f3; }
    .rp-seg button {
      height:30px; padding:0 11px; border:0; border-radius:7px; background:transparent; cursor:pointer;
      color:#6b5d56; font-size:12.5px; font-weight:500; white-space:nowrap; transition:0.18s ease;
    }
    .rp-seg button:hover { color:#2b76c0; }
    .rp-seg button.on { background:#fff; color:#2b76c0; font-weight:600; box-shadow:0 1px 4px rgba(60,35,20,0.12); }
    .rp-seg button:focus-visible { outline:2px solid #2b76c0; outline-offset:1px; }

    /* ----- people list ----- */
    .rp-list { flex:1; min-height:0; overflow-y:auto; }
    .rp-list::-webkit-scrollbar { width:5px; }
    .rp-list::-webkit-scrollbar-thumb { border-radius:20px; background:#f4dfd1; }

    .rp-item { border-bottom:1px solid #f4dfd1; transition:background 0.2s ease; }
    .rp-item:last-child { border-bottom:0; }
    .rp-item.open { background:#fffbf8; }

    .rp-row {
      display:grid; grid-template-columns:44px minmax(0,1fr) auto; align-items:center; column-gap:14px;
      width:100%; padding:15px 20px; border:0; background:transparent; text-align:left; cursor:pointer;
      color:inherit; transition:background 0.18s ease;
    }
    .rp-row:hover { background:#fff8f3; }
    .rp-row:focus-visible { outline:2px solid #2b76c0; outline-offset:-2px; }

    .rp-avatar {
      width:44px; height:44px; display:grid; place-items:center; border-radius:12px;
      background:#eaf3fb; color:#2b76c0;
      font-family:"Fredoka","Baloo 2",system-ui,sans-serif; font-size:15.5px; font-weight:600;
      transition:0.2s ease;
    }
    .rp-item.open .rp-avatar { background:#2b76c0; color:#fff; }

    .rp-info { min-width:0; }
    .rp-name {
      font-family:"Fredoka","Baloo 2",system-ui,sans-serif; font-size:16px; font-weight:600;
      line-height:1.25; color:#1f1410; overflow-wrap:anywhere;
    }
    .rp-role { margin-top:3px; font-size:13.5px; font-weight:500; line-height:1.35; color:#2b76c0; overflow-wrap:anywhere; }
    .rp-org  { margin-top:1px; font-size:12.5px; font-weight:300; line-height:1.4; color:#6b5d56; overflow-wrap:anywhere; }

    .rp-side { display:flex; flex-direction:column; align-items:flex-end; gap:8px; }
    .rp-batch {
      padding:2px 9px; border-radius:999px; background:#eaf3fb; color:#2b76c0;
      font-size:11.5px; font-weight:600; line-height:1.5; white-space:nowrap;
    }
    .rp-chev { color:#8a7b73; transition:transform 0.2s ease; }
    .rp-item.open .rp-chev { transform:rotate(180deg); color:#2b76c0; }

    /* ----- expandable contact details ----- */
    .rp-detail { display:none; padding:0 20px 16px 78px; }
    .rp-item.open .rp-detail { display:block; }
    .rp-detail-box { border:1px solid #f4dfd1; border-radius:12px; background:#fff; overflow:hidden; }
    .rp-c { display:flex; align-items:center; gap:12px; padding:10px 12px; }
    .rp-c + .rp-c { border-top:1px solid #f4dfd1; }
    .rp-c-ico {
      flex:0 0 30px; width:30px; height:30px; display:grid; place-items:center;
      border-radius:8px; background:#eaf3fb; color:#2b76c0;
    }
    .rp-c-text { flex:1; min-width:0; }
    .rp-c-label { font-size:11.5px; font-weight:400; line-height:1.2; color:#8a7b73; }
    .rp-c-value {
      display:block; margin-top:1px; font-size:13.5px; font-weight:500; line-height:1.3; color:#1f1410;
      text-decoration:none; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
    }
    a.rp-c-value:hover { color:#2b76c0; text-decoration:underline; }
    .rp-c-value:focus-visible { outline:2px solid #2b76c0; outline-offset:2px; border-radius:4px; }

    .rp-copy, .rp-open {
      flex:0 0 32px; width:32px; height:32px; display:grid; place-items:center; cursor:pointer;
      border:1px solid #f4dfd1; border-radius:8px; background:#fff; color:#6b5d56; text-decoration:none;
      transition:0.18s ease;
    }
    .rp-copy:hover, .rp-open:hover { color:#2b76c0; border-color:#2b76c0; background:#eaf3fb; }
    .rp-copy:focus-visible, .rp-open:focus-visible { outline:2px solid #2b76c0; outline-offset:2px; }
    .rp-copy.done { color:#1f8a4c; border-color:#1f8a4c; background:#eaf7ef; }
    .rp-copy .ic-check { display:none; }
    .rp-copy.done .ic-copy { display:none; }
    .rp-copy.done .ic-check { display:block; }

    .rp-nocontact { padding:12px; font-size:13px; font-weight:300; color:#6b5d56; }
    .rp-empty { padding:40px 26px; text-align:center; color:#6b5d56; font-size:14px; font-weight:300; }

    @media (max-width:650px) {
      .rp-head { padding:22px 56px 18px 20px; }
      .rp-city { font-size:26px; }
      .rp-seg button { padding:0 8px; }
      .rp-row { padding:14px 14px; column-gap:12px; grid-template-columns:40px minmax(0,1fr) auto; }
      .rp-avatar { width:40px; height:40px; }
      .rp-detail { padding:0 14px 14px 14px; }
    }
  `;

  (function injectPanelCss() {
    const style = document.createElement("style");
    style.id = "rp-panel-styles";
    style.textContent = PANEL_CSS;
    document.head.appendChild(style);
  })();

  /* ================= HELPERS ================= */

  const clean = v => (v && String(v).trim() && String(v).trim() !== "-") ? String(v).trim() : "";

  const sameText = (a, b) => clean(a).toLowerCase() === clean(b).toLowerCase();

  function escapeHtml(value) {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function linkedinUrl(v) {
    const value = clean(v);
    if (!value) return "";
    return /^https?:\/\//i.test(value) ? value : "https://" + value.replace(/^\/+/, "");
  }

  function initials(name) {
    const parts = String(name || "").trim().split(/\s+/).filter(Boolean);
    if (!parts.length) return "P";
    return ((parts[0][0] || "") + (parts.length > 1 ? parts[parts.length - 1][0] : "")).toUpperCase();
  }

  const batchNum = person => {
    const n = parseInt(person.batch, 10);
    return Number.isFinite(n) ? n : null;
  };

  /* ================= DATA ================= */

  function buildLocations(list) {
    const groups = new Map();

    list.forEach(member => {
      const city = member.city || DEFAULT_CITY;

      if (!CITY_COORDS[city]) {
        console.warn("City missing in CITY_COORDS:", city);
        return;
      }

      if (!groups.has(city)) groups.set(city, []);

      groups.get(city).push({
        name: member.name,
        designation: clean(member.jobTitle),
        organization: clean(member.organization),
        batch: clean(member.batch),
        phone: clean(member.phone),
        email: clean(member.email),
        linkedin: clean(member.linkedin)
      });
    });

    return [...groups.entries()].map(([city, people], index) => ({
      id: index + 1,
      name: city,
      branch: "PSG",
      ...CITY_COORDS[city],
      people
    }));
  }

  const locations = buildLocations(members);

  /* ================= STATE / DOM ================= */

  let globe = null;
  let selectedLocation = null;
  let focusTimeout = null;
  let countryData = [];

  /* state of the right panel (filter / sort / which rows are open) */
  const view = { query: "", sort: "newest", open: new Set() };

  const globeContainer = document.getElementById("globe-container");
  const locationList = document.getElementById("location-list");
  const searchInput = document.getElementById("location-search");
  const panelCount = document.getElementById("panel-count");
  const centerMarker = document.getElementById("center-marker");
  const centerLabel = document.getElementById("center-label");
  const loading = document.getElementById("map-loading");
  const detailsPanel = document.getElementById("details-panel");
  const detailsClose = document.getElementById("details-close");
  const detailsContent = document.getElementById("details-content");

  centerMarker?.addEventListener("click", event => {
    event.preventDefault();
    event.stopPropagation();
    if (selectedLocation) showLocation(selectedLocation);
  });

  /* ================= ICONS ================= */

  const ICONS = {
    phone: '<path d="M6.5 3.5h3l1.5 4-2 1.3a11 11 0 0 0 6.2 6.2l1.3-2 4 1.5v3a2 2 0 0 1-2 2A15.5 15.5 0 0 1 4.5 5.5a2 2 0 0 1 2-2z"></path>',
    mail: '<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3.5 7 8.5 6 8.5-6"></path>',
    linkedin: '<path d="M6 9v10M6 5.5v.01M11 19v-6a3 3 0 0 1 6 0v6M11 9v10"></path>',
    copy: '<rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V6a2 2 0 0 1 2-2h8"></path>',
    check: '<path d="m5 12.5 4.5 4.5L19 7.5"></path>',
    chevron: '<path d="m6 9 6 6 6-6"></path>',
    search: '<circle cx="11" cy="11" r="6.5"></circle><path d="m20 20-4-4"></path>',
    external: '<path d="M14 5h5v5M19 5l-8 8M18 14v4a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4"></path>'
  };

  function icon(name, size = 16, cls = "") {
    return `<svg class="${cls}" viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[name]}</svg>`;
  }

  /* ================= PEOPLE LIST ================= */

  function getPeople(location) {
    return Array.isArray(location.people) ? location.people : [];
  }

  function contactLine({ ico, label, text, href, copy, external }) {
    return `
      <div class="rp-c">
        <div class="rp-c-ico">${icon(ico, 15)}</div>
        <div class="rp-c-text">
          <div class="rp-c-label">${escapeHtml(label)}</div>
          <a class="rp-c-value" href="${escapeHtml(href)}" title="${escapeHtml(text)}"${external ? ' target="_blank" rel="noopener noreferrer"' : ""}>${escapeHtml(text)}</a>
        </div>
        ${copy
          ? `<button class="rp-copy" type="button" data-copy="${escapeHtml(copy)}" aria-label="Copy ${escapeHtml(label.toLowerCase())}" title="Copy">${icon("copy", 15, "ic-copy")}${icon("check", 15, "ic-check")}</button>`
          : `<a class="rp-open" href="${escapeHtml(href)}" target="_blank" rel="noopener noreferrer" aria-label="Open ${escapeHtml(label)}" title="Open">${icon("external", 15)}</a>`}
      </div>
    `;
  }

  function buildPersonRow(person, idx) {
    const designation = person.designation;
    const organization = person.organization;

    /* if designation is empty, organization moves up as the blue line; never shown twice */
    const roleLine = designation || organization;
    const orgLine = designation && organization && !sameText(designation, organization) ? organization : "";

    const linkedin = linkedinUrl(person.linkedin);
    const lines = [
      person.phone ? contactLine({ ico: "phone", label: "Phone", text: person.phone, href: "tel:" + person.phone.replace(/[^+\d]/g, ""), copy: person.phone }) : "",
      person.email ? contactLine({ ico: "mail", label: "Email", text: person.email, href: "mailto:" + person.email, copy: person.email }) : "",
      linkedin ? contactLine({ ico: "linkedin", label: "LinkedIn", text: "View profile", href: linkedin, external: true }) : ""
    ].join("");

    const isOpen = view.open.has(idx);

    return `
      <article class="rp-item${isOpen ? " open" : ""}" data-idx="${idx}">
        <button class="rp-row" type="button" aria-expanded="${isOpen}">
          <div class="rp-avatar">${escapeHtml(initials(person.name))}</div>
          <div class="rp-info">
            <div class="rp-name">${escapeHtml(person.name || "-")}</div>
            ${roleLine ? `<div class="rp-role">${escapeHtml(roleLine)}</div>` : ""}
            ${orgLine ? `<div class="rp-org">${escapeHtml(orgLine)}</div>` : ""}
          </div>
          <div class="rp-side">
            ${person.batch ? `<span class="rp-batch">Batch ${escapeHtml(person.batch)}</span>` : "<span></span>"}
            <span class="rp-chev">${icon("chevron", 16)}</span>
          </div>
        </button>
        <div class="rp-detail">
          <div class="rp-detail-box">${lines || `<div class="rp-nocontact">No contact details shared.</div>`}</div>
        </div>
      </article>
    `;
  }

  function sortedPeople(location) {
    /* keep the original index so open/closed state survives filtering + sorting */
    const items = getPeople(location).map((person, idx) => ({ person, idx }));

    const byName = (a, b) => String(a.person.name || "").localeCompare(String(b.person.name || ""));

    items.sort((a, b) => {
      if (view.sort === "az") return byName(a, b);
      const x = batchNum(a.person), y = batchNum(b.person);
      if (x === null && y === null) return byName(a, b);
      if (x === null) return 1;
      if (y === null) return -1;
      return view.sort === "oldest" ? x - y : y - x;
    });

    return items;
  }

  function renderPeople() {
    const list = detailsContent?.querySelector("#rp-list");
    if (!list || !selectedLocation) return;

    const q = view.query.trim().toLowerCase();
    let items = sortedPeople(selectedLocation);

    if (q) {
      items = items.filter(({ person }) =>
        [person.name, person.designation, person.organization, person.batch]
          .some(v => String(v || "").toLowerCase().includes(q))
      );
    }

    if (!items.length) {
      list.innerHTML = getPeople(selectedLocation).length
        ? `<div class="rp-empty">No alumni match “${escapeHtml(view.query.trim())}”.</div>`
        : `<div class="rp-empty">No alumni listed for this city yet.</div>`;
      return;
    }

    list.innerHTML = items.map(({ person, idx }) => buildPersonRow(person, idx)).join("");
  }

  /* ================= RIGHT PANEL ================= */

  function batchRange(people) {
    const nums = people.map(batchNum).filter(n => n !== null);
    if (!nums.length) return "";
    const min = Math.min(...nums), max = Math.max(...nums);
    return min === max ? `Batch ${min}` : `Batches ${min} to ${max}`;
  }

  function showLocation(location) {
    if (!location || !detailsContent) return;

    const sameCity = selectedLocation && selectedLocation.id === location.id && !detailsPanel.classList.contains("hidden");
    selectedLocation = location;

    /* re-trigger the slide-in only when the panel was closed */
    const wasHidden = detailsPanel.classList.contains("hidden");
    detailsPanel.classList.remove("hidden");
    if (wasHidden) {
      detailsPanel.style.animation = "none";
      void detailsPanel.offsetWidth;
      detailsPanel.style.animation = "";
    }

    const people = getPeople(location);
    const count = people.length;
    const place = location.address || location.country || "";
    const range = batchRange(people);

    /* new city -> reset filter + sort, open the first person */
    if (!sameCity) {
      view.query = "";
      view.sort = "newest";
      view.open = new Set();
      const first = sortedPeople(location)[0];
      if (first) view.open.add(first.idx);
    }

    detailsContent.innerHTML = `
      <div class="rp">
        <header class="rp-head">
          <div class="rp-city">${escapeHtml(location.name)}</div>
          ${place ? `<div class="rp-sub">${escapeHtml(place)}</div>` : ""}
          <div class="rp-chips">
            <span class="rp-chip">${count} ${count === 1 ? "alumnus" : "alumni"}</span>
            ${range ? `<span class="rp-chip">${escapeHtml(range)}</span>` : ""}
          </div>
        </header>

        ${count > 1 ? `
        <div class="rp-toolbar">
          <label class="rp-filter">
            ${icon("search", 16)}
            <input id="rp-filter-input" type="text" placeholder="Filter by name or company" autocomplete="off" value="${escapeHtml(view.query)}" />
          </label>
          <div class="rp-seg" role="group" aria-label="Sort people">
            <button type="button" data-sort="newest" class="${view.sort === "newest" ? "on" : ""}">Newest</button>
            <button type="button" data-sort="oldest" class="${view.sort === "oldest" ? "on" : ""}">Oldest</button>
            <button type="button" data-sort="az" class="${view.sort === "az" ? "on" : ""}">A to Z</button>
          </div>
        </div>` : ""}

        <div id="rp-list" class="rp-list"></div>
      </div>
    `;

    renderPeople();

    updateActiveLocation();
    updateSelectedMapMarker();
  }

  /* one set of listeners for the whole panel (content is re-rendered often) */
  detailsContent?.addEventListener("input", event => {
    if (event.target.id !== "rp-filter-input") return;
    view.query = event.target.value;
    renderPeople();
  });

  detailsContent?.addEventListener("click", async event => {
    /* sort buttons */
    const sortBtn = event.target.closest("[data-sort]");
    if (sortBtn) {
      view.sort = sortBtn.dataset.sort;
      detailsContent.querySelectorAll("[data-sort]").forEach(b => b.classList.toggle("on", b === sortBtn));
      renderPeople();
      return;
    }

    /* copy buttons */
    const copyBtn = event.target.closest(".rp-copy");
    if (copyBtn) {
      const text = copyBtn.dataset.copy || "";
      try {
        await navigator.clipboard.writeText(text);
      } catch (e) {
        const ta = document.createElement("textarea");
        ta.value = text;
        ta.style.position = "fixed";
        ta.style.opacity = "0";
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand("copy"); } catch (err) { /* ignore */ }
        ta.remove();
      }
      copyBtn.classList.add("done");
      copyBtn.title = "Copied";
      setTimeout(() => { copyBtn.classList.remove("done"); copyBtn.title = "Copy"; }, 1400);
      return;
    }

    /* open / close a person */
    const row = event.target.closest(".rp-row");
    if (row) {
      const item = row.closest(".rp-item");
      const idx = Number(item.dataset.idx);
      const open = !item.classList.contains("open");
      item.classList.toggle("open", open);
      row.setAttribute("aria-expanded", String(open));
      if (open) view.open.add(idx); else view.open.delete(idx);
    }
  });

  function closeDetails() {
    clearTimeout(focusTimeout);
    selectedLocation = null;
    detailsPanel?.classList.add("hidden");
    hideCenterMarker();
    updateActiveLocation();
    updateSelectedMapMarker();

    const c = globe?.controls();
    if (c) c.enabled = true;
  }

  detailsClose?.addEventListener("click", closeDetails);

  document.addEventListener("keydown", event => {
    if (event.key !== "Escape" || !selectedLocation) return;
    const tag = document.activeElement?.tagName;
    if (tag === "INPUT") return;
    closeDetails();
  });

  /* ================= CENTER MARKER ================= */

  function showCenterMarker(location) {
    if (!centerMarker || !location) return;
    centerMarker.classList.add("visible");
    if (centerLabel) centerLabel.textContent = location.name;
  }

  function hideCenterMarker() {
    centerMarker?.classList.remove("visible");
  }

  /* The target follows the real place on the globe */
  function trackCenterMarker() {
    requestAnimationFrame(trackCenterMarker);

    if (!globe || !centerMarker || !selectedLocation || !centerMarker.classList.contains("visible")) return;

    const lat = Number(selectedLocation.lat);
    const lng = Number(selectedLocation.lng);

    const point = globe.getCoords(lat, lng, 0.025);
    const cam = globe.camera().position;
    const radius = globe.getGlobeRadius();

    const facing = point.x * cam.x + point.y * cam.y + point.z * cam.z > radius * radius;

    if (!facing) {
      centerMarker.style.opacity = "0";
      centerMarker.style.pointerEvents = "none";
      return;
    }

    const screen = globe.getScreenCoords(lat, lng, 0.025);

    centerMarker.style.opacity = "1";
    centerMarker.style.pointerEvents = "auto";
    centerMarker.style.left = screen.x + "px";
    centerMarker.style.top = screen.y + "px";
  }

  /* ================= SELECTION HELPERS ================= */

  function updateSelectedMapMarker() {
    document.querySelectorAll(".station-marker").forEach(marker => {
      marker.classList.toggle(
        "selected",
        !!selectedLocation && Number(marker.dataset.locationId) === Number(selectedLocation.id)
      );
    });
  }

  function updateActiveLocation() {
    document.querySelectorAll(".location-item").forEach(item => {
      item.classList.toggle(
        "active",
        !!selectedLocation && Number(item.dataset.locationId) === Number(selectedLocation.id)
      );
    });
  }

  function syncLocationDropdown(locationId) {
    const item = locationList?.querySelector(`.location-item[data-location-id="${Number(locationId)}"]`);
    item?.scrollIntoView({ block: "nearest", behavior: "smooth" });
  }

  /* ================= FOCUS ================= */

  function focusLocation(location) {
    if (!globe || !location) return;

    const lat = Number(location.lat);
    const lng = Number(location.lng);
    if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;

    selectedLocation = location;
    clearTimeout(focusTimeout);

    const controls = globe.controls();
    if (controls) {
      controls.autoRotate = false;
      controls.enabled = false;
    }

    showCenterMarker(location);
    showLocation(location);
    syncLocationDropdown(location.id);

    globe.pointOfView({ lat, lng, altitude: 0.42 }, 1700);

    focusTimeout = setTimeout(() => {
      const c = globe?.controls();
      if (c) {
        c.enabled = true;
        c.autoRotate = false;
      }
    }, 1750);
  }

  /* ================= MARKERS ================= */

  function createLocationMarkers() {
    if (!globe) return;

    globe
      .htmlElementsData(locations)
      .htmlLat(location => Number(location.lat))
      .htmlLng(location => Number(location.lng))
      .htmlAltitude(0.025)
      .htmlElement(location => {
        const wrapper = document.createElement("div");
        wrapper.className = "station-marker";
        wrapper.dataset.locationId = String(location.id);

        wrapper.innerHTML = `
          <div class="station-marker-ring"></div>
          <div class="station-marker-core"></div>
          <div class="station-tooltip">${escapeHtml(location.name)}, ${escapeHtml(location.country)}</div>
        `;

        wrapper.addEventListener("click", event => {
          event.preventDefault();
          event.stopPropagation();
          focusLocation(location);
        });

        return wrapper;
      });

    updateSelectedMapMarker();
  }

  /* ================= LEFT LIST ================= */

  function locationMatches(location, query) {
    if (
      String(location.name || "").toLowerCase().includes(query) ||
      String(location.country || "").toLowerCase().includes(query)
    ) return true;

    return getPeople(location).some(person =>
      [person.name, person.designation, person.organization, person.batch]
        .some(value => String(value || "").toLowerCase().includes(query))
    );
  }

  function renderLocationList(filterText = "") {
    if (!locationList) return;

    const query = String(filterText).trim().toLowerCase();
    const filtered = locations.filter(location => !query || locationMatches(location, query));

    if (panelCount) {
      panelCount.textContent = `${filtered.length} location${filtered.length === 1 ? "" : "s"}`;
    }

    locationList.innerHTML = filtered.map(location => {
      const isActive = selectedLocation && Number(selectedLocation.id) === Number(location.id);

      return `
        <div class="location-item ${isActive ? "active" : ""}" data-location-id="${location.id}">
          <div class="location-main" role="button" tabindex="0">
            <div class="location-icon"><span class="location-icon-dot"></span></div>
            <div class="location-info">
              <div class="location-name">${escapeHtml(location.name)}</div>
              <div class="location-country">${escapeHtml(location.country)}</div>
            </div>
          </div>
        </div>
      `;
    }).join("");

    locationList.querySelectorAll(".location-main").forEach(main => {
      const item = main.closest(".location-item");
      if (!item) return;

      const handleFocus = () => {
        const id = Number(item.dataset.locationId);
        const location = locations.find(l => Number(l.id) === id);
        if (location) focusLocation(location);
      };

      main.addEventListener("click", handleFocus);
      main.addEventListener("keydown", event => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          handleFocus();
        }
      });
    });
  }

  /* ================= COUNTRIES ================= */

  async function loadCountries() {
    try {
      const response = await fetch("https://unpkg.com/world-atlas@2/countries-110m.json");
      if (!response.ok) throw new Error("Country map request failed");

      const world = await response.json();
      countryData = topojson.feature(world, world.objects.countries).features;

      globe
        ?.polygonsData(countryData)
        .polygonCapColor(() => "#ffe3d0")
        .polygonSideColor(() => "rgba(244, 223, 209, 0.6)")
        .polygonStrokeColor(() => "#e3b99d")
        .polygonAltitude(0.006);
    } catch (error) {
      console.error("Country map error:", error);
    }
  }

  /* ================= GLOBE ================= */

  function createGlobe() {
    if (!globeContainer) return;

    globe = new Globe(globeContainer, { animateIn: true });

    globe
      .backgroundColor("rgba(0,0,0,0)")
      .showAtmosphere(true)
      .atmosphereColor("#7fb0e6")
      .atmosphereAltitude(0.14)
      .showGraticules(true);

    /* flat ocean colour (no satellite photo) */
    const ocean = globe.globeMaterial();
    ocean.color.set("#000000");
    ocean.emissive.set("#dcebf9");
    ocean.emissiveIntensity = 1;
    ocean.specular?.set("#000000");
    ocean.shininess = 0;

    /* even lighting so land colours stay true to the website palette */
    try {
      (globe.lights?.() || []).forEach(light => {
        if (light.isAmbientLight) { light.color.set("#ffffff"); light.intensity = 1.1; }
        if (light.isDirectionalLight) light.intensity = 0.25;
      });
    } catch (e) { /* lights API not available */ }

    createLocationMarkers();

    const controls = globe.controls();
    if (controls) {
      controls.enablePan = false;
      controls.enableZoom = true;
      controls.enableDamping = true;
      controls.dampingFactor = 0.08;
      controls.minDistance = 105;
      controls.maxDistance = 430;
      controls.autoRotate = true;
      controls.autoRotateSpeed = 0.18;
    }

    globe.pointOfView({ lat: 18, lng: 80, altitude: 2.05 }, 0);

    /* Click on the map -> nearest city */
    globe.onGlobeClick(({ lat, lng }) => {
      let nearest = null;
      let best = Infinity;

      locations.forEach(location => {
        const d = Math.hypot(Number(location.lat) - Number(lat), Number(location.lng) - Number(lng));
        if (d < best) { best = d; nearest = location; }
      });

      if (nearest) focusLocation(nearest);
    });

    function resizeGlobe() {
      if (!globe || !globeContainer) return;
      const w = globeContainer.clientWidth;
      const h = globeContainer.clientHeight;
      if (w > 0) globe.width(w);
      if (h > 0) globe.height(h);
    }

    window.addEventListener("resize", resizeGlobe);
    resizeGlobe();

    requestAnimationFrame(trackCenterMarker);

    setTimeout(() => loading?.classList.add("hidden"), 900);
  }

  /* ================= SEARCH ================= */

  searchInput?.addEventListener("input", () => renderLocationList(searchInput.value));

  searchInput?.addEventListener("keydown", event => {
    if (event.key !== "Enter") return;
    const query = searchInput.value.trim().toLowerCase();
    if (!query) return;
    const location = locations.find(item => locationMatches(item, query));
    if (location) focusLocation(location);
  });

  /* ================= BUTTONS ================= */

  document.getElementById("zoom-in")?.addEventListener("click", () => {
    const c = globe?.controls();
    if (c && typeof c.dollyIn === "function") { c.dollyIn(1.25); c.update(); }
  });

  document.getElementById("zoom-out")?.addEventListener("click", () => {
    const c = globe?.controls();
    if (c && typeof c.dollyOut === "function") { c.dollyOut(1.25); c.update(); }
  });

  document.getElementById("random-location")?.addEventListener("click", () => {
    if (!locations.length) return;

    let location;
    do {
      location = locations[Math.floor(Math.random() * locations.length)];
    } while (locations.length > 1 && selectedLocation && location.id === selectedLocation.id);

    focusLocation(location);
  });

  document.getElementById("reset-globe")?.addEventListener("click", () => {
    if (!globe) return;

    clearTimeout(focusTimeout);
    hideCenterMarker();
    selectedLocation = null;
    detailsPanel?.classList.add("hidden");
    updateActiveLocation();
    updateSelectedMapMarker();

    const controls = globe.controls();
    if (controls) {
      controls.enabled = false;
      controls.autoRotate = false;
    }

    globe.pointOfView({ lat: 18, lng: 80, altitude: 2.05 }, 1200);

    setTimeout(() => {
      const c = globe?.controls();
      if (c) {
        c.enabled = true;
        c.autoRotate = true;
      }
    }, 1250);
  });

  /* ================= INIT ================= */

  renderLocationList();
  createGlobe();
  loadCountries();

  selectedLocation = null;
  hideCenterMarker();
  detailsPanel?.classList.add("hidden");

</script>

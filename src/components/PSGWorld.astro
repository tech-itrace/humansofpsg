  /* =======================================================
     GLOBAL STATE
  ======================================================= */

  let globe = null;

  let selectedLocation = null;

  let autoRotateTimeout = null;

  let focusTimeout = null;

  let countryData = [];


  /* =======================================================
     DOM
  ======================================================= */

  const globeContainer =
    document.getElementById("globe-container");

  const locationList =
    document.getElementById("location-list");

  const searchInput =
    document.getElementById("location-search");

  const panelCount =
    document.getElementById("panel-count");

  const centerMarker =
    document.getElementById("center-marker");

  const centerLabel =
    document.getElementById("center-label");

  const loading =
    document.getElementById("map-loading");

  const detailsPanel =
    document.getElementById("details-panel");


  /* =======================================================
     ESCAPE HTML
  ======================================================= */

  function escapeHtml(value) {

    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");

  }


  /* =======================================================
     UPDATE DETAILS
  ======================================================= */

  function showLocation(location) {

    if (!location) return;

    selectedLocation = location;

    // Show the right-side details only after the user selects a location.
    if (detailsPanel) {
      detailsPanel.classList.remove("hidden");
    }

    const avatar =
      document.getElementById("details-avatar");

    const name =
      document.getElementById("details-name");

    const role =
      document.getElementById("details-role");

    const city =
      document.getElementById("details-city");

    const country =
      document.getElementById("details-country");

    const branch =
      document.getElementById("details-branch");

    const person =
      document.getElementById("details-person");

    const phone =
      document.getElementById("details-phone");

    const email =
      document.getElementById("details-email");

    const address =
      document.getElementById("details-address");


    if (avatar) {
      avatar.textContent =
        location.name
          .charAt(0)
          .toUpperCase();
    }

    if (name) {
      name.textContent =
        location.name;
    }

    if (role) {
      role.textContent =
        location.role || "PSG Location";
    }

    if (city) {
      city.textContent =
        location.name;
    }

    if (country) {
      country.textContent =
        location.country;
    }

    if (branch) {
      branch.textContent =
        location.branch || "PSG";
    }

    if (person) {
      person.textContent =
        location.person || "-";
    }

    if (phone) {
      phone.textContent =
        location.phone || "-";
    }

    if (email) {
      email.textContent =
        location.email || "-";
    }

    if (address) {
      address.textContent =
        location.address || "-";
    }


    updateActiveLocation();

    updateSelectedMapMarker();

  }


  /* =======================================================
     EXACT CENTER MARKER
  ======================================================= */

  function showCenterMarker(location) {

    if (!centerMarker || !location) return;

    centerMarker.classList.add("visible");

    if (centerLabel) {

      centerLabel.textContent =
        location.name;

    }

  }


  function hideCenterMarker() {

    if (!centerMarker) return;

    centerMarker.classList.remove("visible");

  }


  /* =======================================================
     SELECTED MARKER
  ======================================================= */

  function updateSelectedMapMarker() {

    const markers =
      document.querySelectorAll(".station-marker");

    markers.forEach(marker => {

      const id =
        Number(marker.dataset.locationId);

      marker.classList.toggle(
        "selected",
        selectedLocation &&
        id === Number(selectedLocation.id)
      );

    });

  }


  /* =======================================================
     ACTIVE LIST ITEM
  ======================================================= */

  function updateActiveLocation() {

    const items =
      document.querySelectorAll(".location-item");

    items.forEach(item => {

      const id =
        Number(item.dataset.locationId);

      item.classList.toggle(
        "active",
        selectedLocation &&
        id === Number(selectedLocation.id)
      );

    });

  }


  /* =======================================================
     RADIO GARDEN STYLE FOCUS
  ======================================================= */

  function focusLocation(location) {

    if (!globe || !location) return;


    selectedLocation = location;


    const lat =
      Number(location.lat);

    const lng =
      Number(location.lng);


    if (
      !Number.isFinite(lat) ||
      !Number.isFinite(lng)
    ) {
      return;
    }


    /* -------------------------------------------------------
       STOP ROTATION
    ------------------------------------------------------- */

    clearTimeout(autoRotateTimeout);
    clearTimeout(focusTimeout);


    const controls =
      globe.controls();


    if (controls) {

      controls.autoRotate = false;

      /*
       * Temporarily disable dragging/zooming while
       * the Radio Garden style camera animation runs.
       */
      controls.enabled = false;

    }


    /* -------------------------------------------------------
       SHOW TARGET IMMEDIATELY
    ------------------------------------------------------- */

    showCenterMarker(location);

    showLocation(location);


    /* -------------------------------------------------------
       VERY CLOSE CAMERA
       Lower altitude = closer to globe.
    ------------------------------------------------------- */

    globe.pointOfView(
      {
        lat: lat,
        lng: lng,
        altitude: 0.42
      },
      1700
    );


    /* -------------------------------------------------------
       RESTORE USER CONTROLS AFTER ANIMATION
    ------------------------------------------------------- */

    focusTimeout = setTimeout(() => {

      if (!globe) return;

      const currentControls =
        globe.controls();

      if (currentControls) {

        currentControls.enabled = true;

        /*
         * Keep auto rotation OFF while user is focused
         * on the selected location.
         */
        currentControls.autoRotate = false;

      }

    }, 1750);

  }


  /* =======================================================
     CREATE LOCATION MARKERS
  ======================================================= */

  function createLocationMarkers() {

    if (!globe) return;


    globe
      .htmlElementsData(locations)

      .htmlLat(location =>
        Number(location.lat)
      )

      .htmlLng(location =>
        Number(location.lng)
      )

      /*
       * Slightly above globe surface so the marker
       * remains visible.
       */
      .htmlAltitude(0.025)

      .htmlElement(location => {

        const wrapper =
          document.createElement("div");

        wrapper.className =
          "station-marker";

        wrapper.dataset.locationId =
          String(location.id);


        wrapper.innerHTML = `

          <div class="station-marker-ring"></div>

          <div class="station-marker-core"></div>

          <div class="station-tooltip">
            ${escapeHtml(location.name)}
            ·
            ${escapeHtml(location.country)}
          </div>

        `;


        wrapper.addEventListener(
          "click",
          event => {

            event.preventDefault();

            event.stopPropagation();


            showLocation(location);

            focusLocation(location);

          }
        );


        return wrapper;

      });


    updateSelectedMapMarker();

  }


  /* =======================================================
     CREATE LOCATION LIST
     ACCORDION + ARROW DROPDOWN
  ======================================================= */

  function renderLocationList(
    filterText = ""
  ) {

    if (!locationList) return;


    const query =
      String(filterText)
        .trim()
        .toLowerCase();


    const filtered =
      locations.filter(location => {

        if (!query) return true;

        return (
          String(location.name || "")
            .toLowerCase()
            .includes(query) ||

          String(location.country || "")
            .toLowerCase()
            .includes(query) ||

          String(location.person || "")
            .toLowerCase()
            .includes(query) ||

          String(location.role || "")
            .toLowerCase()
            .includes(query)
        );

      });


    if (panelCount) {

      panelCount.textContent =
        `${filtered.length} location${filtered.length === 1 ? "" : "s"}`;

    }


    locationList.innerHTML =
      filtered.map(location => {

        const isActive =
          selectedLocation &&
          Number(selectedLocation.id) === Number(location.id);

        return `

          <div
            class="location-item ${isActive ? "active" : ""}"
            data-location-id="${location.id}"
          >

            <!-- MAIN LOCATION ROW -->

            <div
              class="location-main"
              role="button"
              tabindex="0"
              data-action="focus"
            >

              <div class="location-icon">
                <span class="location-icon-dot"></span>
              </div>


              <div class="location-info">

                <div class="location-name">
                  ${escapeHtml(location.name)}
                </div>

                <div class="location-country">
                  ${escapeHtml(location.country)}
                </div>

              </div>


              <!-- RIGHT ARROW -->

              <button
                type="button"
                class="location-arrow"
                data-action="toggle"
                aria-label="Show ${escapeHtml(location.name)} details"
                aria-expanded="false"
              >
                ›
              </button>

            </div>


            <!-- DROPDOWN DATA -->

            <div class="location-extra">

              <div class="location-extra-heading">
                <span>${escapeHtml(location.name)}</span>
                <span>${(location.people || []).length} people</span>
              </div>

              <div class="location-people-list">

                ${(location.people || []).map((person, index) => `

                  <div
                    class="location-person-card"
                    data-person-index="${index}"
                  >

                    <button
                      type="button"
                      class="location-person-header"
                      aria-expanded="false"
                    >

                      <div class="location-person-number">
                        ${index + 1}
                      </div>

                      <div style="min-width:0;flex:1;">
                        <div class="location-person-name">
                          ${escapeHtml(person.name || "-")}
                        </div>

                        <div class="location-person-role-preview">
                          ${escapeHtml(person.role || "-")}
                        </div>
                      </div>

                      <span class="location-person-arrow">›</span>

                    </button>

                    <div class="location-person-details">

                      <div class="person-detail-row">
                        <span class="person-detail-label">Role</span>
                        <span class="person-detail-value">
                          ${escapeHtml(person.role || "-")}
                        </span>
                      </div>

                      <div class="person-detail-row">
                        <span class="person-detail-label">Department</span>
                        <span class="person-detail-value">
                          ${escapeHtml(person.department || "-")}
                        </span>
                      </div>

                      <div class="person-detail-row">
                        <span class="person-detail-label">Phone</span>
                        <span class="person-detail-value">
                          ${escapeHtml(person.phone || "-")}
                        </span>
                      </div>

                      <div class="person-detail-row">
                        <span class="person-detail-label">Email</span>
                        <span class="person-detail-value">
                          ${escapeHtml(person.email || "-")}
                        </span>
                      </div>

                    </div>

                  </div>

                `).join("")}

              </div>

            </div>

          </div>

        `;

      }).join("");


    /* =====================================================
       MAIN ROW → FOCUS MAP
    ===================================================== */

    const mainRows =
      locationList.querySelectorAll(
        ".location-main"
      );


    mainRows.forEach(main => {

      const item =
        main.closest(".location-item");

      if (!item) return;


      const handleFocus = () => {

        const id =
          Number(item.dataset.locationId);

        const location =
          locations.find(
            itemLocation =>
              Number(itemLocation.id) === id
          );

        if (!location) return;

        focusLocation(location);

      };


      main.addEventListener(
        "click",
        event => {

          if (
            event.target.closest(
              ".location-arrow"
            )
          ) {
            return;
          }

          handleFocus();

        }
      );


      main.addEventListener(
        "keydown",
        event => {

          if (
            event.key === "Enter" ||
            event.key === " "
          ) {

            event.preventDefault();

            handleFocus();

          }

        }
      );

    });


    /* =====================================================
       PERSON NAME → OPEN / CLOSE PERSON DATA
    ===================================================== */

    const personHeaders =
      locationList.querySelectorAll(
        ".location-person-header"
      );

    personHeaders.forEach(header => {

      header.addEventListener("click", event => {

        event.preventDefault();
        event.stopPropagation();

        const card =
          header.closest(".location-person-card");

        if (!card) return;

        const parentList =
          card.parentElement;

        const isExpanded =
          card.classList.contains("person-expanded");

        /* Only one person opens inside a city */
        parentList
          ?.querySelectorAll(".location-person-card.person-expanded")
          .forEach(other => {

            if (other === card) return;

            other.classList.remove("person-expanded");

            const otherHeader =
              other.querySelector(".location-person-header");

            otherHeader?.setAttribute(
              "aria-expanded",
              "false"
            );

          });

        card.classList.toggle(
          "person-expanded",
          !isExpanded
        );

        header.setAttribute(
          "aria-expanded",
          String(!isExpanded)
        );

      });

    });


    /* =====================================================
       ARROW → OPEN / CLOSE CITY DROPDOWN
    ===================================================== */

    const arrows =
      locationList.querySelectorAll(
        ".location-arrow"
      );


    arrows.forEach(arrow => {

      arrow.addEventListener(
        "click",
        event => {

          event.preventDefault();

          event.stopPropagation();


          const item =
            arrow.closest(".location-item");

          if (!item) return;


          const isExpanded =
            item.classList.contains("expanded");


          /* Close every other dropdown */

          locationList
            .querySelectorAll(
              ".location-item.expanded"
            )
            .forEach(other => {

              if (other === item) return;

              other.classList.remove("expanded");

              const otherArrow =
                other.querySelector(
                  ".location-arrow"
                );

              if (otherArrow) {

                otherArrow.setAttribute(
                  "aria-expanded",
                  "false"
                );

              }

            });


          /* Toggle current dropdown */

          item.classList.toggle(
            "expanded",
            !isExpanded
          );


          arrow.setAttribute(
            "aria-expanded",
            String(!isExpanded)
          );

        }
      );

    });

  }


  /* =======================================================
     LOAD COUNTRY POLYGONS
  ======================================================= */

  async function loadCountries() {

    try {

      const response =
        await fetch(
          "https://unpkg.com/world-atlas@2/countries-110m.json"
        );


      if (!response.ok) {
        throw new Error(
          "Country map request failed"
        );
      }


      const world =
        await response.json();


      countryData =
        topojson.feature(
          world,
          world.objects.countries
        ).features;


      if (globe) {

        globe
          .polygonsData(countryData)

          .polygonCapColor(
            () => "rgba(20, 42, 46, 0.52)"
          )

          .polygonSideColor(
            () => "rgba(0, 255, 136, 0.025)"
          )

          .polygonStrokeColor(
            () => "rgba(0, 255, 136, 0.18)"
          )

          .polygonAltitude(0.004);

      }

    } catch (error) {

      console.error(
        "Country map error:",
        error
      );

    }

  }


  /* =======================================================
     CREATE GLOBE
  ======================================================= */

  function createGlobe() {

    if (!globeContainer) return;


    globe =
      new Globe(globeContainer, {
        animateIn: true
      });


    globe

      /* ---------------------------------------------------
         EARTH
      --------------------------------------------------- */

      .globeImageUrl(
        "https://unpkg.com/three-globe/example/img/earth-blue-marble.jpg"
      )

      .bumpImageUrl(
        "https://unpkg.com/three-globe/example/img/earth-topology.png"
      )

      .backgroundColor(
        "rgba(0,0,0,0)"
      )

      .showAtmosphere(true)

      .atmosphereColor(
        "#00ff88"
      )

      .atmosphereAltitude(
        0.12
      );


    /* -----------------------------------------------------
       LOCATIONS
    ----------------------------------------------------- */

    createLocationMarkers();


    /* -----------------------------------------------------
       CONTROLS
    ----------------------------------------------------- */

    const controls =
      globe.controls();


    if (controls) {

      controls.enablePan = false;

      controls.enableZoom = true;

      controls.enableDamping = true;

      controls.dampingFactor = 0.08;

      controls.minDistance = 105;

      controls.maxDistance = 430;

      controls.autoRotate = true;

      controls.autoRotateSpeed = 0.18;

    }


    /* -----------------------------------------------------
       INITIAL POV
    ----------------------------------------------------- */

    globe.pointOfView(
      {
        lat: 18,
        lng: 80,
        altitude: 2.05
      },
      0
    );


    /* -----------------------------------------------------
       GLOBE CLICK
    ----------------------------------------------------- */

    globe.onGlobeClick(
      () => {

        /*
         * Clicking empty globe area does not remove
         * selected location. This keeps the focus target.
         */

      }
    );


    /* -----------------------------------------------------
       ZOOM EVENT
    ----------------------------------------------------- */

    globe.onZoom(
      () => {

        /*
         * Intentionally left available for future
         * Radio Garden style UI changes.
         */

      }
    );


    /* -----------------------------------------------------
       RESIZE
    ----------------------------------------------------- */

    function resizeGlobe() {

      if (!globe || !globeContainer) {
        return;
      }


      const width =
        globeContainer.clientWidth;

      const height =
        globeContainer.clientHeight;


      if (width > 0) {

        globe.width(width);

      }

      if (height > 0) {

        globe.height(height);

      }

    }


    window.addEventListener(
      "resize",
      resizeGlobe
    );


    resizeGlobe();


    /* -----------------------------------------------------
       HIDE LOADING
    ----------------------------------------------------- */

    setTimeout(() => {

      if (loading) {

        loading.classList.add(
          "hidden"
        );

      }

    }, 900);

  }


  /* =======================================================
     SEARCH
  ======================================================= */

  if (searchInput) {

    searchInput.addEventListener(
      "input",
      () => {

        renderLocationList(
          searchInput.value
        );

      }
    );


    searchInput.addEventListener(
      "keydown",
      event => {

        if (event.key !== "Enter") {
          return;
        }


        const query =
          searchInput.value
            .trim()
            .toLowerCase();


        if (!query) return;


        const location =
          locations.find(item =>

            item.name
              .toLowerCase()
              .includes(query) ||

            item.country
              .toLowerCase()
              .includes(query) ||

            item.person
              .toLowerCase()
              .includes(query)

          );


        if (location) {

          focusLocation(location);

        }

      }
    );

  }


  /* =======================================================
     ZOOM IN
  ======================================================= */

  const zoomIn =
    document.getElementById(
      "zoom-in"
    );


  if (zoomIn) {

    zoomIn.addEventListener(
      "click",
      () => {

        if (!globe) return;


        const controls =
          globe.controls();


        if (
          controls &&
          typeof controls.dollyIn === "function"
        ) {

          controls.dollyIn(1.25);

        }

      }
    );

  }


  /* =======================================================
     ZOOM OUT
  ======================================================= */

  const zoomOut =
    document.getElementById(
      "zoom-out"
    );


  if (zoomOut) {

    zoomOut.addEventListener(
      "click",
      () => {

        if (!globe) return;


        const controls =
          globe.controls();


        if (
          controls &&
          typeof controls.dollyOut === "function"
        ) {

          controls.dollyOut(1.25);

        }

      }
    );

  }


  /* =======================================================
     RANDOM LOCATION
  ======================================================= */

  const randomButton =
    document.getElementById(
      "random-location"
    );


  if (randomButton) {

    randomButton.addEventListener(
      "click",
      () => {

        if (!locations.length) return;


        let location;


        do {

          location =
            locations[
              Math.floor(
                Math.random() *
                locations.length
              )
            ];

        } while (
          locations.length > 1 &&
          selectedLocation &&
          location.id === selectedLocation.id
        );


        focusLocation(location);

      }
    );

  }


  /* =======================================================
     RESET
  ======================================================= */

  const resetButton =
    document.getElementById(
      "reset-globe"
    );


  if (resetButton) {

    resetButton.addEventListener(
      "click",
      () => {

        if (!globe) return;


        clearTimeout(
          autoRotateTimeout
        );

        clearTimeout(
          focusTimeout
        );


        hideCenterMarker();

        // Return to the initial state: no location selected
        // and no right-side details panel visible.
        selectedLocation = null;

        if (detailsPanel) {
          detailsPanel.classList.add("hidden");
        }

        updateActiveLocation();
        updateSelectedMapMarker();


        const controls =
          globe.controls();


        if (controls) {

          controls.enabled = false;

          controls.autoRotate = false;

        }


        globe.pointOfView(
          {
            lat: 18,
            lng: 80,
            altitude: 2.05
          },
          1200
        );


        setTimeout(() => {

          if (!globe) return;


          const currentControls =
            globe.controls();


          if (currentControls) {

            currentControls.enabled = true;

            currentControls.autoRotate = true;

          }

        }, 1250);

      }
    );

  }


  /* =======================================================
     INITIALIZE
  ======================================================= */

  renderLocationList();

  createGlobe();

  loadCountries();


  /* =======================================================
     INITIAL STATE
  ======================================================= */

  /*
   * Important:
   * Do NOT select any location on initial page load.
   *
   * The globe starts clean:
   * - no right-side details panel
   * - no active location
   * - no center target
   *
   * The details panel appears only when the user clicks
   * a location from the list, globe marker, search result,
   * or random-location button.
   */

  selectedLocation = null;

  hideCenterMarker();

  if (detailsPanel) {
    detailsPanel.classList.add("hidden");
  }

  updateActiveLocation();
  updateSelectedMapMarker();

</script>
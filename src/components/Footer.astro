---
const base = import.meta.env.BASE_URL;

// Mirrors humansofpsg.org's own footer columns and links exactly.
const hopLinks = [
  { label: 'About', href: 'https://www.humansofpsg.org/about' },
  { label: 'PSG', href: 'https://www.humansofpsg.org/psg' },
  { label: 'System', href: 'https://www.humansofpsg.org/system' },
  { label: 'Alumni Journey', href: 'https://www.humansofpsg.org/alumnijourney' },
  { label: 'Community', href: 'http://hop.humansofpsg.org' },
];

const alumniJourneyLinks = [
  { label: 'Memories', href: 'https://www.humansofpsg.org/alumnijourney#memories' },
  { label: 'Moments', href: 'https://www.humansofpsg.org/alumnijourney#moments' },
  { label: 'Movements', href: 'https://www.humansofpsg.org/alumnijourney#movements' },
  { label: 'Models', href: 'https://www.humansofpsg.org/alumnijourney#models' },
  { label: 'Milestones', href: 'https://www.humansofpsg.org/alumnijourney#milestones' },
];

const legalLinks = [
  { label: 'Privacy Policy', href: 'https://www.humansofpsg.org/privacy-policy' },
  { label: 'Terms Of Use', href: 'https://www.humansofpsg.org/termsofuse' },
  { label: 'Legal', href: 'https://www.humansofpsg.org/legal' },
];

const socialLinks = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/company/humansofpsg' },
  { label: 'Instagram', href: 'https://www.instagram.com/hop_humansofpsg' },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-col footer-brand-col">
        <a class="footer-brand" href={base}>Humans Of PSG</a>
        <p class="footer-community-label">Join Our Community</p>
        <div class="footer-social">
          {
            socialLinks.map((social) => (
              <a href={social.href} aria-label={social.label} class="footer-social-link" target="_blank" rel="noopener">
                {social.label === 'LinkedIn' && (
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="3" fill="none" stroke="currentColor" stroke-width="1.6" />
                    <rect x="6.2" y="9.5" width="2.2" height="8" fill="currentColor" />
                    <circle cx="7.3" cy="6.6" r="1.3" fill="currentColor" />
                    <path
                      d="M10.8 9.5h2.1v1.1c.5-.7 1.3-1.3 2.6-1.3 1.9 0 3.1 1.2 3.1 3.5v4.7h-2.2v-4.3c0-1.1-.4-1.9-1.5-1.9-.8 0-1.3.5-1.5 1.1-.1.2-.1.5-.1.8v4.3h-2.2c0-.1.1-7.4 0-8z"
                      fill="currentColor"
                    />
                  </svg>
                )}
                {social.label === 'Instagram' && (
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.6" />
                    <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6" />
                    <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>

      <div class="footer-col">
        <ul class="footer-links">
          {
            hopLinks.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer-col">
        <ul class="footer-links">
          {
            alumniJourneyLinks.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer-col">
        <ul class="footer-links footer-contact">
          <li><a href="mailto:team@humansofpsg.org">team@humansofpsg.org</a></li>
          <li><a href="https://wa.me/917708633738" target="_blank" rel="noopener">+91 770 (863) 3738 (WA)</a></li>
          <li>Coimbatore</li>
          <li>Tamil Nadu</li>
          <li>India</li>
        </ul>
      </div>

      <div class="footer-col">
        <ul class="footer-links">
          {
            legalLinks.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</footer>

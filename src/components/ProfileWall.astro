---
import type { CollectionEntry } from 'astro:content';
import { resolvePhotoUrl } from '../lib/photoUrl';

interface Props {
  stories: CollectionEntry<'stories'>[];
}

const { stories } = Astro.props;
const base = import.meta.env.BASE_URL;

const uniqueSorted = (values: (string | undefined)[]) =>
  Array.from(new Set(values.filter((value): value is string => Boolean(value)))).sort((a, b) =>
    a.localeCompare(b)
  );

const cities = uniqueSorted(stories.map((story) => story.data.city));
const departments = uniqueSorted(stories.map((story) => story.data.department));
const expertises = uniqueSorted(stories.map((story) => story.data.expertise));

const searchText = (story: CollectionEntry<'stories'>) =>
  [story.data.name, story.data.location, story.data.city, story.data.department, story.data.expertise, story.data.pullQuote, ...story.data.tags]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();

// A stable but arbitrary shuffle so each row floats past in a different order.
const shuffle = <T,>(items: T[], seed: number) =>
  items
    .map((item, index) => ({ item, sort: Math.sin(index * 12.9898 + seed) * 43758.5453 % 1 }))
    .sort((a, b) => a.sort - b.sort)
    .map(({ item }) => item);

const rows = [shuffle(stories, 1), shuffle(stories, 2), shuffle(stories, 3)];
---

<div class="profile-wall">
  <div class="profile-filters">
    <select id="pw-city" aria-label="Filter by city">
      <option value="">All cities</option>
      {cities.map((city) => <option value={city}>{city}</option>)}
    </select>
    <select id="pw-department" aria-label="Filter by department">
      <option value="">All departments</option>
      {departments.map((department) => <option value={department}>{department}</option>)}
    </select>
    <select id="pw-expertise" aria-label="Filter by expertise">
      <option value="">All expertise</option>
      {expertises.map((expertise) => <option value={expertise}>{expertise}</option>)}
    </select>
    <input id="pw-search" type="search" placeholder="Search by name, place, keyword…" aria-label="Search profiles" />
  </div>

  <div class="profile-floating" id="pw-floating">
    {rows.map((row, rowIndex) => (
      <div class="profile-row" data-direction={rowIndex % 2 === 0 ? 'left' : 'right'}>
        <div class="profile-row-track">
          {[...row, ...row].map((story) => (
            <a
              class="profile-chip"
              href={`${base}psgians/${story.id}/`}
              data-city={story.data.city ?? ''}
              data-department={story.data.department ?? ''}
              data-expertise={story.data.expertise ?? ''}
              data-search={searchText(story)}
            >
              <img src={resolvePhotoUrl(base, story.data.photo)} alt={story.data.photoAlt} loading="lazy" />
              <span class="profile-chip-name">{story.data.name}</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="profile-grid" id="pw-grid" hidden>
    {stories.map((story) => (
      <a
        class="profile-card"
        href={`${base}psgians/${story.id}/`}
        data-city={story.data.city ?? ''}
        data-department={story.data.department ?? ''}
        data-expertise={story.data.expertise ?? ''}
        data-search={searchText(story)}
      >
        <img src={resolvePhotoUrl(base, story.data.photo)} alt={story.data.photoAlt} loading="lazy" />
        <span class="profile-card-name">{story.data.name}</span>
      </a>
    ))}
  </div>

  <p class="profile-empty" id="pw-empty" hidden>No profiles match these filters yet.</p>
</div>

<script>
  const wall = document.querySelector<HTMLElement>('.profile-wall');
  if (wall) {
    const city = wall.querySelector<HTMLSelectElement>('#pw-city');
    const department = wall.querySelector<HTMLSelectElement>('#pw-department');
    const expertise = wall.querySelector<HTMLSelectElement>('#pw-expertise');
    const search = wall.querySelector<HTMLInputElement>('#pw-search');
    const floating = wall.querySelector<HTMLElement>('#pw-floating');
    const grid = wall.querySelector<HTMLElement>('#pw-grid');
    const empty = wall.querySelector<HTMLElement>('#pw-empty');
    const cards = Array.from(wall.querySelectorAll<HTMLAnchorElement>('.profile-card'));

    const apply = () => {
      const cityVal = city?.value ?? '';
      const deptVal = department?.value ?? '';
      const expVal = expertise?.value ?? '';
      const searchVal = (search?.value ?? '').trim().toLowerCase();
      const isActive = Boolean(cityVal || deptVal || expVal || searchVal);

      if (!isActive) {
        floating?.removeAttribute('hidden');
        grid?.setAttribute('hidden', '');
        empty?.setAttribute('hidden', '');
        return;
      }

      floating?.setAttribute('hidden', '');
      grid?.removeAttribute('hidden');

      let visibleCount = 0;
      for (const card of cards) {
        const matches =
          (!cityVal || card.dataset.city === cityVal) &&
          (!deptVal || card.dataset.department === deptVal) &&
          (!expVal || card.dataset.expertise === expVal) &&
          (!searchVal || (card.dataset.search ?? '').includes(searchVal));
        card.style.display = matches ? '' : 'none';
        if (matches) visibleCount += 1;
      }

      if (visibleCount === 0) {
        empty?.removeAttribute('hidden');
      } else {
        empty?.setAttribute('hidden', '');
      }
    };

    [city, department, expertise].forEach((el) => el?.addEventListener('change', apply));
    search?.addEventListener('input', apply);
  }
</script>

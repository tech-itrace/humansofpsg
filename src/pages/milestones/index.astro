---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryCard from '../../components/StoryCard.astro';

const stories = (
  await getCollection('stories', ({ data }) => data.status === 'published' && data.tags.includes('milestones'))
).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout
  title="Milestones — Humans of PSG"
  description="Journeys of purpose and transformation — mentoring, coaching, and advisory stories from alumni who've walked the path before."
>
  <div class="wrap">
    <p class="section-title">Milestones</p>
    <h1 class="page-title">Milestones</h1>
    <p class="page-intro">
      Journeys of purpose and transformation — mentoring, coaching, and advisory stories from alumni who've
      walked the path before, so others can learn from where they've been.
    </p>
    {
      stories.length > 0 ? (
        <div class="story-grid">
          {stories.map((story) => (
            <StoryCard story={story} />
          ))}
        </div>
      ) : (
        <p class="empty-note">New milestones are on the way.</p>
      )
    }
  </div>
</BaseLayout>

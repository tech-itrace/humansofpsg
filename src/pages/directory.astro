const cities = [
  "Chennai", "Coimbatore", "Madurai", "Tiruchirappalli", "Salem",
  "Tirunelveli", "Thoothukudi", "Tiruppur", "Erode", "Vellore",
  "Dindigul", "Thanjavur", "Nagercoil", "Kanchipuram", "Ooty",

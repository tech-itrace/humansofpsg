const cities = [...new Set(people.map((p) => p.city))].sort();
const categories = [...new Set(people.map((p) => p.category))].sort();
---

<div class="directory-shell">

  <!-- =========================
       LEFT SIDEBAR
  ========================== -->
  <aside class="sidebar">

    <div class="brand">
      <div class="brand-icon">🌍</div>

      <div>
        <h1>World Directory</h1>
        <p>Global People Network</p>
      </div>
    </div>

    <div class="stats">
      <div class="stat">
        <strong>195</strong>
        <span>Countries</span>
      </div>

      <div class="stat">
        <strong>{people.length}</strong>
        <span>People</span>
      </div>
    </div>

    <!-- SEARCH -->
    <div class="search-box">
      <span>⌕</span>
      <input
        id="personSearch"
        type="text"
        placeholder="Search people..."
        autocomplete="off"
      />
    </div>

    <!-- CITY -->
    <div class="filter-section">
      <label for="citySelect">City</label>

      <select id="citySelect">
        <option value="">All Cities</option>

        {
          cities.map((city) => (
            <option value={city}>{city}</option>
          ))
        }
      </select>
    </div>

    <!-- CATEGORY -->
    <div class="filter-section">
      <label>Category</label>

      <div class="chips" id="chips">
        <button class="chip active" data-category="">All</button>

        {
          categories.map((category) => (
            <button
              class="chip"
              data-category={category}
            >
              {category}
            </button>
          ))
        }
      </div>
    </div>

    <!-- RESULT HEADER -->
    <div class="result-header">

      <div>
        <small id="selectedCountry">All Countries</small>

        <h2 id="selectedDistrict">
          All People
        </h2>
      </div>

      <strong id="resultCount">
        {people.length}
      </strong>

    </div>

    <!-- PEOPLE LIST -->
    <div class="people-list" id="peopleList"></div>

    <div class="empty-state" id="emptyState">
      <div>🔎</div>
      <strong>No people found</strong>
      <p>
        Try another search or clear your filters.
      </p>
    </div>

  </aside>


  <!-- =========================
       MAIN MAP AREA
  ========================== -->
  <main class="map-area">

    <div class="map-topbar">

      <div>
        <div class="map-kicker">
          GLOBAL DIRECTORY
        </div>

        <h2 id="mapTitle">
          World
        </h2>

        <p id="hoverName">
          Drag the globe • Scroll to zoom • Click India
        </p>
      </div>

      <div class="map-actions">

        <button
          id="backWorld"
          class="map-button hidden"
          type="button"
        >
          ← World
        </button>

        <button
          id="resetMap"
          class="map-button"
          type="button"
        >
          Reset
        </button>

      </div>

    </div>


    <!-- GLOBE -->
    <div
      id="map"
      class="globe-wrapper"
    >

      <div
        id="globeContainer"
        class="globe-container"
      ></div>

      <div
        id="mapLoading"
        class="map-loading"
      >
        <div class="loading-orbit">
          <span></span>
        </div>

        <strong>Loading Globe</strong>

        <small>
          Preparing the global directory...
        </small>
      </div>

      <div class="globe-vignette"></div>

      <div class="globe-center-glow"></div>

      <div class="interaction-hint">
        <span>↔</span>
        Drag
        <span>•</span>
        Scroll
        <span>•</span>
        Click
      </div>

    </div>


    <!-- LEGEND -->
    <div class="map-footer">

      <div class="legend">

        <div class="legend-item">
          <span class="legend-dot"></span>
          People location
        </div>

        <div class="legend-item">
          <span class="legend-ring"></span>
          Selected area
        </div>

      </div>

      <div id="mapHint">
        Click <strong>India</strong> to explore Tamil Nadu districts
      </div>

    </div>

  </main>


  <!-- =========================
       PERSON DETAILS
  ========================== -->
  <div
    id="personDetails"
    class="details-overlay hidden"
  >

    <div class="details-card">

      <button
        id="closeDetails"
        class="close-details"
        type="button"
        aria-label="Close"
      >
        ×
      </button>

      <div class="person-avatar-large" id="detailAvatar">
        A
      </div>

      <div class="detail-name">
        <h2 id="detailName">
          Person Name
        </h2>

        <span id="detailCategory">
          Category
        </span>
      </div>

      <div class="detail-company" id="detailCompany">
        Company
      </div>

      <div class="detail-location">
        <span>📍</span>
        <div id="detailLocation">
          Chennai, India
        </div>
      </div>

      <div class="detail-row">
        <span>📞</span>
        <a
          id="detailPhone"
          href="#"
        >
          Phone
        </a>
      </div>

      <div class="detail-row">
        <span>✉</span>
        <a
          id="detailEmail"
          href="#"
        >
          Email
        </a>
      </div>

      <div class="detail-description">
        <p id="detailDescription">
          Description
        </p>
      </div>

      <div class="detail-actions">

        <a
          id="callButton"
          class="detail-action primary"
          href="#"
        >
          📞 Call
        </a>

        <a
          id="emailButton"
          class="detail-action"
          href="#"
        >
          ✉ Email
        </a>

      </div>

    </div>

  </div>

</div>


<style>

  :global(*) {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
    background: #020706;
  }

  :global(body) {
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .directory-shell {
    width: 100%;
    min-height: 100vh;
    display: grid;
    grid-template-columns: 360px minmax(0, 1fr);
    overflow: hidden;
    color: #f3f8f5;
    background:
      radial-gradient(
        circle at 70% 50%,
        rgba(20, 100, 72, 0.12),
        transparent 38%
      ),
      #020706;
  }


  /* =================================
     SIDEBAR
  ================================= */

  .sidebar {
    position: relative;
    z-index: 20;
    height: 100vh;
    overflow-y: auto;
    padding: 24px 20px;
    border-right: 1px solid rgba(255,255,255,0.07);
    background:
      linear-gradient(
        180deg,
        rgba(6,18,14,0.98),
        rgba(2,9,7,0.98)
      );
  }

  .sidebar::-webkit-scrollbar {
    width: 5px;
  }

  .sidebar::-webkit-scrollbar-thumb {
    background: rgba(108,255,190,0.18);
    border-radius: 10px;
  }


  .brand {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-bottom: 24px;
  }

  .brand-icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background:
      linear-gradient(
        145deg,
        rgba(73,219,157,0.22),
        rgba(25,83,63,0.18)
      );
    border: 1px solid rgba(94,235,173,0.18);
    font-size: 25px;
  }

  .brand h1 {
    margin: 0;
    font-size: 19px;
    font-weight: 750;
    letter-spacing: -0.4px;
  }

  .brand p {
    margin: 3px 0 0;
    color: #78988b;
    font-size: 11px;
  }


  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 20px;
  }

  .stat {
    padding: 13px;
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 12px;
    background: rgba(255,255,255,0.025);
  }

  .stat strong {
    display: block;
    font-size: 20px;
    color: #8ff3c6;
  }

  .stat span {
    display: block;
    margin-top: 3px;
    color: #668276;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
  }


  .search-box {
    height: 45px;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 0 13px;
    border-radius: 11px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.035);
    margin-bottom: 20px;
  }

  .search-box span {
    color: #78a696;
    font-size: 22px;
  }

  .search-box input {
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    color: white;
    font-size: 13px;
  }

  .search-box input::placeholder {
    color: #567167;
  }


  .filter-section {
    margin-bottom: 20px;
  }

  .filter-section > label {
    display: block;
    margin-bottom: 8px;
    color: #6d8b80;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
  }


  #citySelect {
    width: 100%;
    height: 42px;
    padding: 0 12px;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 10px;
    outline: 0;
    color: #dceae5;
    background: #07110e;
    cursor: pointer;
  }


  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .chip {
    padding: 7px 10px;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 999px;
    color: #759389;
    background: rgba(255,255,255,0.025);
    font-size: 10px;
    cursor: pointer;
    transition: 0.2s ease;
  }

  .chip:hover {
    border-color: rgba(103,239,176,0.3);
    color: #b7f7d9;
  }

  .chip.active {
    border-color: rgba(92,239,174,0.5);
    color: #07130f;
    background: #77eeb8;
    font-weight: 700;
  }


  .result-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 2px 11px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .result-header small {
    color: #567267;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
  }

  .result-header h2 {
    margin: 3px 0 0;
    font-size: 15px;
  }

  .result-header > strong {
    display: grid;
    place-items: center;
    min-width: 28px;
    height: 28px;
    border-radius: 8px;
    color: #9cf7ce;
    background: rgba(91,237,172,0.1);
    font-size: 11px;
  }


  .people-list {
    padding-top: 7px;
  }

  .person-row {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 10px 8px;
    margin-bottom: 2px;
    border: 1px solid transparent;
    border-radius: 11px;
    background: transparent;
    color: white;
    text-align: left;
    cursor: pointer;
    transition: 0.18s ease;
  }

  .person-row:hover {
    border-color: rgba(92,237,173,0.1);
    background: rgba(79,205,153,0.06);
  }

  .person-mini-avatar {
    width: 35px;
    height: 35px;
    flex: 0 0 35px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #072016;
    background: linear-gradient(145deg,#9df6cc,#52c99a);
    font-weight: 800;
    font-size: 12px;
  }

  .person-row-info {
    min-width: 0;
    flex: 1;
  }

  .person-row-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 12px;
    font-weight: 700;
  }

  .person-row-meta {
    margin-top: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #607b71;
    font-size: 10px;
  }

  .person-row-arrow {
    color: #456259;
    font-size: 16px;
  }


  .empty-state {
    display: none;
    padding: 45px 15px;
    text-align: center;
    color: #638076;
  }

  .empty-state > div {
    font-size: 28px;
    margin-bottom: 8px;
  }

  .empty-state strong {
    display: block;
    color: #a5bdb5;
    font-size: 13px;
  }

  .empty-state p {
    margin: 5px 0;
    font-size: 10px;
  }


  /* =================================
     MAP AREA
  ================================= */

  .map-area {
    position: relative;
    min-width: 0;
    height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(
        ellipse at 50% 50%,
        rgba(11,66,49,0.13),
        transparent 58%
      ),
      #010504;
  }

  .map-topbar {
    position: absolute;
    z-index: 10;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 28px 32px;
    pointer-events: none;
  }

  .map-topbar > div,
  .map-actions {
    pointer-events: auto;
  }

  .map-kicker {
    color: #4fa989;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  .map-topbar h2 {
    margin: 5px 0 3px;
    font-size: 25px;
    letter-spacing: -0.8px;
  }

  .map-topbar p {
    margin: 0;
    color: #668279;
    font-size: 11px;
  }

  .map-actions {
    display: flex;
    gap: 8px;
  }

  .map-button {
    height: 36px;
    padding: 0 13px;
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: 9px;
    color: #b5ccc4;
    background: rgba(5,17,13,0.78);
    backdrop-filter: blur(12px);
    cursor: pointer;
    font-size: 11px;
    transition: 0.2s ease;
  }

  .map-button:hover {
    color: #a1f5cd;
    border-color: rgba(89,239,172,0.35);
    background: rgba(11,36,27,0.85);
  }

  .hidden {
    display: none !important;
  }


  .globe-wrapper {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .globe-container {
    position: absolute;
    inset: 0;
  }

  .globe-container canvas {
    display: block;
    cursor: grab;
  }

  .globe-container canvas:active {
    cursor: grabbing;
  }


  .globe-vignette {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse at center,
        transparent 38%,
        rgba(0,0,0,0.2) 68%,
        rgba(0,0,0,0.65) 100%
      );
  }

  .globe-center-glow {
    position: absolute;
    z-index: 2;
    width: 500px;
    height: 500px;
    left: 50%;
    top: 50%;
    transform: translate(-50%,-50%);
    border-radius: 50%;
    pointer-events: none;
    background:
      radial-gradient(
        circle,
        rgba(47,200,139,0.08),
        transparent 68%
      );
    filter: blur(20px);
  }


  .map-loading {
    position: absolute;
    z-index: 20;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 7px;
    background: #020706;
    color: #a8c7bc;
    transition: opacity 0.5s ease;
  }

  .map-loading.hide {
    opacity: 0;
    pointer-events: none;
  }

  .map-loading strong {
    font-size: 14px;
  }

  .map-loading small {
    color: #4e7064;
    font-size: 10px;
  }

  .loading-orbit {
    width: 48px;
    height: 48px;
    margin-bottom: 8px;
    border: 1px solid rgba(95,240,178,0.12);
    border-top-color: #71e9b5;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  .loading-orbit span {
    display: block;
    width: 7px;
    height: 7px;
    margin: 3px;

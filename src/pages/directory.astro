</div>


<script define:vars={{ people }}>
  const mapSvg = document.getElementById("mapSvg");
  const mapLoading = document.getElementById("mapLoading");

  const personSearch = document.getElementById("personSearch");
  const citySelect = document.getElementById("citySelect");

  const peopleList = document.getElementById("peopleList");
  const emptyState = document.getElementById("emptyState");

  const resultCount = document.getElementById("resultCount");
  const selectedCountry = document.getElementById("selectedCountry");
  const selectedDistrict = document.getElementById("selectedDistrict");

  const hoverName = document.getElementById("hoverName");
  const mapTitle = document.getElementById("mapTitle");
  const mapHint = document.getElementById("mapHint");

  const resetMap = document.getElementById("resetMap");
  const backWorld = document.getElementById("backWorld");

  const details = document.getElementById("personDetails");
  const closeDetails = document.getElementById("closeDetails");

  const detailAvatar = document.getElementById("detailAvatar");
  const detailName = document.getElementById("detailName");
  const detailCategory = document.getElementById("detailCategory");
  const detailCompany = document.getElementById("detailCompany");
  const detailLocation = document.getElementById("detailLocation");
  const detailPhone = document.getElementById("detailPhone");
  const detailEmail = document.getElementById("detailEmail");
  const detailDescription = document.getElementById("detailDescription");
  const callBtn = document.getElementById("callBtn");
  const emailBtn = document.getElementById("emailBtn");

  const chips = document.querySelectorAll(".chip");

  const WORLD_URL =
    "https://raw.githubusercontent.com/datasets/geo-countries/master/data/countries.geojson";

  const TAMIL_NADU_URL =
    "https://cdn.jsdelivr.net/gh/udit-001/india-maps-data@2884453/geojson/states/tamil-nadu.geojson";

  const COLORS = {
    empty: "#e5eee9",
    one: "#9ed7bb",
    many: "#4caf82",
    hover: "#f8c766",
    active: "#f59e0b",
    stroke: "#ffffff",
    dot: "#0f4c3a"
  };

  let worldGeoJSON = null;
  let tamilNaduGeoJSON = null;

  let currentMode = "world";

  let currentCountry = "";
  let currentDistrict = "";
  let currentCategory = "";
  let currentPersonId = "";

  let worldLoaded = false;
  let tamilNaduLoaded = false;


  /* =========================================================
     NORMALIZE
  ========================================================= */

  function normalize(value) {
    return String(value || "")
      .trim()
      .toLowerCase()
      .replace(/&/g, "and")
      .replace(/[^a-z0-9]/g, "");
  }


  function normalizeDistrict(value) {
    const v = normalize(value);

    const aliases = {
      kancheepuram: "kanchipuram",
      kanchipuram: "kanchipuram",

      tiruchirappalli: "tiruchirappalli",
      trichy: "tiruchirappalli",

      thoothukudi: "thoothukudi",
      tuticorin: "thoothukudi",

      tirunelveli: "tirunelveli",

      tiruvallur: "tiruvallur",
      thiruvallur: "tiruvallur",

      tiruppur: "tiruppur",

      nilgiris: "nilgiris",
      theNilgiris: "nilgiris"
    };

    return aliases[v] || v;
  }


  /* =========================================================
     COUNTRY NAME
  ========================================================= */

  function getCountryName(feature) {

    const p = feature?.properties || {};

    return (
      p.ADMIN ||
      p.NAME ||
      p.NAME_LONG ||
      p.NAME_EN ||
      p.name ||
      p.SOVEREIGNT ||
      p.BRK_NAME ||
      p.formal_en ||
      "Unknown"
    );
  }


  /* =========================================================
     DISTRICT NAME
  ========================================================= */

  function getDistrictName(feature) {

    const p = feature?.properties || {};

    return (
      p.district ||
      p.DISTRICT ||
      p.DISTRICT_NAME ||
      p.DISTRICTNAME ||
      p.dtname ||
      p.DT_NAME ||
      p.NAME_2 ||
      p.NAME ||
      p.name ||
      p.NAME_EN ||
      p.REGNAME ||
      "Unknown District"
    );
  }


  /* =========================================================
     PEOPLE COUNTS
  ========================================================= */

  function getCountryCount(country) {

    return people.filter(
      person =>
        normalize(person.country) === normalize(country)
    ).length;
  }


  function getDistrictCount(district) {

    return people.filter(
      person =>
        normalizeDistrict(person.district) ===
        normalizeDistrict(district)
    ).length;
  }


  /* =========================================================
     PEOPLE WORD
  ========================================================= */

  function peopleWord(count) {

    if (count === 1) return "1 person";

    return `${count} people`;
  }


  /* =========================================================
     SVG HELPERS
  ========================================================= */

  function getAllCoordinates(geometry) {

    const coords = [];

    function walk(value) {

      if (!Array.isArray(value)) return;

      if (
        value.length >= 2 &&
        typeof value[0] === "number" &&
        typeof value[1] === "number"
      ) {
        coords.push(value);
        return;
      }

      value.forEach(walk);
    }

    walk(geometry.coordinates);

    return coords;
  }


  function getBounds(features) {

    let minLon = Infinity;
    let maxLon = -Infinity;

    let minLat = Infinity;
    let maxLat = -Infinity;

    features.forEach(feature => {

      const coords = getAllCoordinates(feature.geometry);

      coords.forEach(([lon, lat]) => {

        minLon = Math.min(minLon, lon);
        maxLon = Math.max(maxLon, lon);

        minLat = Math.min(minLat, lat);
        maxLat = Math.max(maxLat, lat);

      });

    });

    return {
      minLon,
      maxLon,
      minLat,
      maxLat
    };
  }


  function createProjector(features) {

    const bounds = getBounds(features);

    const padding = 45;

    const W = 1200;
    const H = 650;

    const lonRange =
      Math.max(bounds.maxLon - bounds.minLon, 0.01);

    const latRange =
      Math.max(bounds.maxLat - bounds.minLat, 0.01);

    const scaleX =
      (W - padding * 2) / lonRange;

    const scaleY =
      (H - padding * 2) / latRange;

    const scale = Math.min(scaleX, scaleY);

    const mapWidth = lonRange * scale;
    const mapHeight = latRange * scale;

    const offsetX = (W - mapWidth) / 2;
    const offsetY = (H - mapHeight) / 2;

    return function project(lon, lat) {

      return {
        x:
          offsetX +
          (lon - bounds.minLon) * scale,

        y:
          H -
          offsetY -
          (lat - bounds.minLat) * scale
      };
    };
  }


  function ringToPath(ring, project) {

    if (!ring || !ring.length) return "";

    return ring
      .map(([lon, lat], index) => {

        const p = project(lon, lat);

        return `${index === 0 ? "M" : "L"} ${p.x} ${p.y}`;

      })
      .join(" ") + " Z";
  }


  function geometryToPath(geometry, project) {

    if (!geometry) return "";

    if (geometry.type === "Polygon") {

      return geometry.coordinates
        .map(ring => ringToPath(ring, project))
        .join(" ");
    }

    if (geometry.type === "MultiPolygon") {

      return geometry.coordinates
        .flat()
        .map(ring => ringToPath(ring, project))
        .join(" ");
    }

    return "";
  }


  /* =========================================================
     SVG ELEMENT
  ========================================================= */

  function createSvgElement(name) {

    return document.createElementNS(
      "http://www.w3.org/2000/svg",
      name
    );
  }


  /* =========================================================
     DRAW WORLD MAP
  ========================================================= */

  function renderWorldMap() {

    if (!worldGeoJSON) return;

    currentMode = "world";

    mapSvg.innerHTML = "";

    const features =
      worldGeoJSON.features || [];

    const project =
      createProjector(features);


    features.forEach(feature => {

      const country =
        getCountryName(feature);

      const count =
        getCountryCount(country);

      const path =
        createSvgElement("path");

      path.setAttribute(
        "d",
        geometryToPath(
          feature.geometry,
          project
        )
      );

      path.dataset.country = country;

      path.classList.add("map-area");

      if (
        normalize(country) ===
        normalize(currentCountry)
      ) {
        path.classList.add("active-area");
      }

      if (count === 0) {

        path.style.fill =
          COLORS.empty;

      } else if (count === 1) {

        path.style.fill =
          COLORS.one;

      } else {

        path.style.fill =
          COLORS.many;
      }


      path.addEventListener("mouseenter", () => {

        hoverName.textContent =
          `${country} • ${peopleWord(count)}`;

      });


      path.addEventListener("mouseleave", () => {

        hoverName.textContent =
          "Click India to explore Tamil Nadu";

      });


      path.addEventListener("click", () => {

        if (
          normalize(country) ===
          "india"
        ) {

          openTamilNadu();

          return;
        }

        selectCountry(country);

      });


      mapSvg.appendChild(path);


      /* COUNTRY DOT */

      if (count > 0) {

        const coords =
          getAllCoordinates(feature.geometry);

        if (coords.length) {

          let lon = 0;
          let lat = 0;

          coords.forEach(([x, y]) => {

            lon += x;
            lat += y;

          });

          lon /= coords.length;
          lat /= coords.length;

          const p =
            project(lon, lat);

          const circle =
            createSvgElement("circle");

          circle.setAttribute(
            "cx",
            p.x
          );

          circle.setAttribute(
            "cy",
            p.y
          );

          circle.setAttribute(
            "r",
            count > 1 ? "6" : "4"
          );

          circle.classList.add(
            "person-dot"
          );

          circle.addEventListener(
            "click",
            event => {

              event.stopPropagation();

              if (
                normalize(country) ===
                "india"
              ) {
                openTamilNadu();
              }

            }
          );

          mapSvg.appendChild(circle);
        }
      }

    });


    mapTitle.textContent =
      "World Map";

    mapHint.textContent =
      "Click India to explore Tamil Nadu districts";

    backWorld.classList.add("hidden");

    mapLoading.classList.add("hidden");
  }


  /* =========================================================
     DRAW TAMIL NADU
  ========================================================= */

  function renderTamilNaduMap() {

    if (!tamilNaduGeoJSON) return;

    currentMode = "tamilnadu";

    mapSvg.innerHTML = "";

    const features =
      tamilNaduGeoJSON.features || [];

    const project =
      createProjector(features);


    features.forEach(feature => {

      const district =
        getDistrictName(feature);

      const count =
        getDistrictCount(district);

      const path =
        createSvgElement("path");

      path.setAttribute(
        "d",
        geometryToPath(
          feature.geometry,
          project
        )
      );

      path.dataset.district =
        district;

      path.classList.add(
        "map-area",
        "district-area"
      );


      if (
        normalizeDistrict(district) ===
        normalizeDistrict(currentDistrict)
      ) {

        path.classList.add(
          "active-area"
        );
      }


      if (count === 0) {

        path.style.fill =
          COLORS.empty;

      } else if (count === 1) {

        path.style.fill =
          COLORS.one;

      } else {

        path.style.fill =
          COLORS.many;
      }


      path.addEventListener(
        "mouseenter",
        () => {

          hoverName.textContent =
            `${district} • ${peopleWord(count)}`;

        }
      );


      path.addEventListener(
        "mouseleave",
        () => {

          hoverName.textContent =
            currentDistrict
              ? `${currentDistrict} selected`
              : "Click a district to see people";

        }
      );


      path.addEventListener(
        "click",
        () => {

          selectDistrict(district);

        }
      );


      mapSvg.appendChild(path);


      /* DISTRICT LABEL */

      const coords =
        getAllCoordinates(
          feature.geometry
        );

      if (coords.length) {

        let lon = 0;
        let lat = 0;

        coords.forEach(
          ([x, y]) => {

            lon += x;
            lat += y;

          }
        );

        lon /= coords.length;
        lat /= coords.length;

        const p =
          project(lon, lat);

        const label =
          createSvgElement("text");

        label.setAttribute(
          "x",
          p.x
        );

        label.setAttribute(
          "y",
          p.y
        );

        label.setAttribute(
          "text-anchor",
          "middle"
        );

        label.classList.add(
          "district-label"
        );

        label.textContent =
          district;

        label.style.pointerEvents =
          "none";

        mapSvg.appendChild(label);


        /* PEOPLE DOT */

        if (count > 0) {

          const circle =
            createSvgElement("circle");

          circle.setAttribute(
            "cx",
            p.x
          );

          circle.setAttribute(
            "cy",
            p.y + 12
          );

          circle.setAttribute(
            "r",
            count > 1 ? "6" : "4"
          );

          circle.classList.add(
            "person-dot"
          );

          mapSvg.appendChild(circle);
        }
      }

    });


    mapTitle.textContent =
      "Tamil Nadu";

    mapHint.textContent =
      "Click any district to show people";

    backWorld.classList.remove(
      "hidden"
    );

    mapLoading.classList.add("hidden");
  }


  /* =========================================================
     OPEN TAMIL NADU
  ========================================================= */

  async function openTamilNadu() {

    currentCountry = "India";
    currentDistrict = "";

    selectedCountry.textContent =
      "India";

    selectedDistrict.textContent =
      "Tamil Nadu";

    if (!tamilNaduLoaded) {

      mapLoading.classList.remove(
        "hidden"
      );

      hoverName.textContent =
        "Loading Tamil Nadu districts...";

      try {

        const response =
          await fetch(TAMIL_NADU_URL);

        if (!response.ok) {
          throw new Error(
            "Tamil Nadu map failed"
          );
        }

        tamilNaduGeoJSON =
          await response.json();

        tamilNaduLoaded = true;

      } catch (error) {

        console.error(error);

        hoverName.textContent =
          "Tamil Nadu map could not be loaded";

        mapLoading.classList.add(
          "hidden"
        );

        return;
      }
    }

    renderTamilNaduMap();

    filterPeople();
  }


  /* =========================================================
     COUNTRY SELECT
  ========================================================= */

  function selectCountry(country) {

    currentCountry =
      country;

    currentDistrict = "";

    selectedCountry.textContent =
      country;

    selectedDistrict.textContent =
      "";

    filterPeople();

    renderWorldMap();

    hoverName.textContent =
      `${country} selected`;
  }


  /* =========================================================
     DISTRICT SELECT
  ========================================================= */

  function selectDistrict(district) {

    currentDistrict =
      district;

    currentCountry =
      "India";

    selectedCountry.textContent =
      "India";

    selectedDistrict.textContent =
      `• ${district}`;

    filterPeople();

    renderTamilNaduMap();

    hoverName.textContent =
      `${district} selected`;
  }


  /* =========================================================
     FILTER PEOPLE
  ========================================================= */

  function filterPeople() {

    const search =
      personSearch.value
        .trim()
        .toLowerCase();

    const city =
      citySelect.value;

    const rows =
      peopleList.querySelectorAll(
        ".person-row"
      );

    let visibleCount = 0;


    rows.forEach(row => {

      const rowCountry =
        row.dataset.country || "";

      const rowDistrict =
        row.dataset.district || "";

      const rowCity =
        row.dataset.city || "";

      const rowCategory =
        row.dataset.category || "";

      const rowSearch =
        row.dataset.search
          ?.toLowerCase() || "";


      const countryMatch =
        !currentCountry ||
        normalize(rowCountry) ===
        normalize(currentCountry);


      const districtMatch =
        !currentDistrict ||
        normalizeDistrict(rowDistrict) ===
        normalizeDistrict(currentDistrict);


      const searchMatch =
        !search ||
        rowSearch.includes(search);


      const cityMatch =
        !city ||
        rowCity === city;


      const categoryMatch =
        !currentCategory ||
        rowCategory === currentCategory;


      const visible =
        countryMatch &&
        districtMatch &&
        searchMatch &&
        cityMatch &&
        categoryMatch;


      row.classList.toggle(
        "hidden-row",
        !visible
      );


      if (visible) {
        visibleCount++;
      }

    });


    resultCount.textContent =
      visibleCount;


    emptyState.classList.toggle(
      "show",
      visibleCount === 0
    );
  }


  /* =========================================================
     PERSON DETAILS
  ========================================================= */

  function showPerson(id) {

    const person =
      people.find(
        p => String(p.id) === String(id)
      );

    if (!person) return;

    currentPersonId =
      String(id);


    detailAvatar.textContent =
      person.name.charAt(0);


    detailName.textContent =
      person.name;


    detailCategory.textContent =
      person.category;


    detailCompany.textContent =
      person.company;


    detailLocation.textContent =
      `${person.city}, ${person.district}, ${person.country}`;


    detailPhone.textContent =
      person.phone;


    detailEmail.textContent =
      person.email;


    detailDescription.textContent =
      person.description;


    callBtn.href =
      `tel:${person.phone.replace(/\s/g, "")}`;


    emailBtn.href =
      `mailto:${person.email}`;


    details.classList.remove(
      "hidden"
    );
  }


  /* =========================================================
     PERSON CLICK
  ========================================================= */

  document
    .querySelectorAll(".person-row")
    .forEach(row => {

      row.addEventListener(
        "click",
        () => {

          showPerson(
            row.dataset.id
          );

        }
      );

    });


  /* =========================================================
     CLOSE DETAILS
  ========================================================= */

  closeDetails.addEventListener(
    "click",
    () => {

      details.classList.add(
        "hidden"
      );

    }
  );


  /* =========================================================
     CATEGORY
  ========================================================= */

  chips.forEach(chip => {

    chip.addEventListener(
      "click",
      () => {

        chips.forEach(
          c =>
            c.classList.remove(
              "active"
            )
        );

        chip.classList.add(
          "active"
        );

        currentCategory =
          chip.dataset.category || "";

        filterPeople();

      }
    );

  });


  /* =========================================================
     SEARCH
  ========================================================= */

  personSearch.addEventListener(
    "input",
    filterPeople
  );


  /* =========================================================
     CITY
  ========================================================= */

  citySelect.addEventListener(
    "change",
    filterPeople
  );


  /* =========================================================
     BACK TO WORLD
  ========================================================= */

  backWorld.addEventListener(
    "click",
    () => {

      currentMode =
        "world";

      currentCountry = "";
      currentDistrict = "";

      selectedCountry.textContent =
        "All Countries";

      selectedDistrict.textContent =
        "";

      hoverName.textContent =
        "Click India to explore Tamil Nadu";

      renderWorldMap();

      filterPeople();

    }
  );


  /* =========================================================
     RESET
  ========================================================= */

  resetMap.addEventListener(
    "click",
    () => {

      currentMode =
        "world";

      currentCountry = "";
      currentDistrict = "";
      currentCategory = "";

      personSearch.value = "";
      citySelect.value = "";

      chips.forEach(
        chip =>
          chip.classList.remove(
            "active"
          )
      );

      document
        .querySelector(
          '.chip[data-category=""]'
        )
        ?.classList.add("active");


      selectedCountry.textContent =
        "All Countries";

      selectedDistrict.textContent =
        "";

      details.classList.add(
        "hidden"
      );

      hoverName.textContent =
        "Click India to explore Tamil Nadu";

      renderWorldMap();

      filterPeople();

    }
  );


  /* =========================================================
     LOAD WORLD
  ========================================================= */

  async function loadWorldMap() {

    mapLoading.classList.remove(
      "hidden"
    );

    try {

      const response =
        await fetch(WORLD_URL);

      if (!response.ok) {
        throw new Error(
          "World map failed"
        );
      }

      worldGeoJSON =
        await response.json();

      worldLoaded = true;

      renderWorldMap();

    } catch (error) {

      console.error(error);

      hoverName.textContent =
        "World map could not be loaded";

      mapLoading.innerHTML =
        `
          <div class="map-error">
            <strong>Map loading failed</strong>
            <span>Please refresh the page.</span>
          </div>
        `;

    }
  }


  /* =========================================================
     START
  ========================================================= */

  loadWorldMap();

  filterPeople();
</script>



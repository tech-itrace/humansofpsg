  const resultCount =
    document.getElementById(
      "resultCount"
    );


  const mapTitle =
    document.getElementById(
      "mapTitle"
    );


  const backButton =
    document.getElementById(
      "backButton"
    );


  const mapLoading =
    document.getElementById(
      "mapLoading"
    );


  const personDetails =
    document.getElementById(
      "personDetails"
    );


  const closeDetails =
    document.getElementById(
      "closeDetails"
    );


  const detailImage =
    document.getElementById(
      "detailImage"
    );


  const detailInitial =
    document.getElementById(
      "detailInitial"
    );


  const detailName =
    document.getElementById(
      "detailName"
    );


  const detailQuote =
    document.getElementById(
      "detailQuote"
    );


  const detailCity =
    document.getElementById(
      "detailCity"
    );


  const detailState =
    document.getElementById(
      "detailState"
    );


  const detailCountry =
    document.getElementById(
      "detailCountry"
    );


  const detailDepartment =
    document.getElementById(
      "detailDepartment"
    );


  const detailExpertise =
    document.getElementById(
      "detailExpertise"
    );


  const detailEmail =
    document.getElementById(
      "detailEmail"
    );


  const detailAddress =
    document.getElementById(
      "detailAddress"
    );


  const worldView =
    document.getElementById(
      "worldView"
    );


  const indiaView =
    document.getElementById(
      "indiaView"
    );


  const tamilNaduView =
    document.getElementById(
      "tamilNaduView"
    );


  let mode = "world";

  let selectedState = "";

  let selectedDistrict = "";

  let visiblePeople = [...people];


  /* ========================================================
     NORMALIZE
  ======================================================== */

  function normalize(value) {

    return String(value || "")
      .trim()
      .toLowerCase();

  }


  /* ========================================================
     FILTER
  ======================================================== */

  function getFilteredPeople() {

    const search =
      normalize(
        searchInput.value
      );


    const city =
      normalize(
        citySelect.value
      );


    const department =
      normalize(
        departmentSelect.value
      );


    const expertise =
      normalize(
        expertiseSelect.value
      );


    return people.filter(
      person => {

        const searchable = [
          person.name,
          person.city,
          person.state,
          person.country,
          person.district,
          person.department,
          person.expertise,
          person.pullQuote,
          person.email,
          person.address
        ]
          .join(" ")
          .toLowerCase();


        const matchesSearch =
          !search ||
          searchable.includes(search);


        const matchesCity =
          !city ||
          normalize(
            person.city
          ) === city;


        const matchesDepartment =
          !department ||
          normalize(
            person.department
          ) === department;


        const matchesExpertise =
          !expertise ||
          normalize(
            person.expertise
          ) === expertise;


        const matchesState =
          !selectedState ||
          normalize(
            person.state
          ) === normalize(
            selectedState
          );


        const matchesDistrict =
          !selectedDistrict ||
          normalize(
            person.district
          ) === normalize(
            selectedDistrict
          );


        return (
          matchesSearch &&
          matchesCity &&
          matchesDepartment &&
          matchesExpertise &&
          matchesState &&
          matchesDistrict
        );

      }
    );

  }


  /* ========================================================
     RENDER PEOPLE
  ======================================================== */

  function renderPeople() {

    visiblePeople =
      getFilteredPeople();


    resultCount.textContent =
      visiblePeople.length;


    peopleList.innerHTML = "";


    if (!visiblePeople.length) {

      peopleList.innerHTML = `
        <div class="empty-results">
          <strong>No PSGians found</strong>
          <span>Try changing your filters.</span>
        </div>
      `;

      return;

    }


    visiblePeople.forEach(
      person => {

        const card =
          document.createElement(
            "button"
          );


        card.type = "button";

        card.className =
          "person-card";


        const initials =
          person.name
            .split(" ")
            .map(
              word =>
                word[0]
            )
            .join("")
            .slice(0, 2)
            .toUpperCase();


        const imageHTML =
          person.image
            ? `
              <img
                src="${person.image}"
                alt="${person.name}"
                loading="lazy"
              />
            `
            : `
              <span class="person-initial">
                ${initials}
              </span>
            `;


        card.innerHTML = `

          <span class="person-card-accent"></span>

          <span class="person-card-avatar">
            ${imageHTML}
          </span>

          <span class="person-card-info">
            <strong>${person.name}</strong>
            <span class="person-location">${person.city}, ${person.state}</span>
            <small class="person-department">${person.department}</small>
          </span>

          <span class="person-arrow" aria-hidden="true">
            <span class="arrow-line"></span>
          </span>

        `;


        card.addEventListener(
          "click",
          () => {

            showPerson(person);

          }
        );


        peopleList.appendChild(
          card
        );

      }
    );

  }


  /* ========================================================
     SHOW PERSON
  ======================================================== */

  function showPerson(person) {

    const initials =
      person.name
        .split(" ")
        .map(
          word =>
            word[0]
        )
        .join("")
        .slice(0, 2)
        .toUpperCase();


    detailName.textContent =
      person.name;


    detailQuote.textContent =
      person.pullQuote ||
      "";


    detailCity.textContent =
      person.city ||
      "-";


    detailState.textContent =
      person.state ||
      "-";


    detailCountry.textContent =
      person.country ||
      "-";


    detailDepartment.textContent =
      person.department ||
      "-";


    detailExpertise.textContent =
      person.expertise ||
      "-";


    detailEmail.textContent =
      person.email ||
      "-";


    detailAddress.textContent =
      person.address ||
      "-";


    detailInitial.textContent =
      initials;


    if (person.image) {

      detailImage.src =
        person.image;

      detailImage.alt =
        person.name;

      detailImage.classList.add(
        "visible"
      );

      detailInitial.classList.add(
        "hidden"
      );

    } else {

      detailImage.removeAttribute(
        "src"
      );

      detailImage.classList.remove(
        "visible"
      );

      detailInitial.classList.remove(
        "hidden"
      );

    }


    personDetails.classList.remove(
      "hidden"
    );

  }


  /* ========================================================
     MAP VIEW
  ======================================================== */

  function setMapView(view) {

    worldView.classList.remove(
      "active"
    );

    indiaView.classList.remove(
      "active"
    );

    tamilNaduView.classList.remove(
      "active"
    );


    view.classList.add(
      "active"
    );

  }


  /* ========================================================
     WORLD
  ======================================================== */

  function openWorld() {

    mode = "world";

    selectedState = "";

    selectedDistrict = "";


    mapTitle.textContent =
      "World";


    setMapView(
      worldView
    );


    backButton.classList.add(
      "hidden"
    );


    renderPeople();

  }


  /* ========================================================
     INDIA
  ======================================================== */

  function openIndia() {

    mode = "india";

    selectedState = "";

    selectedDistrict = "";


    mapTitle.textContent =
      "India";


    setMapView(
      indiaView
    );


    backButton.classList.remove(
      "hidden"
    );


    renderPeople();

  }


  /* ========================================================
     TAMIL NADU
  ======================================================== */

  function openTamilNadu() {

    mode = "tamilNadu";

    selectedState =
      "Tamil Nadu";

    selectedDistrict = "";


    mapTitle.textContent =
      "Tamil Nadu";


    setMapView(
      tamilNaduView
    );


    backButton.classList.remove(
      "hidden"
    );


    renderPeople();

  }


  /* ========================================================
     CITY
  ======================================================== */

  function openCity(city) {

    const matches =
      people.filter(
        person =>
          normalize(
            person.city
          ) ===
          normalize(city)
      );


    if (!matches.length) {
      return;
    }


    selectedState =
      "Tamil Nadu";


    selectedDistrict =
      matches[0].district ||
      "";


    citySelect.value =
      matches[0].city;


    mapTitle.textContent =
      matches[0].city;


    renderPeople();


    showPerson(
      matches[0]
    );

  }


  /* ========================================================
     INDIA MARKER
  ======================================================== */

  document
    .getElementById(
      "indiaWorldMarker"
    )
    ?.addEventListener(
      "click",
      event => {

        event.stopPropagation();

        openIndia();

      }
    );


  /* ========================================================
     TAMIL NADU MARKER
  ======================================================== */

  document
    .getElementById(
      "tamilNaduMarker"
    )
    ?.addEventListener(
      "click",
      event => {

        event.stopPropagation();

        openTamilNadu();

      }
    );


  /* ========================================================
     CITY MARKERS
  ======================================================== */

  document
    .querySelectorAll(
      ".city-marker"
    )
    .forEach(
      marker => {

        marker.addEventListener(
          "click",
          event => {

            event.stopPropagation();


            const city =
              marker.dataset.city;


            openCity(city);

          }
        );

      }
    );


  /* ========================================================
     BACK
  ======================================================== */

  backButton.addEventListener(
    "click",
    () => {

      if (
        mode ===
        "tamilNadu"
      ) {

        openIndia();

        return;

      }


      if (
        mode ===
        "india"
      ) {

        openWorld();

      }

    }
  );


  /* ========================================================
     CLOSE DETAILS
  ======================================================== */

  closeDetails.addEventListener(
    "click",
    () => {

      personDetails.classList.add(
        "hidden"
      );

    }
  );


  /* ========================================================
     RESET
  ======================================================== */

  resetButton.addEventListener(
    "click",
    () => {

      searchInput.value =
        "";

      citySelect.value =
        "";

      departmentSelect.value =
        "";

      expertiseSelect.value =
        "";


      selectedState =
        "";

      selectedDistrict =
        "";


      personDetails.classList.add(
        "hidden"
      );


      openWorld();

    }
  );


  /* ========================================================
     FILTER EVENTS
  ======================================================== */

  searchInput.addEventListener(
    "input",
    renderPeople
  );


  citySelect.addEventListener(
    "change",
    () => {

      if (
        citySelect.value
      ) {

        openCity(
          citySelect.value
        );

      } else {

        renderPeople();

      }

    }
  );


  departmentSelect.addEventListener(
    "change",
    renderPeople
  );


  expertiseSelect.addEventListener(
    "change",
    renderPeople
  );


  /* ========================================================
     LOADING
  ======================================================== */

  window.addEventListener(
    "load",
    () => {

      setTimeout(
        () => {

          mapLoading.classList.add(
            "hidden"
          );

        },
        450
      );

    }
  );


  /* ========================================================
     INITIAL
  ======================================================== */

  renderPeople();

</script>



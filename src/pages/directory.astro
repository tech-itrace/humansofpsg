---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700&family=Outfit:wght@500;600;700&display=swap"
/>

<div class="tnd">

  <!-- ================= LEFT RAIL ================= -->
  <aside class="tnd-side">

    <header class="tnd-head">
      <h1 class="tnd-title">Tamil Nadu Directory</h1>
      <p class="tnd-stats">
        <span><b>38</b> districts</span>
        <span><b>{people.length}</b> people</span>
      </p>
    </header>

    <div class="tnd-controls">
      <label class="tnd-search">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
          <path d="M20 20l-3.5-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <input id="personSearch" type="search" placeholder="Search name, city or work" aria-label="Search people" />
      </label>

      <select id="citySelect" class="tnd-select" aria-label="Filter by city">
        <option value="">All cities</option>
        {cities.map((city) => <option value={city}>{city}</option>)}
      </select>

      <div class="tnd-chips" id="chips" role="group" aria-label="Filter by profession">
        <button type="button" class="tnd-chip is-on" data-category="">All</button>
        {categories.map((c) => <button type="button" class="tnd-chip" data-category={c}>{c}</button>)}
      </div>
    </div>

    <div class="tnd-listhead">
      <h2 id="selectedDistrict">All Tamil Nadu</h2>
      <p><span id="resultCount">{people.length}</span> people found</p>
    </div>

    <div id="peopleList" class="tnd-list">
      {
        people.map((person) => (
          <button
            type="button"
            class="tnd-row"
            data-id={person.id}
            data-name={person.name}
            data-district={person.district}
            data-city={person.city}
            data-category={person.category}
            data-search={[person.name, person.district, person.city, person.category, person.company, person.phone, person.email, person.description].join(" ").toLowerCase()}
          >
            <span class="tnd-avatar">{person.name.charAt(0)}</span>
            <span class="tnd-rowinfo">
              <strong>{person.name}</strong>
              <span class="tnd-tag">{person.category}</span>
              <span class="tnd-desc">{person.description}</span>
              <span class="tnd-facts">
                <span><i>Company</i>{person.company}</span>
                <span><i>City</i>{person.city}</span>
                <span><i>District</i>{person.district}</span>
                <span><i>Phone</i>{person.phone}</span>
                <span class="tnd-wide"><i>Email</i>{person.email}</span>
              </span>
            </span>
          </button>
        ))
      }

      <div id="emptyState" class="tnd-empty tnd-hidden">
        <strong>No one matches</strong>
        <p>Try another district, clear the search, or choose “All”.</p>
      </div>
    </div>

  </aside>

  <!-- ================= MAP STAGE ================= -->
  <main class="tnd-stage">

    <div class="tnd-topbar">
      <div class="tnd-pill" id="hoverName">Hover a district</div>
      <button id="resetMap" type="button" class="tnd-reset">Show all Tamil Nadu</button>
    </div>

    <div id="map" class="tnd-map">
      <div id="mapLoading" class="tnd-loading">Loading Tamil Nadu map…</div>
    </div>

    <div class="tnd-legend">
      <span class="tnd-swatch s0"></span>None
      <span class="tnd-swatch s1"></span>1 person
      <span class="tnd-swatch s2"></span>2 or more
      <span id="mapHint" class="tnd-hint">Click a district to filter the list</span>
    </div>

    <!-- Details card floats over the map -->
    <section id="personDetails" class="tnd-card tnd-hidden" aria-label="Person details">

      <button id="closeDetails" class="tnd-close" type="button" aria-label="Close details">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" />
        </svg>
      </button>

      <div class="tnd-card-top">
        <div id="detailAvatar" class="tnd-detail-avatar">A</div>
        <div>
          <h3 id="detailName">Person</h3>
          <span id="detailCategory" class="tnd-detail-tag">Category</span>
        </div>
      </div>

      <p id="detailDescription" class="tnd-detail-about"></p>

      <dl class="tnd-detail-list">
        <div><dt>District</dt><dd id="detailDistrict"></dd></div>
        <div><dt>City</dt><dd id="detailCity"></dd></div>
        <div><dt>Company</dt><dd id="detailCompany"></dd></div>
        <div><dt>Phone</dt><dd id="detailPhone"></dd></div>
        <div><dt>Email</dt><dd id="detailEmail"></dd></div>
      </dl>

      <div class="tnd-actions">
        <a id="detailCall" class="tnd-btn tnd-btn-main" href="#">Call</a>
        <a id="detailMail" class="tnd-btn" href="#">Email</a>
      </div>

    </section>

  </main>

</div>


<script define:vars={{ people }}>

  /* ---------- ELEMENTS ---------- */

  const map = document.getElementById("map");
  const mapLoading = document.getElementById("mapLoading");
  const hoverName = document.getElementById("hoverName");
  const selectedDistrict = document.getElementById("selectedDistrict");
  const peopleList = document.getElementById("peopleList");
  const resultCount = document.getElementById("resultCount");
  const emptyState = document.getElementById("emptyState");
  const searchInput = document.getElementById("personSearch");
  const citySelect = document.getElementById("citySelect");
  const resetButton = document.getElementById("resetMap");
  const chips = document.getElementById("chips");

  const card = document.getElementById("personDetails");
  const closeButton = document.getElementById("closeDetails");

  const detailAvatar = document.getElementById("detailAvatar");
  const detailName = document.getElementById("detailName");
  const detailCategory = document.getElementById("detailCategory");
  const detailDistrict = document.getElementById("detailDistrict");
  const detailCity = document.getElementById("detailCity");
  const detailCompany = document.getElementById("detailCompany");
  const detailPhone = document.getElementById("detailPhone");
  const detailEmail = document.getElementById("detailEmail");
  const detailDescription = document.getElementById("detailDescription");
  const detailCall = document.getElementById("detailCall");
  const detailMail = document.getElementById("detailMail");

  /* ---------- MAP COLOURS (inline, so no stylesheet can break the map) ---------- */

  const C = {
    none: "#e7efe9",
    one: "#a9d9bf",
    many: "#5cb88a",
    hover: "#f8c766",
    active: "#f59e0b",
    stroke: "#ffffff",
    dot: "#0f4c3a"
  };

  /* ---------- STATE ---------- */

  let geojson = null;
  let currentDistrict = "";
  let currentCategory = "";
  let currentPersonId = "";

  /* ---------- HELPERS ---------- */

  function normalizeDistrict(value) {
    if (!value) return "";

    let name = String(value).toLowerCase().trim();
    name = name.replace(/\bdistrict\b/g, "").trim();

    const aliases = {
      "trichy": "tiruchirappalli",
      "tiruchirapalli": "tiruchirappalli",
      "tiruchirappalli": "tiruchirappalli",
      "thiruvallur": "tiruvallur",
      "tiruvallur": "tiruvallur",
      "kanchipuram": "kancheepuram",
      "kancheepuram": "kancheepuram",
      "nilgiris": "nilgiris",
      "the nilgiris": "nilgiris",
      "kanniyakumari": "kanyakumari",
      "kanyakumari": "kanyakumari",
      "sivagangai": "sivaganga",
      "sivaganga": "sivaganga",
      "villupuram": "viluppuram",
      "viluppuram": "viluppuram",
      "thoothukudi": "thoothukudi"
    };

    return aliases[name] || name;
  }

  function getDistrictName(feature) {
    const p = feature.properties || {};

    return (
      p.district_name || p.DISTRICT || p.District || p.district ||
      p.DTNAME || p.dtname || p.DIST_NAME || p.NAME_2 ||
      p.NAME || p.name || p.REGNAME || ""
    );
  }

  function walkCoordinates(coordinates, callback) {
    if (typeof coordinates[0] === "number") {
      callback(coordinates);
      return;
    }
    coordinates.forEach((item) => walkCoordinates(item, callback));
  }

  function getBounds(features) {
    let minLon = Infinity, minLat = Infinity, maxLon = -Infinity, maxLat = -Infinity;

    features.forEach((feature) => {
      walkCoordinates(feature.geometry.coordinates, (c) => {
        minLon = Math.min(minLon, c[0]);
        maxLon = Math.max(maxLon, c[0]);
        minLat = Math.min(minLat, c[1]);
        maxLat = Math.max(maxLat, c[1]);
      });
    });

    return { minLon, minLat, maxLon, maxLat };
  }

  const districtCounts = {};
  people.forEach((p) => {
    const key = normalizeDistrict(p.district);
    districtCounts[key] = (districtCounts[key] || 0) + 1;
  });

  function peopleWord(n) {
    return n === 1 ? "1 person" : `${n} people`;
  }

  function setHoverText(text) {
    hoverName.textContent = text || "Hover a district";
    hoverName.classList.toggle("is-idle", !text);
  }

  /* ---------- RENDER MAP ---------- */

  function renderMap() {
    if (!geojson) return;

    map.innerHTML = "";

    const svgNS = "http://www.w3.org/2000/svg";
    const svg = document.createElementNS(svgNS, "svg");

    const bounds = getBounds(geojson.features);
    const lonWidth = bounds.maxLon - bounds.minLon;
    const latHeight = bounds.maxLat - bounds.minLat;

    const pad = 20;
    const scale = 900 / Math.max(lonWidth, latHeight);

    const W = lonWidth * scale + pad * 2;
    const H = latHeight * scale + pad * 2;

    svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
    svg.setAttribute("preserveAspectRatio", "xMidYMid meet");
    svg.style.width = "100%";
    svg.style.height = "100%";
    svg.style.display = "block";

    function project(coordinate) {
      return [
        pad + (coordinate[0] - bounds.minLon) * scale,
        pad + (bounds.maxLat - coordinate[1]) * scale
      ];
    }

    function ringToPath(ring) {
      let d = "";
      ring.forEach((coordinate, index) => {
        const [x, y] = project(coordinate);
        d += index === 0 ? `M ${x.toFixed(1)} ${y.toFixed(1)}` : ` L ${x.toFixed(1)} ${y.toFixed(1)}`;
      });
      return d + " Z";
    }

    function geometryToPath(geometry) {
      if (geometry.type === "Polygon") {
        return geometry.coordinates.map(ringToPath).join(" ");
      }
      if (geometry.type === "MultiPolygon") {
        return geometry.coordinates
          .map((polygon) => polygon.map(ringToPath).join(" "))
          .join(" ");
      }
      return "";
    }

    const dots = [];

    geojson.features.forEach((feature) => {
      const rawName = getDistrictName(feature);
      const district = normalizeDistrict(rawName);
      const count = districtCounts[district] || 0;

      const isSelected =
        currentDistrict && district === normalizeDistrict(currentDistrict);

      const baseFill = isSelected
        ? C.active
        : count >= 2 ? C.many : count === 1 ? C.one : C.none;

      const path = document.createElementNS(svgNS, "path");
      path.setAttribute("d", geometryToPath(feature.geometry));
      path.setAttribute("fill", baseFill);
      path.setAttribute("stroke", C.stroke);
      path.setAttribute("stroke-width", "1.4");
      path.setAttribute("stroke-linejoin", "round");
      path.style.cursor = "pointer";

      path.addEventListener("mouseenter", () => {
        if (!isSelected) path.setAttribute("fill", C.hover);
        setHoverText(`${rawName}: ${count ? peopleWord(count) : "no one yet"}`);
      });

      path.addEventListener("mouseleave", () => {
        path.setAttribute("fill", baseFill);
        setHoverText(currentDistrict);
      });

      path.addEventListener("click", (event) => {
        event.stopPropagation();
        selectDistrict(rawName);
      });

      svg.appendChild(path);

      /* Small dot so tiny districts (like Chennai) are still easy to spot */
      if (count) {
        const b = getBounds([feature]);
        const [cx, cy] = project([(b.minLon + b.maxLon) / 2, (b.minLat + b.maxLat) / 2]);
        dots.push([cx, cy]);
      }
    });

    dots.forEach(([cx, cy]) => {
      const dot = document.createElementNS(svgNS, "circle");
      dot.setAttribute("cx", cx);
      dot.setAttribute("cy", cy);
      dot.setAttribute("r", "5");
      dot.setAttribute("fill", C.dot);
      dot.setAttribute("stroke", "#ffffff");
      dot.setAttribute("stroke-width", "2");
      dot.style.pointerEvents = "none";
      svg.appendChild(dot);
    });

    map.appendChild(svg);
  }

  /* ---------- SELECT DISTRICT ---------- */

  function selectDistrict(district) {
    currentDistrict = district;
    selectedDistrict.textContent = district;
    document.getElementById("mapHint").textContent = `${district} selected`;
    setHoverText(district);

    renderMap();
    filterPeople();
  }

  /* ---------- FILTER PEOPLE ---------- */

  function filterPeople() {
    const search = searchInput.value.toLowerCase().trim();
    const city = citySelect.value.toLowerCase().trim();
    const category = currentCategory.toLowerCase();

    let visible = 0;

    peopleList.querySelectorAll(".tnd-row").forEach((row) => {
      const name = row.dataset.name.toLowerCase();
      const district = row.dataset.district.toLowerCase();
      const rowCity = row.dataset.city.toLowerCase();
      const rowCategory = row.dataset.category.toLowerCase();

      const districtMatch =
        !currentDistrict ||
        normalizeDistrict(row.dataset.district) === normalizeDistrict(currentDistrict);

      const searchMatch =
        !search ||
        row.dataset.search.includes(search) ||
        name.includes(search) ||
        district.includes(search);

      const cityMatch = !city || rowCity === city;
      const categoryMatch = !category || rowCategory === category;

      const show = districtMatch && searchMatch && cityMatch && categoryMatch;

      row.style.display = show ? "flex" : "none";
      if (show) visible++;
    });

    resultCount.textContent = visible;
    emptyState.classList.toggle("tnd-hidden", visible > 0);
  }

  /* ---------- DETAILS CARD ---------- */

  function showPerson(id) {
    const person = people.find((item) => String(item.id) === String(id));
    if (!person) return;

    currentPersonId = String(id);

    detailAvatar.textContent = person.name.charAt(0);
    detailName.textContent = person.name;
    detailCategory.textContent = person.category;
    detailDistrict.textContent = person.district;
    detailCity.textContent = person.city;
    detailCompany.textContent = person.company;
    detailPhone.textContent = person.phone;
    detailEmail.textContent = person.email;
    detailDescription.textContent = person.description;

    detailCall.href = "tel:" + person.phone.replace(/\s+/g, "");
    detailMail.href = "mailto:" + person.email;

    peopleList.querySelectorAll(".tnd-row").forEach((row) => {
      row.classList.toggle("is-on", row.dataset.id === currentPersonId);
    });

    card.classList.remove("tnd-hidden");
  }

  function closeDetails() {
    card.classList.add("tnd-hidden");
    currentPersonId = "";
    peopleList.querySelectorAll(".tnd-row").forEach((row) => row.classList.remove("is-on"));
  }

  /* ---------- EVENTS ---------- */

  peopleList.querySelectorAll(".tnd-row").forEach((row) => {
    row.addEventListener("click", () => showPerson(row.dataset.id));
  });

  closeButton.addEventListener("click", closeDetails);

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeDetails();
  });

  chips.querySelectorAll(".tnd-chip").forEach((chip) => {
    chip.addEventListener("click", () => {
      currentCategory = chip.dataset.category;
      chips.querySelectorAll(".tnd-chip").forEach((c) => c.classList.toggle("is-on", c === chip));
      filterPeople();
    });
  });

  searchInput.addEventListener("input", filterPeople);
  citySelect.addEventListener("change", filterPeople);

  resetButton.addEventListener("click", () => {
    currentDistrict = "";
    currentCategory = "";
    selectedDistrict.textContent = "All Tamil Nadu";
    document.getElementById("mapHint").textContent = "Click a district to filter the list";
    setHoverText("");

    searchInput.value = "";
    citySelect.value = "";
    chips.querySelectorAll(".tnd-chip").forEach((c) => c.classList.toggle("is-on", c.dataset.category === ""));

    closeDetails();
    filterPeople();
    renderMap();
  });

  /* ---------- LOAD GEOJSON ---------- */

  async function loadMap() {
    try {
      const url =
        "https://cdn.jsdelivr.net/gh/udit-001/india-maps-data@2884453/geojson/states/tamil-nadu.geojson";

      const response = await fetch(url);
      if (!response.ok) throw new Error(`HTTP ${response.status}`);

      geojson = await response.json();

      if (!geojson.features || !geojson.features.length) {
        throw new Error("No district features found.");
      }

      mapLoading?.remove();
      renderMap();
    } catch (error) {
      console.error("Tamil Nadu map error:", error);

      if (mapLoading) {
        mapLoading.innerHTML =
          "<div><strong>Map could not load</strong><br /><small>Check your internet connection and refresh. Details are in the browser console (F12).</small></div>";
      }
    }
  }

  /* ---------- START ---------- */

  setHoverText("");
  filterPeople();
  loadMap();

</script>


<!--
  is:inline = Astro leaves this stylesheet exactly as written (no scoping, no
  bundling). Every class starts with "tnd-", so no older CSS can clash with it.
-->
<style is:inline>

  .tnd {
    --ink: #10231d;
    --soft: #5b6f66;
    --line: #dfe8e2;
    --paper: #ffffff;
    --forest: #0f4c3a;
    --mint: #e3f3ea;
    --sea: #e2eff5;
    --saffron: #f59e0b;

    --display: "Outfit", system-ui, sans-serif;
    --body: "Nunito Sans", system-ui, -apple-system, "Segoe UI", sans-serif;

    display: grid;
    grid-template-columns: 420px 1fr;
    width: 100%;
    height: 100vh;
    min-height: 640px;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--body);
    font-size: 15px;
    line-height: 1.5;
  }

  .tnd *,
  .tnd *::before,
  .tnd *::after {
    box-sizing: border-box;
  }

  .tnd button,
  .tnd input,
  .tnd select,
  .tnd a {
    font-family: inherit;
    font-size: inherit;
  }

  .tnd :focus-visible {
    outline: 3px solid var(--saffron);
    outline-offset: 2px;
  }

  .tnd .tnd-hidden {
    display: none !important;
  }

  /* ---------- Left rail ---------- */

  .tnd .tnd-side {
    display: flex;
    flex-direction: column;
    min-height: 0;
    border-right: 1px solid var(--line);
    background: var(--paper);
  }

  .tnd .tnd-head {
    padding: 26px 24px 4px;
  }

  .tnd .tnd-title {
    margin: 0;
    font-family: var(--display);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--forest);
  }

  .tnd .tnd-stats {
    display: flex;

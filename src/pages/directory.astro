</style>


<script define:vars={{ people }}>

  /*
   * ==========================================================
   * WORLD DIRECTORY - 3D GLOBE
   * ==========================================================
   *
   * Globe engine:
   * globe.gl 2.45.0
   *
   * Flow:
   *
   * WORLD
   *   ↓
   * Click India
   *   ↓
   * SAME 3D GLOBE zooms into India
   *   ↓
   * Tamil Nadu district boundaries appear
   *   ↓
   * Click district
   *   ↓
   * People list filters
   *
   * No separate Tamil Nadu screen.
   * ==========================================================
   */


  const WORLD_URL =
    "https://raw.githubusercontent.com/datasets/geo-countries/master/data/countries.geojson";

  const TAMIL_NADU_URL =
    "https://cdn.jsdelivr.net/gh/udit-001/india-maps-data@2884453/geojson/states/tamil-nadu.geojson";


  const GLOBE_TEXTURE =
    "https://unpkg.com/three-globe/example/img/earth-blue-marble.jpg";

  const GLOBE_BUMP =
    "https://unpkg.com/three-globe/example/img/earth-topology.png";

  const STAR_BACKGROUND =
    "https://unpkg.com/three-globe/example/img/night-sky.png";


  const globeContainer =
    document.getElementById("globeContainer");

  const mapLoading =
    document.getElementById("mapLoading");

  const personSearch =
    document.getElementById("personSearch");

  const citySelect =
    document.getElementById("citySelect");

  const chips =
    document.getElementById("chips");

  const peopleList =
    document.getElementById("peopleList");

  const emptyState =
    document.getElementById("emptyState");

  const resultCount =
    document.getElementById("resultCount");

  const selectedCountry =
    document.getElementById("selectedCountry");

  const selectedDistrict =
    document.getElementById("selectedDistrict");

  const mapTitle =
    document.getElementById("mapTitle");

  const hoverName =
    document.getElementById("hoverName");

  const mapHint =
    document.getElementById("mapHint");

  const backWorld =
    document.getElementById("backWorld");

  const resetMap =
    document.getElementById("resetMap");

  const personDetails =
    document.getElementById("personDetails");

  const closeDetails =
    document.getElementById("closeDetails");


  let Globe;

  let globe = null;

  let worldFeatures = [];

  let tamilNaduFeatures = [];

  let districtPoints = [];

  let countryPoints = [];

  let currentMode = "world";

  let currentCountry = "";

  let currentDistrict = "";

  let currentCategory = "";

  let currentSearch = "";

  let currentCity = "";

  let selectedPerson = null;

  let hoveredFeature = null;


  /*
   * ==========================================================
   * HELPERS
   * ==========================================================
   */

  function escapeHtml(value) {

    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");

  }


  function normalize(value) {

    return String(value ?? "")
      .toLowerCase()
      .replace(/district/gi, "")
      .replace(/districts/gi, "")
      .replace(/[^a-z0-9]/g, "");

  }


  function getCountryName(feature) {

    const p = feature?.properties || {};

    return (
      p.ADMIN ||
      p.NAME_EN ||
      p.name ||
      p.NAME ||
      p.Country ||
      p.country ||
      ""
    );

  }


  function getDistrictName(feature) {

    const p = feature?.properties || {};

    return (
      p.district ||
      p.DISTRICT ||
      p.District ||
      p.NAME_2 ||
      p.NAME ||
      p.name ||
      p.ST_NM ||
      "Tamil Nadu"
    );

  }


  function isIndia(feature) {

    return normalize(getCountryName(feature)) === "india";

  }


  function featureCoordinates(feature) {

    const geometry = feature?.geometry;

    if (!geometry) return [];

    const output = [];

    function collect(coords) {

      if (!Array.isArray(coords)) return;

      if (
        coords.length >= 2 &&
        typeof coords[0] === "number" &&
        typeof coords[1] === "number"
      ) {

        output.push({
          lng: coords[0],
          lat: coords[1]
        });

        return;
      }

      coords.forEach(collect);

    }

    collect(geometry.coordinates);

    return output;

  }


  function featureCentroid(feature) {

    const coords = featureCoordinates(feature);

    if (!coords.length) {
      return {
        lat: 11,
        lng: 78
      };
    }

    let lat = 0;
    let lng = 0;

    coords.forEach((point) => {

      lat += point.lat;
      lng += point.lng;

    });

    return {
      lat: lat / coords.length,
      lng: lng / coords.length
    };

  }


  function getVisibleBasePeople() {

    const search = currentSearch.trim().toLowerCase();

    return people.filter((person) => {

      const matchesSearch =
        !search ||
        [
          person.name,
          person.city,
          person.district,
          person.category,
          person.company,
          person.description
        ]
          .join(" ")
          .toLowerCase()
          .includes(search);

      const matchesCity =
        !currentCity ||
        person.city === currentCity;

      const matchesCategory =
        !currentCategory ||
        person.category === currentCategory;

      return (
        matchesSearch &&
        matchesCity &&
        matchesCategory
      );

    });

  }


  function getFilteredPeople() {

    return getVisibleBasePeople().filter((person) => {

      const matchesCountry =
        !currentCountry ||
        person.country === currentCountry;

      const matchesDistrict =
        !currentDistrict ||
        person.district === currentDistrict;

      return (
        matchesCountry &&
        matchesDistrict
      );

    });

  }


  function countDistrictPeople(district) {

    return getVisibleBasePeople()
      .filter(
        (person) =>
          normalize(person.district) ===
          normalize(district)
      )
      .length;

  }


  function countCountryPeople(country) {

    return getVisibleBasePeople()
      .filter(
        (person) =>
          normalize(person.country) ===
          normalize(country)
      )
      .length;

  }


  /*
   * ==========================================================
   * PEOPLE LIST
   * ==========================================================
   */

  function renderPeople() {

    const filtered = getFilteredPeople();

    resultCount.textContent = String(filtered.length);

    if (currentDistrict) {

      selectedCountry.textContent =
        currentCountry || "India";

      selectedDistrict.textContent =
        currentDistrict;

    } else if (currentCountry) {

      selectedCountry.textContent =
        currentCountry;

      selectedDistrict.textContent =
        "All People";

    } else {

      selectedCountry.textContent =
        "All Countries";

      selectedDistrict.textContent =
        "All People";

    }


    peopleList.innerHTML = "";


    if (!filtered.length) {

      peopleList.style.display = "none";
      emptyState.style.display = "block";

      return;

    }


    peopleList.style.display = "block";
    emptyState.style.display = "none";


    filtered.forEach((person) => {

      const row =
        document.createElement("button");

      row.type = "button";

      row.className = "person-row";

      row.innerHTML = `
        <div class="person-mini-avatar">
          ${escapeHtml(person.name.charAt(0).toUpperCase())}
        </div>

        <div class="person-row-info">

          <div class="person-row-name">
            ${escapeHtml(person.name)}
          </div>

          <div class="person-row-meta">
            ${escapeHtml(person.category)}
            •
            ${escapeHtml(person.city)}
          </div>

        </div>

        <div class="person-row-arrow">
          ›
        </div>
      `;


      row.addEventListener(
        "click",
        () => openPerson(person)
      );


      peopleList.appendChild(row);

    });

  }


  /*
   * ==========================================================
   * PERSON DETAILS
   * ==========================================================
   */

  function openPerson(person) {

    selectedPerson = person;

    document.getElementById("detailAvatar")
      .textContent =
      person.name.charAt(0).toUpperCase();

    document.getElementById("detailName")
      .textContent =
      person.name;

    document.getElementById("detailCategory")
      .textContent =
      person.category;

    document.getElementById("detailCompany")
      .textContent =
      person.company;

    document.getElementById("detailLocation")
      .textContent =
      `${person.city}, ${person.district}, ${person.country}`;

    document.getElementById("detailPhone")
      .textContent =
      person.phone;

    document.getElementById("detailPhone")
      .href =
      `tel:${person.phone.replace(/\s+/g, "")}`;

    document.getElementById("detailEmail")
      .textContent =
      person.email;

    document.getElementById("detailEmail")
      .href =
      `mailto:${person.email}`;

    document.getElementById("detailDescription")
      .textContent =
      person.description;

    document.getElementById("callButton")
      .href =
      `tel:${person.phone.replace(/\s+/g, "")}`;

    document.getElementById("emailButton")
      .href =
      `mailto:${person.email}`;


    personDetails.classList.remove("hidden");


    /*
     * If the person is in Tamil Nadu,
     * automatically open the same globe in India mode.
     */

    if (
      person.country === "India" &&
      tamilNaduFeatures.length
    ) {

      if (currentMode !== "india") {
        enterIndiaMode(false);
      }

      const feature =
        tamilNaduFeatures.find(
          (f) =>
            normalize(getDistrictName(f)) ===
            normalize(person.district)
        );

      if (feature) {

        const center =
          featureCentroid(feature);

        globe.pointOfView(
          {
            lat: center.lat,
            lng: center.lng,
            altitude: 0.85
          },
          900
        );

      }

    }

  }


  closeDetails.addEventListener(
    "click",
    () => {

      personDetails.classList.add("hidden");
      selectedPerson = null;

    }
  );


  /*
   * ==========================================================
   * FILTER EVENTS
   * ==========================================================
   */

  personSearch.addEventListener(
    "input",
    () => {

      currentSearch =
        personSearch.value;

      renderPeople();
      refreshGlobeMarkers();

    }
  );


  citySelect.addEventListener(
    "change",
    () => {

      currentCity =
        citySelect.value;

      renderPeople();
      refreshGlobeMarkers();

    }
  );


  chips.addEventListener(
    "click",
    (event) => {

      const button =
        event.target.closest(".chip");

      if (!button) return;

      currentCategory =
        button.dataset.category || "";

      document
        .querySelectorAll(".chip")
        .forEach((chip) => {

          chip.classList.toggle(
            "active",
            chip === button
          );

        });

      renderPeople();
      refreshGlobeMarkers();

    }
  );


  /*
   * ==========================================================
   * COUNTRY / DISTRICT MARKERS
   * ==========================================================
   */

  function createCountryPoints() {

    countryPoints = [];


    worldFeatures.forEach((feature) => {

      const country =
        getCountryName(feature);

      if (!country) return;


      const count =
        countCountryPeople(country);


      /*
       * Show markers for:
       * 1. India
       * 2. Any country that has directory data
       */

      if (
        normalize(country) === "india" ||
        count > 0
      ) {

        const center =
          featureCentroid(feature);

        countryPoints.push({
          lat: center.lat,
          lng: center.lng,
          country,
          count
        });

      }

    });

  }


  function createDistrictPoints() {

    districtPoints = [];


    tamilNaduFeatures.forEach((feature) => {

      const district =
        getDistrictName(feature);

      const count =
        countDistrictPeople(district);

      const center =
        featureCentroid(feature);


      districtPoints.push({

        lat: center.lat,
        lng: center.lng,

        district,

        count

      });

    });

  }


  function refreshGlobeMarkers() {

    if (!globe) return;


    createCountryPoints();
    createDistrictPoints();


    if (currentMode === "world") {

      globe
        .pointsData(countryPoints)
        .pointLat((d) => d.lat)
        .pointLng((d) => d.lng)
        .pointColor(() => "#6cf0b2")
        .pointAltitude(() => 0.035)
        .pointRadius((d) =>
          d.count > 0 ? 0.7 : 0.38
        )
        .pointResolution(24)
        .pointLabel((d) => `
          <div style="
            padding:7px 10px;
            border-radius:8px;
            background:#06120e;
            border:1px solid rgba(113,239,181,.22);
            color:#c9eee0;
            font-size:11px;
          ">
            <strong>${escapeHtml(d.country)}</strong>
            ${
              d.count > 0
                ? `<br>${d.count} people`
                : ""
            }
          </div>
        `);

      globe
        .ringsData(
          countryPoints.filter(
            (d) => d.count > 0
          )
        )
        .ringLat((d) => d.lat)
        .ringLng((d) => d.lng)
        .ringColor(() => "#65efb1")
        .ringMaxRadius(2.2)
        .ringPropagationSpeed(1.2)
        .ringRepeatPeriod(1800);

    } else {

      globe
        .pointsData(
          districtPoints.filter(
            (d) => d.count > 0
          )
        )
        .pointLat((d) => d.lat)
        .pointLng((d) => d.lng)
        .pointColor(() => "#71efb5")
        .pointAltitude(() => 0.05)
        .pointRadius((d) =>
          d.count > 0 ? 0.65 : 0.3
        )
        .pointResolution(24)
        .pointLabel((d) => `
          <div style="
            padding:7px 10px;
            border-radius:8px;
            background:#06120e;
            border:1px solid rgba(113,239,181,.22);
            color:#c9eee0;
            font-size:11px;
          ">
            <strong>${escapeHtml(d.district)}</strong>
            <br>
            ${d.count} people
          </div>
        `);

      globe
        .ringsData(
          districtPoints.filter(
            (d) => d.count > 0
          )
        )
        .ringLat((d) => d.lat)
        .ringLng((d) => d.lng)
        .ringColor(() => "#65efb1")
        .ringMaxRadius(1.8)
        .ringPropagationSpeed(1.4)
        .ringRepeatPeriod(1500);

    }

  }


  /*
   * ==========================================================
   * GLOBE POLYGONS
   * ==========================================================
   */

  function renderPolygons() {

    if (!globe) return;


    const data =
      currentMode === "world"
        ? worldFeatures
        : [
            ...worldFeatures,
            ...tamilNaduFeatures
          ];


    globe
      .polygonsData(data)
      .polygonGeoJsonGeometry(
        (feature) => feature.geometry
      )
      .polygonAltitude((feature) => {

        if (
          feature.__kind === "district"
        ) {

          if (
            normalize(getDistrictName(feature)) ===
            normalize(currentDistrict)
          ) {
            return 0.045;
          }

          return 0.018;

        }

        return 0.006;

      })
      .polygonCapColor((feature) => {

        const kind =
          feature.__kind ||
          "country";


        /*
         * DISTRICTS
         */

        if (kind === "district") {

          const district =
            getDistrictName(feature);

          const count =
            countDistrictPeople(district);


          if (
            normalize(district) ===
            normalize(currentDistrict)
          ) {

            return "rgba(245,188,94,0.78)";

          }


          if (count > 0) {

            return "rgba(55,184,128,0.58)";

          }


          return "rgba(34,65,54,0.20)";

        }


        /*
         * COUNTRIES
         */

        const country =
          getCountryName(feature);


        if (isIndia(feature)) {

          if (currentMode === "india") {

            return "rgba(54,176,125,0.35)";

          }

          return "rgba(44,145,105,0.42)";

        }


        const count =
          countCountryPeople(country);


        if (count > 0) {

          return "rgba(55,150,113,0.38)";

        }


        return "rgba(25,49,42,0.12)";

      })
      .polygonSideColor((feature) => {

        if (
          feature.__kind === "district"
        ) {

          return "rgba(46,155,111,0.25)";

        }

        return "rgba(20,60,45,0.18)";

      })
      .polygonStrokeColor((feature) => {

        if (
          feature.__kind === "district"
        ) {

          if (
            normalize(
              getDistrictName(feature)
            ) ===
            normalize(currentDistrict)
          ) {

            return "#f2c46c";

          }

          return "rgba(103,220,166,0.75)";

        }

        return "rgba(105,170,143,0.35)";

      })
      .polygonLabel((feature) => {

        if (
          feature.__kind === "district"
        ) {

          const district =
            getDistrictName(feature);

          const count =
            countDistrictPeople(district);

          return `
            <div style="
              padding:8px 11px;
              border-radius:9px;
              background:#06120e;
              border:1px solid rgba(106,239,180,.25);
              color:#d7f4e8;
              font-size:11px;
              box-shadow:0 8px 30px rgba(0,0,0,.4);
            ">
              <strong>${escapeHtml(district)}</strong>
              <br>
              <span style="color:#76dcae">
                ${count} people
              </span>
            </div>
          `;

        }


        const country =
          getCountryName(feature);

        const count =
          countCountryPeople(country);

        return `
          <div style="
            padding:8px 11px;
            border-radius:9px;
            background:#06120e;
            border:1px solid rgba(106,239,180,.2);
            color:#d7f4e8;
            font-size:11px;
          ">
            <strong>${escapeHtml(country)}</strong>
            ${
              count
                ? `<br><span style="color:#76dcae">${count} people</span>`
                : ""
            }
          </div>
        `;

      })
      .onPolygonHover((feature) => {

        hoveredFeature = feature || null;


        if (!feature) {

          hoverName.textContent =
            currentMode === "world"
              ? "Drag the globe • Scroll to zoom • Click India"
              : "Click a Tamil Nadu district to explore people";

          return;

        }


        if (
          feature.__kind === "district"
        ) {

          const district =
            getDistrictName(feature);

          const count =
            countDistrictPeople(district);

          hoverName.textContent =
            `${district} • ${count} people`;

        } else {

          const country =
            getCountryName(feature);

          const count =
            countCountryPeople(country);

          hoverName.textContent =
            `${country}${count ? ` • ${count} people` : ""}`;

        }

      })
      .onPolygonClick((feature) => {

        if (!feature) return;


        /*
         * INDIA CLICK
         */

        if (
          feature.__kind !== "district" &&
          isIndia(feature)
        ) {

          enterIndiaMode(true);

          return;

        }


        /*
         * DISTRICT CLICK
         */

        if (
          feature.__kind === "district"
        ) {

          selectDistrict(
            getDistrictName(feature),
            feature
          );

        }

      });


    /*
     * Re-enable transitions.
     */

    globe
      .polygonsTransitionDuration(700);

  }


  /*
   * ==========================================================
   * ENTER INDIA MODE
   * ==========================================================
   */

  function enterIndiaMode(animate = true) {

    if (!tamilNaduFeatures.length) return;


    currentMode = "india";

    currentCountry = "India";

    currentDistrict = "";


    mapTitle.textContent =
      "India • Tamil Nadu";

    hoverName.textContent =
      "Click a Tamil Nadu district to explore people";

    mapHint.innerHTML =
      "Click a <strong>district</strong> to filter people";


    backWorld.classList.remove("hidden");


    renderPeople();
    renderPolygons();
    refreshGlobeMarkers();


    /*
     * India → Tamil Nadu camera.
     */

    if (animate) {

      globe.pointOfView(
        {
          lat: 21.5,
          lng: 79.2,
          altitude: 1.65
        },
        900
      );


      setTimeout(() => {

        globe.pointOfView(
          {
            lat: 11.15,
            lng: 78.65,
            altitude: 1.05
          },
          1200
        );

      }, 850);

    } else {

      globe.pointOfView(
        {
          lat: 11.15,
          lng: 78.65,
          altitude: 1.05
        },
        800
      );

    }

  }


  /*
   * ==========================================================
   * SELECT DISTRICT
   * ==========================================================
   */

  function selectDistrict(
    district,
    feature
  ) {

    currentMode = "india";

    currentCountry = "India";

    currentDistrict = district;


    mapTitle.textContent =
      `Tamil Nadu • ${district}`;

    hoverName.textContent =
      `${district} selected`;

    mapHint.innerHTML =
      `Showing people from <strong>${escapeHtml(district)}</strong>`;


    renderPeople();
    renderPolygons();
    refreshGlobeMarkers();


    const center =
      featureCentroid(feature);


    globe.pointOfView(
      {
        lat: center.lat,
        lng: center.lng,
        altitude: 0.72
      },
      1000
    );

  }


  /*
   * ==========================================================
   * BACK TO WORLD
   * ==========================================================
   */

  backWorld.addEventListener(
    "click",
    () => {

      currentMode = "world";

      currentCountry = "";
      currentDistrict = "";


      mapTitle.textContent =
        "World";

      hoverName.textContent =
        "Drag the globe • Scroll to zoom • Click India";

      mapHint.innerHTML =
        "Click <strong>India</strong> to explore Tamil Nadu districts";


      backWorld.classList.add("hidden");


      renderPeople();
      renderPolygons();
      refreshGlobeMarkers();


      globe.pointOfView(
        {
          lat: 20,
          lng: 10,
          altitude: 2.35
        },
        1100
      );

    }
  );


  /*
   * ==========================================================
   * RESET
   * ==========================================================
   */

  resetMap.addEventListener(
    "click",
    () => {

      currentMode = "world";

      currentCountry = "";
      currentDistrict = "";
      currentCategory = "";
      currentSearch = "";
      currentCity = "";


      personSearch.value = "";

      citySelect.value = "";


      document
        .querySelectorAll(".chip")
        .forEach((chip, index) => {

          chip.classList.toggle(
            "active",
            index === 0
          );

        });


      mapTitle.textContent =
        "World";

      hoverName.textContent =
        "Drag the globe • Scroll to zoom • Click India";

      mapHint.innerHTML =
        "Click <strong>India</strong> to explore Tamil Nadu districts";


      backWorld.classList.add("hidden");


      personDetails.classList.add("hidden");


      renderPeople();
      renderPolygons();
      refreshGlobeMarkers();


      globe.pointOfView(
        {
          lat: 20,
          lng: 10,
          altitude: 2.35
        },
        1000
      );

    }
  );


  /*
   * ==========================================================
   * LOAD GEOJSON
   * ==========================================================
   */

  async function loadGeoJSON() {

    const [
      worldResponse,
      tamilResponse
    ] = await Promise.all([

      fetch(WORLD_URL),

      fetch(TAMIL_NADU_URL)

    ]);


    if (!worldResponse.ok) {
      throw new Error(
        "World GeoJSON could not be loaded."
      );
    }

    if (!tamilResponse.ok) {
      throw new Error(
        "Tamil Nadu GeoJSON could not be loaded."
      );
    }


    const worldGeoJSON =
      await worldResponse.json();

    const tamilGeoJSON =
      await tamilResponse.json();


    worldFeatures =
      (worldGeoJSON.features || [])
        .map((feature) => ({
          ...feature,
          __kind: "country"
        }));


    tamilNaduFeatures =
      (tamilGeoJSON.features || [])
        .map((feature) => ({
          ...feature,
          __kind: "district"
        }));


    /*
     * Some map files may expose Tamil Nadu
     * districts under different property names.
     */

    createCountryPoints();
    createDistrictPoints();

  }


  /*
   * ==========================================================
   * INITIALIZE GLOBE
   * ==========================================================
   */

  async function initializeGlobe() {

    try {

      /*
       * Load globe.gl directly from CDN.
       */

      const module =
        await import(
          "https://cdn.jsdelivr.net/npm/globe.gl@2.45.0/+esm"
        );


      Globe =
        module.default;


      /*
       * Load GeoJSON.
       */

      await loadGeoJSON();


      /*
       * Create globe.
       */

      globe =
        Globe()(globeContainer);


      /*
       * Basic globe settings.
       */

      globe
        .backgroundColor("#010504")
        .globeImageUrl(GLOBE_TEXTURE)
        .bumpImageUrl(GLOBE_BUMP)
        .backgroundImageUrl(STAR_BACKGROUND)
        .showAtmosphere(true)
        .atmosphereColor("#4fd49e")
        .atmosphereAltitude(0.12);


      /*
       * Controls.
       */

      const controls =
        globe.controls();

      controls.autoRotate = true;
      controls.autoRotateSpeed = 0.35;

      controls.enableZoom = true;
      controls.enablePan = false;

      controls.minDistance = 115;
      controls.maxDistance = 500;

      controls.rotateSpeed = 0.45;

      controls.zoomSpeed = 0.7;


      /*
       * Initial camera.
       */

      globe.pointOfView(
        {
          lat: 20,
          lng: 10,
          altitude: 2.35
        },
        0
      );


      /*
       * Resize.
       */

      function resizeGlobe() {

        if (!globe) return;

        globe
          .width(globeContainer.clientWidth)
          .height(globeContainer.clientHeight);

      }


      resizeGlobe();


      const resizeObserver =
        new ResizeObserver(
          resizeGlobe
        );

      resizeObserver.observe(
        globeContainer
      );


      /*
       * First render.
       */

      renderPolygons();

      refreshGlobeMarkers();

      renderPeople();


      /*
       * Hide loader.
       */

      requestAnimationFrame(() => {

        setTimeout(() => {

          mapLoading.classList.add("hide");

        }, 450);

      });


    } catch (error) {

      console.error(
        "World Directory Globe Error:",
        error
      );


      mapLoading.innerHTML = `

        <div style="
          font-size:38px;
          margin-bottom:8px;
        ">
          🌍
        </div>

        <strong>
          Globe could not load
        </strong>

        <small style="
          max-width:280px;
          text-align:center;
          line-height:1.6;
        ">
          Please check your internet connection
          and refresh the page.
        </small>

      `;

    }

  }


  /*
   * ==========================================================
   * START
   * ==========================================================
   */

  initializeGlobe();

</script>
        role: "International Office",
        address: "Dubai, UAE",
        phone: "+971 4 000 0000",
        email: "dubai@psgworld.com"
      }

    ];


    /* =====================================================
       DOM
    ===================================================== */

    const globeContainer =
      document.getElementById("globe");

    const loading =
      document.getElementById("loading");

    const loadingText =
      document.getElementById("loadingText");

    const locationList =
      document.getElementById("locationList");

    const locationCount =
      document.getElementById("locationCount");

    const searchInput =
      document.getElementById("searchInput");

    const detailsEmpty =
      document.getElementById("detailsEmpty");

    const details =
      document.getElementById("details");

    const detailCountry =
      document.getElementById("detailCountry");

    const detailName =
      document.getElementById("detailName");

    const detailRole =
      document.getElementById("detailRole");

    const detailBranch =
      document.getElementById("detailBranch");

    const detailAddress =
      document.getElementById("detailAddress");

    const detailPhone =
      document.getElementById("detailPhone");

    const detailEmail =
      document.getElementById("detailEmail");

    const focusBtn =
      document.getElementById("focusBtn");


    /* =====================================================
       STATE
    ===================================================== */

    let globe = null;

    let selectedLocation = null;

    let countryData = [];


    /* =====================================================
       SHOW LOCATION DETAILS
    ===================================================== */

    function showLocation(location) {

      selectedLocation = location;

      detailsEmpty.style.display = "none";

      details.classList.add("show");

      detailCountry.textContent =
        location.country;

      detailName.textContent =
        location.name;

      detailRole.textContent =
        location.role;

      detailBranch.textContent =
        location.branch;

      detailAddress.textContent =
        location.address;

      detailPhone.innerHTML =
        `<a href="tel:${location.phone}">
          ${location.phone}
        </a>`;

      detailEmail.innerHTML =
        `<a href="mailto:${location.email}">
          ${location.email}
        </a>`;


      document
        .querySelectorAll(".location-item")
        .forEach(item => {

          item.classList.toggle(
            "active",
            Number(item.dataset.id) === location.id
          );

        });


      if (globe) {

        globe.pointOfView(
          {
            lat: location.lat,
            lng: location.lng,
            altitude: 1.65
          },
          1200
        );

      }

    }


    /* =====================================================
       RENDER LEFT LOCATION LIST
    ===================================================== */

    function renderLocations(list) {

      locationList.innerHTML = "";

      locationCount.textContent =
        `${list.length} LOCATION${list.length === 1 ? "" : "S"}`;


      list.forEach(location => {

        const button =
          document.createElement("button");

        button.className =
          "location-item";

        button.dataset.id =
          location.id;


        button.innerHTML = `

          <span class="location-dot"></span>

          <span>

            <div class="location-name">
              ${location.name}
            </div>

            <div class="location-meta">
              ${location.country}
            </div>

          </span>

        `;


        button.addEventListener(
          "click",
          () => showLocation(location)
        );


        locationList.appendChild(button);

      });

    }


    renderLocations(locations);


    /* =====================================================
       SEARCH
    ===================================================== */

    searchInput.addEventListener(
      "input",
      event => {

        const query =
          event.target.value
            .trim()
            .toLowerCase();


        if (!query) {

          renderLocations(locations);

          return;

        }


        const filtered =
          locations.filter(location => {

            return (
              location.name
                .toLowerCase()
                .includes(query)

              ||

              location.country
                .toLowerCase()
                .includes(query)

              ||

              location.branch
                .toLowerCase()
                .includes(query)
            );

          });


        renderLocations(filtered);

      }
    );


    /* =====================================================
       LOAD COUNTRIES
    ===================================================== */

    async function loadCountries() {

      const url =
        "https://cdn.jsdelivr.net/npm/three-globe/example/country-polygons/ne_110m_admin_0_countries.geojson";


      const response =
        await fetch(url);


      if (!response.ok) {

        throw new Error(
          "Country GeoJSON could not be loaded"
        );

      }


      const data =
        await response.json();


      return data.features || [];

    }


    /* =====================================================
       CREATE GLOBE
    ===================================================== */

    async function createGlobe() {

      try {

        loadingText.textContent =
          "Loading countries...";


        countryData =
          await loadCountries();


        loadingText.textContent =
          "Building 3D globe...";


        /*
          Create actual 3D globe.
        */

        globe =
          Globe({
            animateIn: true,
            waitForGlobeReady: false
          })(globeContainer);


        /* -----------------------------------------
           Globe surface
        ----------------------------------------- */

        globe
          .globeImageUrl(
            null
          )
          .backgroundColor(
            "rgba(0,0,0,0)"
          )
          .showAtmosphere(true)
          .atmosphereColor("#1c8ed1")
          .atmosphereAltitude(0.13);


        /* -----------------------------------------
           Country polygons
        ----------------------------------------- */

        globe
          .polygonsData(countryData)

          .polygonGeoJsonGeometry(
            feature => feature.geometry
          )

          .polygonCapColor(
            () => "#173444"
          )

          .polygonSideColor(
            () => "rgba(15, 48, 65, 0.85)"
          )

          .polygonStrokeColor(
            () => "#4f7183"
          )

          .polygonAltitude(
            0.006
          )

          .polygonLabel(
            feature => {

              const name =
                feature.properties?.ADMIN ||
                feature.properties?.NAME ||
                feature.properties?.name ||
                "Country";

              return `

                <div style="
                  background:#07121b;
                  border:1px solid rgba(255,255,255,.15);
                  color:#fff;
                  padding:7px 9px;
                  border-radius:5px;
                  font-size:11px;
                ">
                  ${name}
                </div>

              `;

            }
          )

          .onPolygonHover(
            (polygon, previousPolygon) => {

              globe
                .polygonCapColor(
                  feature => {

                    if (
                      feature === polygon
                    ) {

                      return "#28566c";

                    }

                    return "#173444";

                  }
                );

            }
          )

          .onPolygonClick(
            (polygon, event, coords) => {

              if (!polygon) return;


              const countryName =
                polygon.properties?.ADMIN ||
                polygon.properties?.NAME ||
                polygon.properties?.name ||
                "Country";


              /*
                If this country contains one
                of our PSG locations, show it.
              */

              const matchingLocation =
                locations.find(
                  location =>
                    Math.abs(location.lat - coords.lat) < 8 &&
                    Math.abs(location.lng - coords.lng) < 12
                );


              if (matchingLocation) {

                showLocation(
                  matchingLocation
                );

              } else {

                detailsEmpty.style.display =
                  "none";

                details.classList.add(
                  "show"
                );

                detailCountry.textContent =
                  "COUNTRY";

                detailName.textContent =
                  countryName;

                detailRole.textContent =
                  "Country selected";

                detailBranch.textContent =
                  "No PSG location selected";

                detailAddress.textContent =
                  `${coords.lat.toFixed(2)}°, ${coords.lng.toFixed(2)}°`;

                detailPhone.textContent =
                  "-";

                detailEmail.textContent =
                  "-";

              }

            }
          );


        /* -----------------------------------------
           PSG points
        ----------------------------------------- */

        globe
          .pointsData(locations)

          .pointLat(
            location => location.lat
          )

          .pointLng(
            location => location.lng
          )

          .pointAltitude(
            0.025
          )

          .pointRadius(
            0.35
          )

          .pointColor(
            () => "#ff7418"
          )

          .pointResolution(
            12
          )

          .pointLabel(
            location => `

              <div style="
                background:#07121b;
                color:#fff;
                border:1px solid rgba(255,110,20,.5);
                padding:8px 10px;
                border-radius:6px;
                font-size:11px;
                box-shadow:0 4px 15px rgba(0,0,0,.4);
              ">

                <strong>
                  ${location.name}
                </strong>

                <br/>

                <span style="
                  color:#899daa;
                  font-size:10px;
                ">
                  ${location.country}
                </span>

              </div>

            `
          )

          .onPointClick(
            location => {

              showLocation(location);

            }
          );


        /* -----------------------------------------
           Controls
        ----------------------------------------- */

        const controls =
          globe.controls();


        controls.enablePan =
          false;

        controls.enableZoom =
          true;

        controls.enableDamping =
          true;

        controls.dampingFactor =
          0.08;

        controls.minDistance =
          180;

        controls.maxDistance =
          500;


        /*
          Slow automatic rotation.
          User can still drag the globe.
        */

        controls.autoRotate =
          true;

        controls.autoRotateSpeed =
          0.35;


        /* -----------------------------------------
           Initial camera
        ----------------------------------------- */

        globe.pointOfView(
          {
            lat: 20,
            lng: 78,
            altitude: 2.25
          },
          0
        );


        /* -----------------------------------------
           Hide loading
        ----------------------------------------- */

        setTimeout(() => {

          loading.classList.add(
            "hidden"
          );

        }, 700);


        console.log(
          "PSG 3D Globe loaded successfully"
        );

      } catch (error) {

        console.error(
          "3D Globe error:",
          error
        );


        loadingText.innerHTML = `
          <div style="
            color:#ff8a5b;
            max-width:280px;
            line-height:1.6;
          ">
            Unable to load the 3D globe.
            <br><br>
            Please check your internet connection
            and reload the page.
          </div>
        `;

      }

    }


    /* =====================================================
       RANDOM LOCATION
    ===================================================== */

    document
      .getElementById("randomBtn")
      .addEventListener(
        "click",
        () => {

          if (!locations.length) return;


          const random =
            locations[
              Math.floor(
                Math.random() *
                locations.length
              )
            ];


          showLocation(random);

        }
      );


    /* =====================================================
       RESET GLOBE
    ===================================================== */

    document
      .getElementById("resetBtn")
      .addEventListener(
        "click",
        () => {

          if (!globe) return;


          globe.pointOfView(
            {
              lat: 20,
              lng: 78,
              altitude: 2.25
            },
            1000
          );


          globe.controls().autoRotate =
            true;

        }
      );


    /* =====================================================
       ZOOM
    ===================================================== */

    document
      .getElementById("zoomIn")
      .addEventListener(
        "click",
        () => {

          if (!globe) return;

          const controls =
            globe.controls();

          controls.dollyIn(
            1.25
          );

          controls.update();

        }
      );


    document
      .getElementById("zoomOut")
      .addEventListener(
        "click",
        () => {

          if (!globe) return;

          const controls =
            globe.controls();

          controls.dollyOut(
            1.25
          );

          controls.update();

        }
      );


    /* =====================================================
       FOCUS BUTTON
    ===================================================== */

    focusBtn.addEventListener(
      "click",
      () => {

        if (
          !globe ||
          !selectedLocation
        ) return;


        globe.pointOfView(
          {
            lat: selectedLocation.lat,
            lng: selectedLocation.lng,
            altitude: 1.45
          },
          1000
        );

      }
    );


    /* =====================================================
       START
    ===================================================== */

    createGlobe();

  </script>

</body>
</html>
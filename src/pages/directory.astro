<script define:vars={{ people }}>
  /* ========================================================
     PSG PEOPLE DIRECTORY
     NORMAL 2D MAP
  ======================================================== */


  const searchInput =
    document.getElementById(
      "searchInput"
    );


  const citySelect =
    document.getElementById(
      "citySelect"
    );


  const departmentSelect =
    document.getElementById(
      "departmentSelect"
    );



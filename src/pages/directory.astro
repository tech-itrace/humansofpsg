    document.getElementById("detailAvatar");

  const detailName =
    document.getElementById("detailName");

  const detailCategory =
    document.getElementById("detailCategory");

  const detailCompany =
    document.getElementById("detailCompany");

  const detailLocation =
    document.getElementById("detailLocation");

  const detailPhone =
    document.getElementById("detailPhone");

  const detailEmail =
    document.getElementById("detailEmail");

  const detailDescription =
    document.getElementById("detailDescription");

  const callBtn =
    document.getElementById("callBtn");

  const emailBtn =
    document.getElementById("emailBtn");

  const chips =
    document.querySelectorAll(".chip");


  const WORLD_URL =
    "https://raw.githubusercontent.com/datasets/geo-countries/master/data/countries.geojson";


  /*
    IMPORTANT:

    This is NOT a separate Tamil Nadu map.

    The Tamil Nadu districts are loaded as an
    overlay and drawn inside the same world SVG.
  */

  const TN_URL =
    "https://raw.githubusercontent.com/udit-001/india-maps-data/master/geojson/states/tamil-nadu.geojson";


  const COLORS = {
    empty: "#e6eee9",
    one: "#9ed7bb",
    many: "#4caf82",
    hover: "#f8c766",
    active: "#f59e0b",
    stroke: "#ffffff",
    dot: "#0f4c3a"
  };


  let worldGeoJSON = null;

  let tamilNaduGeoJSON = null;

  let currentCountry = "";

  let currentDistrict = "";

  let currentCategory = "";

  let mapMode = "world";


  /*
    worldView
    ----------
    true = complete world

    false = same SVG zoomed into India
  */

  let indiaZoom = false;


  /* =====================================================
     NORMALIZE
  ===================================================== */

  function normalize(value) {

    return String(value || "")
      .trim()
      .toLowerCase()
      .replace(/&/g, "and")
      .replace(/[^a-z0-9]/g, "");
  }


  function normalizeDistrict(value) {

    const valueNormalized =
      normalize(value);

    const aliases = {

      kancheepuram: "kanchipuram",

      kanchipuram: "kanchipuram",

      tiruchirappalli:
        "tiruchirappalli",

      trichy:
        "tiruchirappalli",

      thoothukudi:
        "thoothukudi",

      tuticorin:
        "thoothukudi",

      tirunelveli:
        "tirunelveli",

      tiruvallur:
        "tiruvallur",

      thiruvallur:
        "tiruvallur",

      nilgiris:
        "nilgiris"

    };

    return (
      aliases[valueNormalized] ||
      valueNormalized
    );
  }


  /* =====================================================
     COUNTRY NAME
  ===================================================== */

  function getCountryName(feature) {

    const p =
      feature?.properties || {};

    return (
      p.ADMIN ||
      p.NAME ||
      p.NAME_LONG ||
      p.NAME_EN ||
      p.name ||
      p.SOVEREIGNT ||
      p.BRK_NAME ||
      "Unknown"
    );
  }


  /* =====================================================
     DISTRICT NAME
  ===================================================== */

  function getDistrictName(feature) {

    const p =
      feature?.properties || {};

    return (
      p.district_name ||
      p.DISTRICT ||
      p.DISTRICT_NAME ||
      p.DISTRICTNAME ||
      p.REGNAME ||
      p.NAME_2 ||
      p.NAME ||
      p.name ||
      p.NAME_EN ||
      "Unknown District"
    );
  }


  /* =====================================================
     COUNT
  ===================================================== */

  function countryCount(country) {

    return people.filter(
      person =>
        normalize(person.country) ===
        normalize(country)
    ).length;
  }


  function districtCount(district) {

    return people.filter(
      person =>
        normalizeDistrict(
          person.district
        ) ===
        normalizeDistrict(
          district
        )
    ).length;
  }


  /* =====================================================
     COORDINATES
  ===================================================== */

  function getCoordinates(geometry) {

    const result = [];

    function walk(value) {

      if (!Array.isArray(value)) {
        return;
      }

      if (
        value.length >= 2 &&
        typeof value[0] === "number" &&
        typeof value[1] === "number"
      ) {

        result.push(value);

        return;
      }

      value.forEach(walk);
    }

    if (geometry) {
      walk(geometry.coordinates);
    }

    return result;
  }


  /* =====================================================
     BOUNDS
  ===================================================== */

  function getBounds(features) {

    let minLon = Infinity;
    let maxLon = -Infinity;

    let minLat = Infinity;
    let maxLat = -Infinity;

    features.forEach(feature => {

      const coords =
        getCoordinates(
          feature.geometry
        );

      coords.forEach(
        ([lon, lat]) => {

          minLon =
            Math.min(
              minLon,
              lon
            );

          maxLon =
            Math.max(
              maxLon,
              lon
            );

          minLat =
            Math.min(
              minLat,
              lat
            );

          maxLat =
            Math.max(
              maxLat,
              lat
            );

        }
      );

    });

    return {
      minLon,
      maxLon,
      minLat,
      maxLat
    };
  }


  /* =====================================================
     PROJECTOR
  ===================================================== */

  function createProjector(
    features,
    forcedBounds = null
  ) {

    const bounds =
      forcedBounds ||
      getBounds(features);

    const W = 1200;

    const H = 650;

    const padding = 35;

    const lonRange =
      Math.max(
        bounds.maxLon -
        bounds.minLon,
        0.001
      );

    const latRange =
      Math.max(
        bounds.maxLat -
        bounds.minLat,
        0.001
      );

    const scaleX =
      (W - padding * 2) /
      lonRange;

    const scaleY =
      (H - padding * 2) /
      latRange;

    const scale =
      Math.min(
        scaleX,
        scaleY
      );

    const width =
      lonRange * scale;

    const height =
      latRange * scale;

    const offsetX =
      (W - width) / 2;

    const offsetY =
      (H - height) / 2;


    return function project(
      lon,
      lat
    ) {

      return {

        x:
          offsetX +
          (lon - bounds.minLon) *
          scale,

        y:
          H -
          offsetY -
          (lat - bounds.minLat) *
          scale

      };

    };
  }


  /* =====================================================
     PATH
  ===================================================== */

  function ringPath(
    ring,
    project
  ) {

    if (
      !ring ||
      !ring.length
    ) {
      return "";
    }

    return (
      ring
        .map(
          ([lon, lat], index) => {

            const p =
              project(
                lon,
                lat
              );

            return `${
              index === 0
                ? "M"
                : "L"
            } ${p.x} ${p.y}`;

          }
        )
        .join(" ")
      + " Z"
    );
  }


  function geometryPath(
    geometry,
    project
  ) {

    if (!geometry) {
      return "";
    }


    if (
      geometry.type ===
      "Polygon"
    ) {

      return geometry.coordinates
        .map(
          ring =>
            ringPath(
              ring,
              project
            )
        )
        .join(" ");

    }


    if (
      geometry.type ===
      "MultiPolygon"
    ) {

      return geometry.coordinates
        .flat()
        .map(
          ring =>
            ringPath(
              ring,
              project
            )
        )
        .join(" ");

    }


    return "";
  }


  /* =====================================================
     SVG
  ===================================================== */

  function svg(name) {

    return document.createElementNS(
      "http://www.w3.org/2000/svg",
      name
    );
  }


  /* =====================================================
     WORLD MAP
  ===================================================== */

  function renderWorld() {

    if (!worldGeoJSON) {
      return;
    }

    mapMode =
      "world";

    indiaZoom =
      false;

    mapSvg.innerHTML = "";

    const features =
      worldGeoJSON.features || [];

    const project =
      createProjector(features);


    features.forEach(
      feature => {

        const country =
          getCountryName(feature);

        const count =
          countryCount(country);


        const path =
          svg("path");

        path.setAttribute(
          "d",
          geometryPath(
            feature.geometry,
            project
          )
        );

        path.classList.add(
          "map-area"
        );


        if (
          normalize(country) ===
          normalize(
            currentCountry
          )
        ) {

          path.classList.add(
            "active-area"
          );
        }


        if (count === 0) {

          path.style.fill =
            COLORS.empty;

        } else if (count === 1) {

          path.style.fill =
            COLORS.one;

        } else {

          path.style.fill =
            COLORS.many;

        }


        path.addEventListener(
          "mouseenter",
          () => {

            hoverName.textContent =
              `${country} • ${count} ${
                count === 1
                  ? "person"
                  : "people"
              }`;

          }
        );


        path.addEventListener(
          "mouseleave",
          () => {

            hoverName.textContent =
              "Click India to explore";

          }
        );


        path.addEventListener(
          "click",
          async () => {

            if (
              normalize(country) ===
              "india"
            ) {

              await zoomIntoIndia();

            } else {

              selectCountry(
                country
              );

            }

          }
        );


        mapSvg.appendChild(path);


        /*
          People dot
        */

        if (count > 0) {

          const coords =
            getCoordinates(
              feature.geometry
            );

          if (coords.length) {

            let lon = 0;

            let lat = 0;

            coords.forEach(
              ([x, y]) => {

                lon += x;

                lat += y;

              }
            );

            lon /=
              coords.length;

            lat /=
              coords.length;


            const p =
              project(
                lon,
                lat
              );


            const circle =
              svg("circle");

            circle.setAttribute(
              "cx",
              p.x
            );

            circle.setAttribute(
              "cy",
              p.y
            );

            circle.setAttribute(
              "r",
              count > 1
                ? "6"
                : "4"
            );

            circle.classList.add(
              "person-dot"
            );


            circle.addEventListener(
              "click",
              event => {

                event.stopPropagation();

                if (
                  normalize(country) ===
                  "india"
                ) {

                  zoomIntoIndia();

                }

              }
            );


            mapSvg.appendChild(
              circle
            );

          }

        }

      }
    );


    mapTitle.textContent =
      "World Map";

    mapHint.textContent =
      "Click India to explore Tamil Nadu";

    backWorld.classList.add(
      "hidden"
    );

    mapLoading.classList.add(
      "hidden"
    );
  }


  /* =====================================================
     LOAD TAMIL NADU DATA
     WITHOUT CHANGING THE MAP PAGE
  ===================================================== */

  async function loadTamilNadu() {

    if (tamilNaduGeoJSON) {
      return true;
    }


    try {

      const response =
        await fetch(
          TN_URL
        );


      if (!response.ok) {

        throw new Error(
          "Tamil Nadu GeoJSON failed"
        );

      }


      tamilNaduGeoJSON =
        await response.json();


      return true;

    } catch (error) {

      console.error(
        "Tamil Nadu GeoJSON error:",
        error
      );

      return false;

    }
  }


  /* =====================================================
     INDIA ZOOM
  ===================================================== */

  async function zoomIntoIndia() {

    currentCountry =
      "India";

    currentDistrict =
      "";

    selectedCountry.textContent =
      "India";

    selectedDistrict.textContent =
      "Tamil Nadu";


    mapLoading.classList.remove(
      "hidden"
    );


    const loaded =
      await loadTamilNadu();


    if (!loaded) {

      mapLoading.classList.add(
        "hidden"
      );

      hoverName.textContent =
        "Tamil Nadu district data could not be loaded";

      return;
    }


    /*
      IMPORTANT:

      We are NOT replacing the World page.

      We draw Tamil Nadu district
      boundaries inside the SAME SVG.
    */

    indiaZoom = true;

    mapMode =
      "india";


    mapSvg.innerHTML = "";


    /*
      Use Tamil Nadu bounds.

      This makes the existing world
      map canvas zoom into Tamil Nadu.
    */

    const tnFeatures =
      tamilNaduGeoJSON.features || [];


    const tnBounds =
      getBounds(
        tnFeatures
      );


    const project =
      createProjector(
        tnFeatures,
        tnBounds
      );


    /*
      Draw Tamil Nadu districts
      inside the same world SVG.
    */

    tnFeatures.forEach(
      feature => {

        const district =
          getDistrictName(
            feature
          );

        const count =
          districtCount(
            district
          );


        const path =
          svg("path");


        path.setAttribute(
          "d",
          geometryPath(
            feature.geometry,
            project
          )
        );


        path.classList.add(
          "map-area",
          "district-area"
        );


        if (
          normalizeDistrict(
            district
          ) ===
          normalizeDistrict(
            currentDistrict
          )
        ) {

          path.classList.add(
            "active-area"
          );

        }


        if (count === 0) {

          path.style.fill =
            COLORS.empty;

        } else if (count === 1) {

          path.style.fill =
            COLORS.one;

        } else {

          path.style.fill =
            COLORS.many;

        }


        path.addEventListener(
          "mouseenter",
          () => {

            hoverName.textContent =
              `${district} • ${count} ${
                count === 1
                  ? "person"
                  : "people"
              }`;

          }
        );


        path.addEventListener(
          "mouseleave",
          () => {

            hoverName.textContent =
              currentDistrict
                ? `${currentDistrict} selected`
                : "Click a Tamil Nadu district";

          }
        );


        path.addEventListener(
          "click",
          () => {

            selectDistrict(
              district
            );

          }
        );


        mapSvg.appendChild(
          path
        );


        /*
          District label
        */

        const coords =
          getCoordinates(
            feature.geometry
          );


        if (coords.length) {

          let lon = 0;

          let lat = 0;


          coords.forEach(
            ([x, y]) => {

              lon += x;

              lat += y;

            }
          );


          lon /=
            coords.length;

          lat /=
            coords.length;


          const p =
            project(
              lon,
              lat
            );


          const label =
            svg("text");


          label.setAttribute(
            "x",
            p.x
          );


          label.setAttribute(
            "y",
            p.y
          );


          label.setAttribute(
            "text-anchor",
            "middle"
          );


          label.classList.add(
            "district-label"
          );


          label.textContent =
            district;


          mapSvg.appendChild(
            label
          );


          /*
            Person dot
          */

          if (count > 0) {

            const dot =
              svg("circle");


            dot.setAttribute(
              "cx",
              p.x
            );


            dot.setAttribute(
              "cy",
              p.y + 12
            );


            dot.setAttribute(
              "r",
              count > 1
                ? "6"
                : "4"
            );


            dot.classList.add(
              "person-dot"
            );


            mapSvg.appendChild(
              dot
            );

          }

        }

      }
    );


    mapTitle.textContent =
      "India • Tamil Nadu";

    mapHint.textContent =
      "Click a Tamil Nadu district to show people";

    backWorld.classList.remove(
      "hidden"
    );


    mapLoading.classList.add(
      "hidden"
    );


    filterPeople();
  }


  /* =====================================================
     COUNTRY SELECT
  ===================================================== */

  function selectCountry(
    country
  ) {

    currentCountry =
      country;

    currentDistrict =
      "";


    selectedCountry.textContent =
      country;

    selectedDistrict.textContent =
      "";


    filterPeople();


    hoverName.textContent =
      `${country} selected`;

  }


  /* =====================================================
     DISTRICT SELECT
  ===================================================== */

  function selectDistrict(
    district
  ) {

    currentCountry =
      "India";

    currentDistrict =
      district;


    selectedCountry.textContent =
      "India";


    selectedDistrict.textContent =
      `• ${district}`;


    filterPeople();


    /*
      Re-render same zoomed map
      so selected district becomes orange.
    */

    zoomIntoIndia();

  }


  /* =====================================================
     FILTER PEOPLE
  ===================================================== */

  function filterPeople() {

    const search =
      personSearch.value
        .trim()
        .toLowerCase();


    const city =
      citySelect.value;


    const rows =
      peopleList.querySelectorAll(
        ".person-row"
      );


    let count =
      0;


    rows.forEach(
      row => {

        const country =
          row.dataset.country || "";

        const district =
          row.dataset.district || "";

        const rowCity =
          row.dataset.city || "";

        const category =
          row.dataset.category || "";

        const searchText =
          row.dataset.search
            ?.toLowerCase() || "";


        const countryMatch =
          !currentCountry ||
          normalize(
            country
          ) ===
          normalize(
            currentCountry
          );


        const districtMatch =
          !currentDistrict ||
          normalizeDistrict(
            district
          ) ===
          normalizeDistrict(
            currentDistrict
          );


        const searchMatch =
          !search ||
          searchText.includes(
            search
          );


        const cityMatch =
          !city ||
          rowCity === city;


        const categoryMatch =
          !currentCategory ||
          category ===
          currentCategory;


        const visible =
          countryMatch &&
          districtMatch &&
          searchMatch &&
          cityMatch &&
          categoryMatch;


        row.classList.toggle(
          "hidden-row",
          !visible
        );


        if (visible) {
          count++;
        }

      }
    );


    resultCount.textContent =
      count;


    emptyState.classList.toggle(
      "show",
      count === 0
    );
  }


  /* =====================================================
     PERSON DETAILS
  ===================================================== */

  function showPerson(id) {

    const person =
      people.find(
        p =>
          String(p.id) ===
          String(id)
      );


    if (!person) {
      return;
    }


    detailAvatar.textContent =
      person.name.charAt(0);


    detailName.textContent =
      person.name;


    detailCategory.textContent =
      person.category;


    detailCompany.textContent =
      person.company;


    detailLocation.textContent =
      `${person.city}, ${person.district}, ${person.country}`;


    detailPhone.textContent =
      person.phone;


    detailEmail.textContent =
      person.email;


    detailDescription.textContent =
      person.description;


    callBtn.href =
      `tel:${person.phone.replace(
        /\s/g,
        ""
      )}`;


    emailBtn.href =
      `mailto:${person.email}`;


    details.classList.remove(
      "hidden"
    );
  }


  /* =====================================================
     PERSON CLICK
  ===================================================== */

  document
    .querySelectorAll(
      ".person-row"
    )
    .forEach(
      row => {

        row.addEventListener(
          "click",
          () => {

            showPerson(
              row.dataset.id
            );

          }
        );

      }
    );


  /* =====================================================
     CLOSE DETAILS
  ===================================================== */

  closeDetails.addEventListener(
    "click",
    () => {

      details.classList.add(
        "hidden"
      );

    }
  );


  /* =====================================================
     CATEGORY
  ===================================================== */

  chips.forEach(
    chip => {

      chip.addEventListener(
        "click",
        () => {

          chips.forEach(
            c =>
              c.classList.remove(
                "active"
              )
          );


          chip.classList.add(
            "active"
          );


          currentCategory =
            chip.dataset.category ||
            "";


          filterPeople();

        }
      );

    }
  );


  /* =====================================================
     SEARCH
  ===================================================== */

  personSearch.addEventListener(
    "input",
    filterPeople
  );


  /* =====================================================
     CITY
  ===================================================== */

  citySelect.addEventListener(
    "change",
    filterPeople
  );


  /* =====================================================
     BACK TO WORLD
  ===================================================== */

  backWorld.addEventListener(
    "click",
    () => {

      currentCountry =
        "";

      currentDistrict =
        "";

      indiaZoom =
        false;


      selectedCountry.textContent =
        "All Countries";


      selectedDistrict.textContent =
        "";


      hoverName.textContent =
        "Click India to explore";


      renderWorld();


      filterPeople();

    }
  );


  /* =====================================================
     RESET
  ===================================================== */

  resetMap.addEventListener(
    "click",
    () => {

      currentCountry =
        "";

      currentDistrict =
        "";

      currentCategory =
        "";


      personSearch.value =
        "";


      citySelect.value =
        "";


      chips.forEach(
        chip =>
          chip.classList.remove(
            "active"
          )
      );


      document
        .querySelector(
          '.chip[data-category=""]'
        )
        ?.classList.add(
          "active"
        );


      selectedCountry.textContent =
        "All Countries";


      selectedDistrict.textContent =
        "";


      details.classList.add(
        "hidden"
      );


      renderWorld();


      filterPeople();

    }
  );


  /* =====================================================
     LOAD WORLD
  ===================================================== */

  async function loadWorld() {

    try {

      const response =
        await fetch(
          WORLD_URL
        );


      if (!response.ok) {
        throw new Error(
          "World GeoJSON failed"
        );
      }


      worldGeoJSON =
        await response.json();


      renderWorld();


      filterPeople();


    } catch (error) {

      console.error(
        error
      );


      mapLoading.innerHTML = `
        <div class="map-error">
          <strong>Map loading failed</strong>
          <span>Please refresh the page.</span>
        </div>
      `;

    }

  }


  loadWorld();

</script>



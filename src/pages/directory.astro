const categories = [...new Set(people.map(p => p.category))].sort();
---

<div class="directory-page">

  <!-- =====================================================
       HEADER
  ====================================================== -->

  <header class="directory-header">

    <div>
      <p class="eyebrow">HUMANS OF PSG</p>

      <h1>
        Global People Network
      </h1>

      <p class="subtitle">
        Explore PSGians by location.
      </p>
    </div>

    <div class="header-count">
      <strong>{people.length}</strong>
      <span>People</span>
    </div>

  </header>


  <!-- =====================================================
       MAIN
  ====================================================== -->

  <main class="directory-layout">

    <!-- =================================================
         SIDEBAR
    ================================================== -->

    <aside class="directory-sidebar">

      <div class="search-box">

        <span>⌕</span>

        <input
          id="searchInput"
          type="search"
          placeholder="Search PSGians..."
        />

      </div>


      <div class="filter-group">

        <label>City</label>

        <select id="citySelect">

          <option value="">
            All cities
          </option>

          {cities.map(city => (
            <option value={city}>
              {city}
            </option>
          ))}

        </select>

      </div>


      <div class="filter-group">

        <label>Department</label>

        <select id="departmentSelect">

          <option value="">
            All departments
          </option>

          {departments.map(department => (
            <option value={department}>
              {department}
            </option>
          ))}

        </select>

      </div>


      <div class="filter-group">

        <label>Expertise</label>

        <select id="expertiseSelect">

          <option value="">
            All expertise
          </option>

          {expertise.map(item => (
            <option value={item}>
              {item}
            </option>
          ))}

        </select>

      </div>


      <div class="category-section">

        <div class="section-title">
          Categories
        </div>

        <div
          id="categoryChips"
          class="category-chips"
        >

          <button
            class="category-chip active"
            data-category=""
            type="button"
          >
            All
          </button>

          {categories.map(category => (

            <button
              class="category-chip"
              data-category={category}
              type="button"
            >
              {category}
            </button>

          ))}

        </div>

      </div>


      <button
        id="resetButton"
        class="reset-button"
        type="button"
      >
        Reset filters
      </button>


      <div class="result-count">

        <strong id="resultCount">
          {people.length}
        </strong>

        people found

      </div>


      <div
        id="peopleList"
        class="people-list"
      ></div>

    </aside>


    <!-- =================================================
         MAP SECTION
    ================================================== -->

    <section class="map-section">

      <div class="map-topbar">

        <div>

          <p class="map-eyebrow">
            EXPLORE BY LOCATION
          </p>

          <h2 id="mapTitle">
            World
          </h2>

        </div>


        <button
          id="backButton"
          class="back-button hidden"
          type="button"
        >
          ← Back
        </button>

      </div>


      <!-- =================================================
           GLOBE
      ================================================== -->

      <div
        id="globeContainer"
        class="globe-container"
      >

        <!-- LOADING -->
        <div
          id="globeLoading"
          class="globe-loading"
        >
          <span class="loading-spinner"></span>
          <span id="loadingText">
            Loading globe...
          </span>
        </div>


        <div class="globe-crosshair">
          <span></span>
        </div>


        <div
          id="locationLabel"
          class="location-label"
        >
          Explore the world
        </div>


        <div
          id="locationCount"
          class="location-count"
        >
          {people.length} PSGians
        </div>

      </div>


      <div class="map-hint">
        Drag to rotate · Scroll to zoom · Click a location
      </div>


      <!-- =================================================
           PERSON DETAIL
      ================================================== -->

      <div
        id="personDetails"
        class="person-details hidden"
      >

        <button
          id="closeDetails"
          class="close-details"
          type="button"
          aria-label="Close"
        >
          ×
        </button>


        <img
          id="detailImage"
          src=""
          alt=""
        />


        <div>

          <p
            id="detailCategory"
            class="detail-category"
          ></p>

          <h3 id="detailName"></h3>

          <p
            id="detailQuote"
            class="detail-quote"
          ></p>


          <div class="detail-meta">

            <span id="detailCity"></span>

            <span id="detailDepartment"></span>

            <span id="detailExpertise"></span>

          </div>

        </div>

      </div>

    </section>

  </main>


  <!-- =====================================================
       FOOTER
  ====================================================== -->

  <footer class="directory-footer">

    <span>
      © 2026 by HOP
    </span>

    <span>
      Build in India by PSGians
    </span>

  </footer>

</div>


<script define:vars={{
  people,
  cities,
  departments,
  expertise,
  categories
}}>

  /* =====================================================
     ELEMENTS
  ===================================================== */

  const container =
    document.getElementById(
      "globeContainer"
    );

  const globeLoading =
    document.getElementById(
      "globeLoading"
    );

  const loadingText =
    document.getElementById(
      "loadingText"
    );

  const mapTitle =
    document.getElementById(
      "mapTitle"
    );

  const backButton =
    document.getElementById(
      "backButton"
    );

  const locationLabel =
    document.getElementById(
      "locationLabel"
    );

  const locationCount =
    document.getElementById(
      "locationCount"
    );

  const searchInput =
    document.getElementById(
      "searchInput"
    );

  const citySelect =
    document.getElementById(
      "citySelect"
    );

  const departmentSelect =
    document.getElementById(
      "departmentSelect"
    );

  const expertiseSelect =
    document.getElementById(
      "expertiseSelect"
    );

  const categoryChips =
    document.getElementById(
      "categoryChips"
    );

  const resetButton =
    document.getElementById(
      "resetButton"
    );

  const resultCount =
    document.getElementById(
      "resultCount"
    );

  const peopleList =
    document.getElementById(
      "peopleList"
    );


  /* =====================================================
     DETAIL ELEMENTS
  ===================================================== */

  const personDetails =
    document.getElementById(
      "personDetails"
    );

  const closeDetails =
    document.getElementById(
      "closeDetails"
    );

  const detailImage =
    document.getElementById(
      "detailImage"
    );

  const detailCategory =
    document.getElementById(
      "detailCategory"
    );

  const detailName =
    document.getElementById(
      "detailName"
    );

  const detailQuote =
    document.getElementById(
      "detailQuote"
    );

  const detailCity =
    document.getElementById(
      "detailCity"
    );

  const detailDepartment =
    document.getElementById(
      "detailDepartment"
    );

  const detailExpertise =
    document.getElementById(
      "detailExpertise"
    );


  /* =====================================================
     STATE
  ===================================================== */

  let mode = "world";

  let selectedState = "";

  let selectedDistrict = "";

  let selectedCategory = "";


  let visiblePeople = [...people];

  let globe = null;


  /* =====================================================
     HELPERS
  ===================================================== */

  function normalize(value) {

    return String(value || "")
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]/g, "");

  }


  /* =====================================================
     FILTER PEOPLE
  ===================================================== */

  function getFilteredPeople() {

    const search =
      normalize(
        searchInput.value
      );

    const city =
      normalize(
        citySelect.value
      );

    const department =
      normalize(
        departmentSelect.value
      );

    const selectedExpertise =
      normalize(
        expertiseSelect.value
      );


    return people.filter(person => {

      const text =
        normalize(
          [
            person.name,
            person.country,
            person.state,
            person.city,
            person.district,
            person.department,
            person.expertise,
            person.category,
            person.branch,
            person.address,
            person.pullQuote,
            ...(person.tags || [])
          ].join(" ")
        );


      return (

        (!search ||
          text.includes(search))

        &&

        (!city ||
          normalize(person.city) === city)

        &&

        (!department ||
          normalize(person.department) === department)

        &&

        (!selectedExpertise ||
          normalize(person.expertise) === selectedExpertise)

        &&

        (!selectedCategory ||
          normalize(person.category) ===
          normalize(selectedCategory))

        &&

        (!selectedState ||
          normalize(person.state) ===
          normalize(selectedState))

        &&

        (!selectedDistrict ||
          normalize(person.district) ===
          normalize(selectedDistrict))

      );

    });

  }


  /* =====================================================
     RENDER PEOPLE
  ===================================================== */

  function renderPeople() {

    visiblePeople =
      getFilteredPeople();


    resultCount.textContent =
      visiblePeople.length;


    peopleList.innerHTML =
      "";


    visiblePeople.forEach(person => {

      const button =
        document.createElement(
          "button"
        );


      button.className =
        "person-card";


      button.type =
        "button";


      button.innerHTML = `

        <div class="person-avatar">

          ${
            person.image

              ? `
                <img
                  src="${person.image}"
                  alt="${person.name}"
                  loading="lazy"
                />
              `

              : `
                <span>
                  ${person.name.charAt(0)}
                </span>
              `
          }

        </div>


        <div class="person-card-info">

          <strong>
            ${person.name}
          </strong>

          <span>
            ${person.city}
          </span>

          <small>
            ${person.department}
          </small>

        </div>

      `;


      button.addEventListener(
        "click",
        () => showPerson(person)
      );


      peopleList.appendChild(
        button
      );

    });


    updateGlobePoints();

  }


  /* =====================================================
     SHOW PERSON
  ===================================================== */

  function showPerson(person) {

    detailName.textContent =
      person.name;

    detailCategory.textContent =
      person.category;

    detailQuote.textContent =
      person.pullQuote;

    detailCity.textContent =
      `📍 ${person.city}`;

    detailDepartment.textContent =
      `• ${person.department}`;

    detailExpertise.textContent =
      `• ${person.expertise}`;


    if (person.image) {

      detailImage.src =
        person.image;

      detailImage.alt =
        person.name;

      detailImage.style.display =
        "block";

    } else {

      detailImage.style.display =
        "none";

    }


    personDetails.classList.remove(
      "hidden"
    );


    focusLocation(
      person.lat,
      person.lng,
      4
    );

  }


  closeDetails.addEventListener(
    "click",
    () => {

      personDetails.classList.add(
        "hidden"
      );

    }
  );


  /* =====================================================
     GLOBE
  ===================================================== */

  function buildGlobe(Globe) {

    globe =
      Globe()(container)

        .backgroundColor(
          "#101914"
        )

        .globeImageUrl(
          "https://unpkg.com/three-globe/example/img/earth-blue-marble.jpg"
        )

        .bumpImageUrl(
          "https://unpkg.com/three-globe/example/img/earth-topology.png"
        )

        .showAtmosphere(
          true
        )

        .atmosphereColor(
          "#8da99a"
        )

        .atmosphereAltitude(
          0.15
        );


  /* =====================================================
     POINT SETTINGS
  ===================================================== */

  globe

    .pointLat(
      d => d.lat
    )

    .pointLng(
      d => d.lng
    )

    .pointColor(
      () => "#86c997"
    )

    .pointRadius(
      d => {

        if (d.cluster) {
          return 0.5;
        }

        return 0.35;

      }
    )

    .pointAltitude(
      0.01
    )

    .pointLabel(
      d => {

        if (d.cluster) {

          return `
            <div class="globe-tooltip">
              <strong>${d.city}</strong>
              <br />
              ${d.count} PSGians
            </div>
          `;

        }


        return `
          <div class="globe-tooltip">
            <strong>${d.name}</strong>
            <br />
            ${d.city}
          </div>
        `;

      }
    )

    .onPointClick(
      d => {

        if (d.cluster) {

          focusLocation(
            d.lat,
            d.lng,
            4
          );


          if (mode === "world") {

            selectedState =
              "Tamil Nadu";

            mode =
              "india";

            mapTitle.textContent =
              "India";

            backButton.classList.remove(
              "hidden"
            );

            locationLabel.textContent =
              "Tamil Nadu";

          }

          return;

        }


        // Clicking a person point opens that person's details.
        showPerson(d);

      }
    )

    // Clicking ANY area of the globe finds the nearest PSGian
    // location and shows that area's people in the left panel.
    .onGlobeClick(
      coords => {

        if (!coords) return;

        // Any click on the actual globe surface selects that area.
        // The closest PSGian city is then shown in the left panel.
        showMapArea(
          Number(coords.lat),
          Number(coords.lng)
        );

      }
    );

  }


  /* =====================================================
     MAP AREA CLICK
  ===================================================== */

  function distanceKm(
    lat1,
    lng1,
    lat2,
    lng2
  ) {

    const toRad =
      value => value * Math.PI / 180;

    const earthRadius = 6371;

    const dLat =
      toRad(lat2 - lat1);

    const dLng =
      toRad(lng2 - lng1);

    const a =
      Math.sin(dLat / 2) ** 2 +
      Math.cos(toRad(lat1)) *
      Math.cos(toRad(lat2)) *
      Math.sin(dLng / 2) ** 2;

    return (
      2 *
      earthRadius *
      Math.atan2(
        Math.sqrt(a),
        Math.sqrt(1 - a)
      )
    );

  }


  function showMapArea(
    lat,
    lng
  ) {

    if (!people.length) {
      return;
    }


    // Find the nearest real location represented by our directory data.
    const nearest =
      people.reduce(
        (closest, person) => {

          const distance =
            distanceKm(
              lat,
              lng,
              Number(person.lat),
              Number(person.lng)
            );

          if (!closest || distance < closest.distance) {
            return {
              person,
              distance
            };
          }

          return closest;

        },
        null
      );


    if (!nearest || !nearest.person) {
      return;
    }


    const areaPerson =
      nearest.person;

    const areaCity =
      normalize(areaPerson.city);


    // Clear text/category filters so the complete area's data is visible.
    searchInput.value = "";
    departmentSelect.value = "";
    expertiseSelect.value = "";
    selectedCategory = "";
    selectedState = "";
    selectedDistrict = "";

    categoryChips
      .querySelectorAll(
        ".category-chip"
      )
      .forEach(
        chip => {
          chip.classList.toggle(
            "active",
            chip.dataset.category === ""
          );
        }
      );


    // Select the nearest city in the left-side city filter.
    const cityOption =
      Array.from(
        citySelect.options
      ).find(
        option =>
          normalize(option.value) === areaCity
      );

    citySelect.value =
      cityOption
        ? cityOption.value
        : areaPerson.city;


    visiblePeople =
      people.filter(
        person =>
          normalize(person.city) === areaCity
      );


    mode =
      areaPerson.state === "Tamil Nadu"
        ? "tamilNadu"
        : "india";

    selectedState =
      areaPerson.state || "";


    mapTitle.textContent =
      areaPerson.city;

    locationLabel.textContent =
      `${areaPerson.city} · ${areaPerson.state || areaPerson.country}`;

    backButton.classList.remove(
      "hidden"
    );


    // Animate the globe into a close-up of the clicked area.
    // We use the nearest directory location so the selected area and
    // the people shown in the left panel stay in sync.
    focusLocation(
      Number(areaPerson.lat),
      Number(areaPerson.lng),
      0.55,
      1800
    );


    // Re-render the left panel with ONLY this area's people.
    renderPeople();


    // Bring the newly filtered area data into view on the left.
    peopleList.scrollIntoView({
      behavior: "smooth",
      block: "nearest"
    });

  }


  /* =====================================================
     LOCATION DATA
  ===================================================== */

  function createPoints() {

    return visiblePeople.map(
      person => ({
        ...person,
        cluster: false
      })
    );

  }


  function updateGlobePoints() {

    if (!globe) return;

    globe.pointsData(
      createPoints()
    );


    locationCount.textContent =
      `${visiblePeople.length} PSGians`;

  }


  /* =====================================================
     FOCUS GLOBE
  ===================================================== */

  function focusLocation(
    lat,
    lng,
    altitude,
    duration = 1200
  ) {

    if (!globe) return;

    globe.pointOfView(
      {
        lat,
        lng,
        altitude
      },
      duration
    );

  }


  /* =====================================================
     WORLD → INDIA
  ===================================================== */

  function enterIndia() {

    mode =
      "india";

    selectedState =
      "Tamil Nadu";

    selectedDistrict =
      "";


    mapTitle.textContent =
      "India";


    locationLabel.textContent =
      "India · Tamil Nadu";


    locationCount.textContent =
      `${visiblePeople.length} PSGians`;


    backButton.classList.remove(
      "hidden"
    );


    focusLocation(
      20.5937,
      78.9629,
      1.7
    );

  }


  /* =====================================================
     INDIA → TAMIL NADU
  ===================================================== */

  function enterTamilNadu() {

    mode =
      "tamilNadu";

    selectedState =
      "Tamil Nadu";

    selectedDistrict =
      "";


    mapTitle.textContent =
      "Tamil Nadu";


    locationLabel.textContent =
      "Tamil Nadu · Explore districts";


    backButton.classList.remove(
      "hidden"
    );


    focusLocation(
      11.1271,
      78.6569,
      0.75
    );


    renderPeople();

  }


  /* =====================================================
     BACK
  ===================================================== */

  backButton.addEventListener(
    "click",
    () => {

      if (
        mode === "tamilNadu"
      ) {

        mode =
          "india";

        selectedDistrict =
          "";

        mapTitle.textContent =
          "India";

        locationLabel.textContent =
          "India · Tamil Nadu";


        focusLocation(
          20.5937,
          78.9629,
          1.7
        );


        renderPeople();

        return;

      }


      if (
        mode === "india"
      ) {

        mode =
          "world";

        selectedState =
          "";

        selectedDistrict =
          "";


        mapTitle.textContent =
          "World";


        locationLabel.textContent =
          "Explore the world";


        backButton.classList.add(
          "hidden"
        );


        focusLocation(
          20,
          0,
          2.4
        );


        renderPeople();

      }

    }
  );


  /* =====================================================
     SEARCH
  ===================================================== */

  searchInput.addEventListener(
    "input",
    renderPeople
  );


  citySelect.addEventListener(
    "change",
    renderPeople
  );


  departmentSelect.addEventListener(
    "change",
    renderPeople
  );


  expertiseSelect.addEventListener(
    "change",
    renderPeople
  );


  /* =====================================================
     CATEGORY
  ===================================================== */

  categoryChips.addEventListener(
    "click",
    event => {

      const button =
        event.target.closest(
          "[data-category]"
        );


      if (!button) {
        return;
      }


      selectedCategory =
        button.dataset.category;


      categoryChips
        .querySelectorAll(
          ".category-chip"
        )
        .forEach(
          chip => {

            chip.classList.toggle(
              "active",
              chip === button
            );

          }
        );


      renderPeople();

    }
  );


  /* =====================================================
     RESET
  ===================================================== */

  resetButton.addEventListener(
    "click",
    () => {

      searchInput.value =
        "";

      citySelect.value =
        "";

      departmentSelect.value =
        "";

      expertiseSelect.value =
        "";


      selectedCategory =
        "";

      selectedState =
        "";

      selectedDistrict =
        "";


      categoryChips
        .querySelectorAll(
          ".category-chip"
        )
        .forEach(
          (chip, index) => {

            chip.classList.toggle(
              "active",
              index === 0
            );

          }
        );


      mode =
        "world";


      mapTitle.textContent =
        "World";


      locationLabel.textContent =
        "Explore the world";


      backButton.classList.add(
        "hidden"
      );


      personDetails.classList.add(
        "hidden"
      );


      focusLocation(
        20,
        0,
        2.4
      );


      renderPeople();

    }
  );


  /* =====================================================
     MAP INTERACTION
  ===================================================== */

  container.addEventListener(
    "dblclick",
    event => {

      event.preventDefault();

    }
  );


  /* =====================================================
     INITIALIZE GLOBE AFTER CDN LOAD
  ===================================================== */

  function startGlobe() {

    globeLoading.classList.remove("hidden");
    loadingText.textContent = "Loading globe...";

    const existing = window.Globe;

    if (existing) {
      buildGlobe(existing);
      finishGlobeLoading();
      return;
    }

    const script = document.createElement("script");
    script.src = "https://unpkg.com/globe.gl@2.43.0/dist/globe.gl.min.js";
    script.async = true;

    script.onload = () => {
      if (!window.Globe) {
        showGlobeError();
        return;
      }

      buildGlobe(window.Globe);
      finishGlobeLoading();
    };

    script.onerror = () => {
      // Fallback CDN
      const fallback = document.createElement("script");
      fallback.src = "https://cdn.jsdelivr.net/npm/globe.gl@2.43.0/dist/globe.gl.min.js";
      fallback.async = true;

      fallback.onload = () => {
        if (!window.Globe) {
          showGlobeError();
          return;
        }

        buildGlobe(window.Globe);
        finishGlobeLoading();
      };

      fallback.onerror = showGlobeError;
      document.head.appendChild(fallback);
    };

    document.head.appendChild(script);
  }


  function finishGlobeLoading() {

    globe.pointOfView(
      {
        lat: 20,
        lng: 0,
        altitude: 2.4
      },
      0
    );

    renderPeople();

    const resizeGlobe = () => {
      if (!globe) return;

      globe.width(container.clientWidth);
      globe.height(container.clientHeight);
    };

    window.addEventListener("resize", resizeGlobe);

    requestAnimationFrame(() => {
      resizeGlobe();
    });

    setTimeout(() => {
      globeLoading.classList.add("hidden");
    }, 500);
  }


  function showGlobeError() {

    loadingText.textContent = "Map could not load";

    console.error("Globe.gl could not be loaded from the CDN.");
  }


  startGlobe();

</script>



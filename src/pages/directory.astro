<div class="directory">

  <header class="directory-header">

    <div>
      <h1>Tamil Nadu Directory</h1>

      <p>
        Click any district on the map to view people.
      </p>
    </div>

    <div class="stats">

      <div class="stat">
        <strong>38</strong>
        <span>Districts</span>
      </div>

      <div class="stat">
        <strong>{people.length}</strong>
        <span>People</span>
      </div>

    </div>

  </header>


  <div class="directory-layout">

    <!-- LEFT -->
    <aside class="sidebar">

      <div class="search-box">

        <input
          id="personSearch"
          type="search"
          placeholder="Search person, city..."
        />

      </div>


      <div class="selected-box">

        <small>SELECTED DISTRICT</small>

        <strong id="selectedDistrict">
          All Tamil Nadu
        </strong>

      </div>


      <div class="city-box">

        <label for="citySelect">
          City
        </label>

        <select id="citySelect">

          <option value="">
            All Cities
          </option>

          {
            cities.map((city) => (
              <option value={city}>
                {city}
              </option>
            ))
          }

        </select>

      </div>


      <div class="results-title">

        <span id="resultCount">
          {people.length}
        </span>

        people found

      </div>


      <div
        id="peopleList"
        class="people-list"
      >

        {
          people.map((person) => (

            <button
              class="person-card"
              data-id={person.id}
              data-name={person.name}
              data-district={person.district}
              data-city={person.city}
              data-category={person.category}
            >

              <div class="avatar">
                {person.name.charAt(0)}
              </div>

              <div class="person-info">

                <strong>
                  {person.name}
                </strong>

                <span>
                  {person.category}
                </span>

                <small>
                  {person.city}
                </small>

              </div>

            </button>

          ))
        }

      </div>

    </aside>


    <!-- MAP -->
    <main class="map-panel">

      <div class="map-header">

        <div>

          <strong>
            Tamil Nadu
          </strong>

          <span id="mapHint">
            Click a district
          </span>

        </div>

        <button id="resetMap">
          Reset
        </button>

      </div>


      <div
        id="map"
        class="map"
      >

        <div
          id="mapLoading"
          class="map-loading"
        >
          Loading Tamil Nadu map...
        </div>

      </div>

    </main>


    <!-- RIGHT -->
    <aside class="details-panel">

      <div
        id="emptyDetails"
        class="empty-details"
      >

        <div class="empty-icon">
          👤
        </div>

        <h2>
          Select a person
        </h2>

        <p>
          Click a person from the list
          to see complete information.
        </p>

      </div>


      <div
        id="personDetails"
        class="person-details hidden"
      >

        <div
          id="detailAvatar"
          class="detail-avatar"
        >
          A
        </div>


        <h2 id="detailName">
          Person
        </h2>


        <div
          id="detailCategory"
          class="detail-category"
        >
          Category
        </div>


        <div class="detail-row">
          <small>District</small>
          <strong id="detailDistrict"></strong>
        </div>


        <div class="detail-row">
          <small>City</small>
          <strong id="detailCity"></strong>
        </div>


        <div class="detail-row">
          <small>Company</small>
          <strong id="detailCompany"></strong>
        </div>


        <div class="detail-row">
          <small>Phone</small>
          <strong id="detailPhone"></strong>
        </div>


        <div class="detail-row">
          <small>Email</small>
          <strong id="detailEmail"></strong>
        </div>


        <div class="about">

          <small>
            About
          </small>

          <p id="detailDescription"></p>

        </div>

      </div>

    </aside>

  </div>

</div>


<script define:vars={{ people }}>

  /*
   * ==================================================
   * ELEMENTS
   * ==================================================
   */

  const map =
    document.getElementById("map");

  const mapLoading =
    document.getElementById("mapLoading");

  const selectedDistrict =
    document.getElementById("selectedDistrict");

  const peopleList =
    document.getElementById("peopleList");

  const resultCount =
    document.getElementById("resultCount");

  const searchInput =
    document.getElementById("personSearch");

  const citySelect =
    document.getElementById("citySelect");

  const resetButton =
    document.getElementById("resetMap");

  const emptyDetails =
    document.getElementById("emptyDetails");

  const personDetails =
    document.getElementById("personDetails");

  const detailAvatar =
    document.getElementById("detailAvatar");

  const detailName =
    document.getElementById("detailName");

  const detailCategory =
    document.getElementById("detailCategory");

  const detailDistrict =
    document.getElementById("detailDistrict");

  const detailCity =
    document.getElementById("detailCity");

  const detailCompany =
    document.getElementById("detailCompany");

  const detailPhone =
    document.getElementById("detailPhone");

  const detailEmail =
    document.getElementById("detailEmail");

  const detailDescription =
    document.getElementById("detailDescription");


  /*
   * ==================================================
   * STATE
   * ==================================================
   */

  let geojson = null;

  let currentDistrict = "";


  /*
   * ==================================================
   * NORMALIZE DISTRICT
   * ==================================================
   */

  function normalizeDistrict(value) {

    if (!value) return "";

    let name =
      String(value)
        .toLowerCase()
        .trim();

    name =
      name.replace(
        /\bdistrict\b/g,
        ""
      ).trim();

    const aliases = {

      "trichy":
        "tiruchirappalli",

      "tiruchirapalli":
        "tiruchirappalli",

      "tiruchirappalli":
        "tiruchirappalli",

      "thiruvallur":
        "tiruvallur",

      "tiruvallur":
        "tiruvallur",

      "kanchipuram":
        "kancheepuram",

      "kancheepuram":
        "kancheepuram",

      "nilgiris":
        "nilgiris",

      "the nilgiris":
        "nilgiris",

      "kanniyakumari":
        "kanyakumari",

      "kanyakumari":
        "kanyakumari",

      "sivagangai":
        "sivaganga",

      "sivaganga":
        "sivaganga",

      "villupuram":
        "viluppuram",

      "viluppuram":
        "viluppuram",

      "thoothukudi":
        "thoothukudi"

    };

    return (
      aliases[name] ||
      name
    );

  }


  /*
   * ==================================================
   * GET GEOJSON DISTRICT NAME
   * ==================================================
   */

  function getDistrictName(feature) {

    const p =
      feature.properties || {};

    return (
      p.district_name ||
      p.DISTRICT ||
      p.District ||
      p.district ||
      p.DTNAME ||
      p.dtname ||
      p.DIST_NAME ||
      p.NAME_2 ||
      p.NAME ||
      p.name ||
      p.REGNAME ||
      ""
    );

  }


  /*
   * ==================================================
   * GEOMETRY WALK
   * ==================================================
   */

  function walkCoordinates(
    coordinates,
    callback
  ) {

    if (
      typeof coordinates[0] ===
      "number"
    ) {

      callback(coordinates);

      return;
    }

    coordinates.forEach(
      item =>
        walkCoordinates(
          item,
          callback
        )
    );

  }


  /*
   * ==================================================
   * FIND GEOJSON BOUNDS
   * ==================================================
   */

  function getBounds() {

    let minLon = Infinity;
    let minLat = Infinity;
    let maxLon = -Infinity;
    let maxLat = -Infinity;


    geojson.features.forEach(
      feature => {

        walkCoordinates(
          feature.geometry.coordinates,
          coordinate => {

            minLon =
              Math.min(
                minLon,
                coordinate[0]
              );

            maxLon =
              Math.max(
                maxLon,
                coordinate[0]
              );

            minLat =
              Math.min(
                minLat,
                coordinate[1]
              );

            maxLat =
              Math.max(
                maxLat,
                coordinate[1]
              );

          }
        );

      }
    );


    return {
      minLon,
      minLat,
      maxLon,
      maxLat
    };

  }


  /*
   * ==================================================
   * CREATE MAP
   * ==================================================
   */

  function renderMap() {

    if (!geojson) return;


    map.innerHTML = "";


    const svgNS =
      "http://www.w3.org/2000/svg";


    const svg =
      document.createElementNS(
        svgNS,
        "svg"
      );


    svg.setAttribute(
      "viewBox",
      "0 0 1000 1000"
    );


    svg.setAttribute(
      "preserveAspectRatio",
      "xMidYMid meet"
    );


    svg.classList.add(
      "tn-map-svg"
    );


    /*
     * Get bounds
     */

    const bounds =
      getBounds();


    const lonWidth =
      bounds.maxLon -
      bounds.minLon;

    const latHeight =
      bounds.maxLat -
      bounds.minLat;


    const padding = 30;


    /*
     * Keep correct aspect ratio
     */

    const scaleX =
      (1000 - padding * 2) /
      lonWidth;

    const scaleY =
      (1000 - padding * 2) /
      latHeight;

    const scale =
      Math.min(
        scaleX,
        scaleY
      );


    const actualWidth =
      lonWidth * scale;

    const actualHeight =
      latHeight * scale;


    const offsetX =
      (1000 - actualWidth) / 2;

    const offsetY =
      (1000 - actualHeight) / 2;


    /*
     * Convert longitude/latitude
     * to SVG coordinates.
     */

    function project(
      coordinate
    ) {

      const lon =
        coordinate[0];

      const lat =
        coordinate[1];


      const x =
        offsetX +
        (lon - bounds.minLon) *
        scale;


      const y =
        offsetY +
        (bounds.maxLat - lat) *
        scale;


      return [
        x,
        y
      ];

    }


    /*
     * Polygon to path
     */

    function ringToPath(
      ring
    ) {

      let d = "";


      ring.forEach(
        (coordinate, index) => {

          const [
            x,
            y
          ] =
            project(
              coordinate
            );


          if (index === 0) {

            d +=
              `M ${x} ${y}`;

          } else {

            d +=
              ` L ${x} ${y}`;

          }

        }
      );


      d += " Z";


      return d;

    }


    /*
     * Geometry to SVG path
     */

    function geometryToPath(
      geometry
    ) {

      if (
        geometry.type ===
        "Polygon"
      ) {

        return geometry.coordinates
          .map(
            ring =>
              ringToPath(ring)
          )
          .join(" ");

      }


      if (
        geometry.type ===
        "MultiPolygon"
      ) {

        return geometry.coordinates
          .map(
            polygon =>
              polygon
                .map(
                  ring =>
                    ringToPath(ring)
                )
                .join(" ")
          )
          .join(" ");

      }


      return "";

    }


    /*
     * Draw each district
     */

    geojson.features.forEach(
      feature => {

        const rawName =
          getDistrictName(
            feature
          );


        const district =
          normalizeDistrict(
            rawName
          );


        const path =
          document.createElementNS(
            svgNS,
            "path"
          );


        path.setAttribute(
          "d",
          geometryToPath(
            feature.geometry
          )
        );


        path.dataset.district =
          district;


        path.dataset.name =
          rawName;


        const isSelected =
          currentDistrict &&
          district ===
            normalizeDistrict(
              currentDistrict
            );


        path.setAttribute(
          "fill",
          isSelected
            ? "#2563eb"
            : "#bfdbfe"
        );


        path.setAttribute(
          "stroke",
          "#ffffff"
        );


        path.setAttribute(
          "stroke-width",
          "2"
        );


        path.classList.add(
          "district"
        );


        /*
         * Tooltip
         */

        const title =
          document.createElementNS(
            svgNS,
            "title"
          );


        title.textContent =
          rawName;


        path.appendChild(
          title
        );


        /*
         * Mouse enter
         */

        path.addEventListener(
          "mouseenter",
          () => {

            path.setAttribute(
              "fill",
              "#60a5fa"
            );

          }
        );


        /*
         * Mouse leave
         */

        path.addEventListener(
          "mouseleave",
          () => {

            const selected =
              currentDistrict &&
              district ===
                normalizeDistrict(
                  currentDistrict
                );


            path.setAttribute(
              "fill",
              selected
                ? "#2563eb"
                : "#bfdbfe"
            );

          }
        );


        /*
         * CLICK DISTRICT
         */

        path.addEventListener(
          "click",
          event => {

            event.stopPropagation();

            selectDistrict(
              rawName
            );

          }
        );


        svg.appendChild(
          path
        );

      }
    );


    map.appendChild(
      svg
    );


    /*
     * Add district labels
     */

    geojson.features.forEach(
      feature => {

        const name =
          getDistrictName(
            feature
          );


        if (!name) return;


        /*
         * Use average coordinate
         * for simple label placement.
         */

        const points = [];


        walkCoordinates(
          feature.geometry.coordinates,
          coordinate => {

            points.push(
              coordinate
            );

          }
        );


        if (!points.length)
          return;


        let lon = 0;
        let lat = 0;


        points.forEach(
          point => {

            lon += point[0];
            lat += point[1];

          }
        );


        lon /= points.length;
        lat /= points.length;


        const [
          x,
          y
        ] =
          project([
            lon,
            lat
          ]);


        const text =
          document.createElementNS(
            svgNS,
            "text"
          );


        text.setAttribute(
          "x",
          x
        );


        text.setAttribute(
          "y",
          y
        );


        text.setAttribute(
          "text-anchor",
          "middle"
        );


        text.setAttribute(
          "class",
          "district-label"
        );


        text.textContent =
          name;


        /*
         * Don't allow label
         * to block clicks.
         */

        text.style.pointerEvents =
          "none";


        svg.appendChild(
          text
        );

      }
    );

  }


  /*
   * ==================================================
   * SELECT DISTRICT
   * ==================================================
   */

  function selectDistrict(
    district
  ) {

    currentDistrict =
      district;


    selectedDistrict.textContent =
      district;


    document.getElementById(
      "mapHint"
    ).textContent =
      `${district} selected`;


    renderMap();

    filterPeople();

  }


  /*
   * ==================================================
   * FILTER PEOPLE
   * ==================================================
   */

  function filterPeople() {

    const search =
      searchInput.value
        .toLowerCase()
        .trim();


    const city =
      citySelect.value
        .toLowerCase()
        .trim();


    const cards =
      peopleList.querySelectorAll(
        ".person-card"
      );


    let visible = 0;


    cards.forEach(
      card => {

        const name =
          card.dataset.name
            .toLowerCase();


        const district =
          card.dataset.district
            .toLowerCase();


        const cardCity =
          card.dataset.city
            .toLowerCase();


        const category =
          card.dataset.category
            .toLowerCase();


        const districtMatch =
          !currentDistrict ||
          normalizeDistrict(
            card.dataset.district
          ) ===
          normalizeDistrict(
            currentDistrict
          );


        const searchMatch =
          !search ||
          name.includes(search) ||
          district.includes(search) ||
          cardCity.includes(search) ||
          category.includes(search);


        const cityMatch =
          !city ||
          cardCity === city;


        const visibleCard =
          districtMatch &&
          searchMatch &&
          cityMatch;


        card.style.display =
          visibleCard
            ? "flex"
            : "none";


        if (visibleCard) {
          visible++;
        }

      }
    );


    resultCount.textContent =
      visible;

  }


  /*
   * ==================================================
   * SHOW PERSON
   * ==================================================
   */

  function showPerson(
    id
  ) {

    const person =
      people.find(
        item =>
          String(item.id) ===
          String(id)
      );


    if (!person) return;


    emptyDetails.classList.add(
      "hidden"
    );


    personDetails.classList.remove(
      "hidden"
    );


    detailAvatar.textContent =
      person.name.charAt(0);


    detailName.textContent =
      person.name;


    detailCategory.textContent =
      person.category;


    detailDistrict.textContent =
      person.district;


    detailCity.textContent =
      person.city;


    detailCompany.textContent =
      person.company;


    detailPhone.textContent =
      person.phone;


    detailEmail.textContent =
      person.email;


    detailDescription.textContent =
      person.description;

  }


  /*
   * ==================================================
   * PERSON CLICK
   * ==================================================
   */

  peopleList
    .querySelectorAll(
      ".person-card"
    )
    .forEach(
      card => {

        card.addEventListener(
          "click",
          () => {

            showPerson(
              card.dataset.id
            );

          }
        );

      }
    );


  /*
   * ==================================================
   * SEARCH
   * ==================================================
   */

  searchInput.addEventListener(
    "input",
    filterPeople
  );


  /*
   * ==================================================
   * CITY
   * ==================================================
   */

  citySelect.addEventListener(
    "change",
    filterPeople
  );


  /*
   * ==================================================
   * RESET
   * ==================================================
   */

  resetButton.addEventListener(
    "click",
    () => {

      currentDistrict = "";

      selectedDistrict.textContent =
        "All Tamil Nadu";


      document.getElementById(
        "mapHint"
      ).textContent =
        "Click a district";


      searchInput.value = "";

      citySelect.value = "";


      filterPeople();

      renderMap();

    }
  );


  /*
   * ==================================================
   * LOAD REAL TAMIL NADU GEOJSON
   * ==================================================
   */

  async function loadMap() {

    try {

      /*
       * Tamil Nadu district GeoJSON.
       *
       * This dataset contains state-level
       * maps with district boundaries.
       */

      const url =
        "https://cdn.jsdelivr.net/gh/udit-001/india-maps-data@2884453/geojson/states/tamil-nadu.geojson";


      const response =
        await fetch(url);


      if (!response.ok) {

        throw new Error(
          `HTTP ${response.status}`
        );

      }


      geojson =
        await response.json();


      console.log(
        "Tamil Nadu GeoJSON:",
        geojson
      );


      console.log(
        "District features:",
        geojson.features?.length
      );


      if (
        !geojson.features ||
        !geojson.features.length
      ) {

        throw new Error(
          "No district features found."
        );

      }


      mapLoading?.remove();


      renderMap();

    }
    catch (error) {

      console.error(
        "Tamil Nadu map error:",
        error
      );


      if (mapLoading) {

        mapLoading.innerHTML = `
          <div>
            <strong>Map loading failed</strong>
            <br />
            <small>
              Open browser Console (F12)
              to see the error.
            </small>
          </div>
        `;

      }

    }

  }


  /*
   * ==================================================
   * START
   * ==================================================
   */

  filterPeople();

  loadMap();


  /*
   * ==================================================
   * RESIZE
   * ==================================================
   */

  window.addEventListener(
    "resize",
    () => {

      if (geojson) {
        renderMap();
      }

    }
  );

</script>



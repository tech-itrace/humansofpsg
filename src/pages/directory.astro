const cities = [
  ...new Set(
    people.map(person => person.city)
  )
].sort();


const departments = [
  ...new Set(
    people.map(person => person.department)
  )
].sort();


const expertise = [
  ...new Set(
    people.map(person => person.expertise)
  )
].sort();


function initial(name) {
  return name
    .split(" ")
    .map(word => word[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();
}


function getMapX(lng) {
  const minLng = 76.0;
  const maxLng = 80.5;

  return Math.max(
    3,
    Math.min(
      97,
      ((lng - minLng) /
        (maxLng - minLng)) * 100
    )
  );
}


function getMapY(lat) {
  const minLat = 8.0;
  const maxLat = 13.7;

  return Math.max(
    3,
    Math.min(
      97,
      100 -
        ((lat - minLat) /
          (maxLat - minLat)) * 100
    )
  );
}

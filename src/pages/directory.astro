<div class="world-directory">

  <!-- ================= SIDEBAR ================= -->
  <aside class="sidebar">

    <div class="brand">
      <div class="brand-icon">🌍</div>

      <div>
        <h1>World Directory</h1>
        <p>Global People Network</p>
      </div>
    </div>

    <div class="stats">
      <div class="stat">
        <strong>195</strong>
        <span>Countries</span>
      </div>

      <div class="stat">
        <strong>{people.length}</strong>
        <span>People</span>
      </div>
    </div>

    <!-- SEARCH -->
    <div class="search-box">
      <span>⌕</span>
      <input
        id="personSearch"
        type="search"
        placeholder="Search people..."
      />
    </div>

    <!-- CITY -->
    <select id="citySelect" class="city-select">
      <option value="">All Cities</option>

      {cities.map((city) => (
        <option value={city}>{city}</option>
      ))}
    </select>

    <!-- CATEGORY -->
    <div class="filter-title">Category</div>

    <div id="chips" class="chips">
      <button class="chip active" data-category="">
        All
      </button>

      {categories.map((category) => (
        <button
          class="chip"
          data-category={category}
        >
          {category}
        </button>
      ))}
    </div>

    <!-- LIST HEADER -->
    <div class="list-header">

      <div>
        <span id="selectedCountry">All Countries</span>
        <small id="selectedDistrict"></small>
      </div>

      <strong id="resultCount">{people.length}</strong>

    </div>

    <!-- PEOPLE -->
    <div id="peopleList" class="people-list">

      {people.map((person) => (
        <button
          class="person-row"
          data-id={person.id}
          data-country={person.country}
          data-district={person.district}
          data-city={person.city}
          data-category={person.category}
          data-search={`${person.name} ${person.company} ${person.city} ${person.district} ${person.category}`}
        >

          <div class="avatar">
            {person.name.charAt(0)}
          </div>

          <div class="person-info">
            <strong>{person.name}</strong>

            <span>
              {person.category}
              <span class="dot">•</span>
              {person.city}
            </span>
          </div>

          <span class="arrow">›</span>

        </button>
      ))}

    </div>

    <div id="emptyState" class="empty-state">
      <div class="empty-icon">⌕</div>

      <strong>No one matches</strong>

      <p>
        Try another district, clear the search, or choose "All".
      </p>
    </div>

  </aside>


  <!-- ================= MAP ================= -->

  <main class="map-stage">

    <div class="map-topbar">

      <div>
        <div id="mapTitle" class="map-title">
          World Map
        </div>

        <div id="hoverName" class="hover-name">
          Click India to explore Tamil Nadu
        </div>
      </div>

      <div class="map-actions">

        <button id="backWorld" class="map-btn hidden">
          ← World
        </button>

        <button id="resetMap" class="map-btn">
          Reset
        </button>

      </div>

    </div>


    <div id="map" class="map">

      <div id="mapLoading" class="map-loading">
        <div class="spinner"></div>
        Loading map...
      </div>

      <svg
        id="mapSvg"
        viewBox="0 0 1200 650"
        preserveAspectRatio="xMidYMid meet"
      ></svg>

    </div>


    <!-- LEGEND -->
    <div class="legend">

      <span>
        <i class="legend-box none"></i>
        No people
      </span>

      <span>
        <i class="legend-box one"></i>
        1 person
      </span>

      <span>
        <i class="legend-box many"></i>
        2 or more
      </span>

    </div>


    <div id="mapHint" class="map-hint">
      Click India to explore Tamil Nadu districts
    </div>


    <!-- ================= PERSON DETAILS ================= -->

    <section id="personDetails" class="details-card hidden">

      <button id="closeDetails" class="close-details">

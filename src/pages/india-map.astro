  </aside>



  <!-- =====================================================
       GLOBE
  ====================================================== -->

  <main class="globe-panel">


    <div id="globe"></div>


    <div class="globe-title">

      <h2>
        Interactive World
      </h2>

      <p>
        Drag to rotate • Scroll to zoom • Click a country
      </p>

    </div>


    <div class="globe-controls">

      <button
        class="globe-control"
        id="zoomIn"
      >
        +
      </button>


      <button
        class="globe-control"
        id="zoomOut"
      >
        −
      </button>

    </div>


    <div
      class="loading"
      id="loading"
    >

      <div class="loading-content">

        <div class="loader"></div>

        <div id="loadingText">
          Loading 3D world...
        </div>

      </div>

    </div>

  </main>



  <!-- =====================================================
       RIGHT
  ====================================================== -->

  <aside class="right-panel">


    <div
      class="details-empty"
      id="detailsEmpty"
    >
      Click a country or PSG location
    </div>


    <div
      class="details"
      id="details"
    >


      <div
        class="country-badge"
        id="detailCountry"
      >
        LOCATION
      </div>


      <h2 id="detailName">
        -
      </h2>


      <div
        class="details-role"
        id="detailRole"
      >
        -
      </div>


      <div class="details-divider"></div>


      <div class="detail-row">

        <div class="detail-label">
          Branch
        </div>

        <div
          class="detail-value"
          id="detailBranch"
        >
          -
        </div>

      </div>


      <div class="detail-row">

        <div class="detail-label">
          Address
        </div>

        <div
          class="detail-value"
          id="detailAddress"
        >
          -
        </div>

      </div>


      <div class="detail-row">

        <div class="detail-label">
          Phone
        </div>

        <div
          class="detail-value"
          id="detailPhone"
        >
          -
        </div>

      </div>


      <div class="detail-row">

        <div class="detail-label">
          Email
        </div>

        <div
          class="detail-value"
          id="detailEmail"
        >
          -
        </div>

      </div>


      <button
        class="focus-btn"
        id="focusBtn"
      >
        Focus on Globe
      </button>


    </div>

  </aside>


</div>




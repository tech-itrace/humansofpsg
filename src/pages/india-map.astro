<!doctype html>
<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>PSG World</title>

  <style>

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;

      font-family:
        Inter,
        Arial,
        Helvetica,
        sans-serif;

      background: #02070d;
      color: #fff;
    }


    /* =====================================================
       APP
    ===================================================== */

    .app {
      width: 100vw;
      height: 100vh;

      display: grid;

      grid-template-columns:
        280px
        minmax(0, 1fr)
        310px;

      grid-template-rows:
        60px
        minmax(0, 1fr);

      background:
        radial-gradient(
          circle at center,
          #0a1824 0%,
          #030a11 48%,
          #010407 100%
        );
    }


    /* =====================================================
       TOP BAR
    ===================================================== */

    .topbar {

      grid-column: 1 / 4;

      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 0 20px;

      background:
        rgba(2, 8, 14, 0.97);

      border-bottom:
        1px solid rgba(255,255,255,.08);

      z-index: 20;
    }


    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }


    .brand-globe {

      width: 34px;
      height: 34px;

      border-radius: 50%;

      display: flex;
      align-items: center;
      justify-content: center;

      background:
        linear-gradient(
          135deg,
          #ff9b25,
          #ff5c18
        );

      box-shadow:
        0 0 18px
        rgba(255,105,20,.45);

      font-size: 18px;
    }


    .brand-text {

      font-size: 18px;
      font-weight: 800;

      letter-spacing: 1px;
    }


    .brand-sub {

      font-size: 11px;

      color: #6f8496;

      margin-left: 8px;

      letter-spacing: 1px;
    }


    .top-actions {

      display: flex;
      align-items: center;

      gap: 8px;
    }


    .top-btn {

      border:
        1px solid
        rgba(255,255,255,.1);

      background:
        rgba(255,255,255,.035);

      color: #b9c8d4;

      padding: 8px 13px;

      border-radius: 7px;

      cursor: pointer;

      font-size: 12px;

      transition: .2s;
    }


    .top-btn:hover {

      background:
        rgba(255,130,30,.12);

      border-color:
        rgba(255,130,30,.4);

      color: #fff;
    }


    /* =====================================================
       LEFT PANEL
    ===================================================== */

    .left-panel {

      grid-column: 1;
      grid-row: 2;

      background:
        rgba(3,11,18,.97);

      border-right:
        1px solid
        rgba(255,255,255,.07);

      display: flex;

      flex-direction: column;

      min-height: 0;

      z-index: 10;
    }


    .panel-heading {

      padding:
        20px 18px 10px;
    }


    .panel-title {

      font-size: 20px;

      font-weight: 800;

      letter-spacing: .5px;
    }


    .panel-subtitle {

      color: #637888;

      font-size: 11px;

      margin-top: 5px;
    }


    /* =====================================================
       COUNTRY SELECTED
    ===================================================== */

    .country-box {

      padding:
        8px 14px 4px;
    }


    .country-label {

      color: #566e7c;

      font-size: 9px;

      text-transform: uppercase;

      letter-spacing: 1px;

      margin-bottom: 6px;
    }


    .country-selected {

      width: 100%;

      padding: 9px 10px;

      border:
        1px solid
        rgba(255,117,24,.4);

      border-radius: 6px;

      background:
        rgba(255,117,24,.10);

      color: #ff974e;

      font-size: 11px;

      text-align: left;

      cursor: pointer;

      transition: .2s;
    }


    .country-selected:hover {

      background:
        rgba(255,117,24,.16);
    }


    /* =====================================================
       SEARCH
    ===================================================== */

    .search-wrap {

      padding:
        10px 14px 12px;
    }


    .search {

      width: 100%;

      border:
        1px solid
        rgba(255,255,255,.1);

      outline: none;

      background: #07131d;

      color: #fff;

      border-radius: 7px;

      padding: 11px 12px;

      font-size: 12px;
    }


    .search::placeholder {

      color: #506674;
    }


    .search:focus {

      border-color:
        rgba(255,125,20,.65);

      box-shadow:
        0 0 0 2px
        rgba(255,125,20,.08);
    }


    .location-count {

      padding:
        0 16px 8px;

      font-size: 10px;

      color: #607586;

      text-transform: uppercase;

      letter-spacing: 1px;
    }


    /* =====================================================
       LOCATION LIST
    ===================================================== */

    .locations {

      flex: 1;

      min-height: 0;

      overflow-y: auto;

      padding:
        0 8px 14px;
    }


    .locations::-webkit-scrollbar {
      width: 5px;
    }


    .locations::-webkit-scrollbar-thumb {

      background: #20303c;

      border-radius: 20px;
    }


    /* IMPORTANT:
       Reset browser button appearance
    */

    .location-item {

      appearance: none;
      -webkit-appearance: none;

      width: 100%;

      border:
        1px solid transparent;

      background:
        rgba(255,255,255,.015);

      color: #dbe4ea;

      padding: 10px;

      margin-bottom: 4px;

      border-radius: 7px;

      cursor: pointer;

      text-align: left;

      display: flex;

      gap: 10px;

      align-items: center;

      transition: .2s;

      font-family: inherit;

      outline: none;
    }


    .location-item:hover {

      background:
        rgba(255,255,255,.055);

      border-color:
        rgba(255,255,255,.08);
    }


    .location-item.active {

      background:
        rgba(255,103,20,.12);

      border-color:
        rgba(255,112,25,.45);
    }


    .location-dot {

      width: 9px;
      height: 9px;

      flex:
        0 0 9px;

      background:
        #ff7518;

      border-radius: 50%;

      box-shadow:
        0 0 7px
        rgba(255,117,24,.9);
    }


    .location-name {

      font-size: 12px;

      font-weight: 700;

      color: #e2e9ee;
    }


    .location-meta {

      color: #647b8b;

      font-size: 10px;

      margin-top: 3px;
    }


    .empty-list {

      padding: 25px 15px;

      text-align: center;

      color: #607586;

      font-size: 11px;

      line-height: 1.6;
    }


    /* =====================================================
       GLOBE
    ===================================================== */

    .globe-panel {

      grid-column: 2;
      grid-row: 2;

      position: relative;

      min-width: 0;
      min-height: 0;

      overflow: hidden;

      background:
        radial-gradient(
          circle at 50% 48%,
          rgba(16,47,68,.32),
          rgba(1,6,10,.95) 65%
        );
    }


    #globe {

      position: absolute;

      inset: 0;

      width: 100%;
      height: 100%;
    }


    #globe canvas {

      display: block;

      width: 100% !important;

      height: 100% !important;
    }


    .globe-title {

      position: absolute;

      left: 18px;
      top: 18px;

      z-index: 5;

      pointer-events: none;
    }


    .globe-title h2 {

      margin: 0;

      font-size: 13px;

      color: #d5e1e8;

      font-weight: 700;
    }


    .globe-title p {

      margin: 4px 0 0;

      color: #607889;

      font-size: 10px;
    }


    .globe-controls {

      position: absolute;

      right: 15px;
      bottom: 15px;

      display: flex;

      gap: 6px;

      z-index: 5;
    }


    .globe-control {

      width: 36px;
      height: 32px;

      border:
        1px solid
        rgba(255,255,255,.1);

      background:
        rgba(2,9,15,.78);

      color: #a9bac6;

      border-radius: 6px;

      cursor: pointer;

      font-size: 13px;
    }


    .globe-control:hover {

      color: #fff;

      border-color:
        rgba(255,117,24,.5);
    }


    /* =====================================================
       LOADING
    ===================================================== */

    .loading {

      position: absolute;

      inset: 0;

      display: flex;

      align-items: center;

      justify-content: center;

      z-index: 10;

      background: #02070d;

      color: #8498a6;

      font-size: 13px;
    }


    .loading.hidden {
      display: none;
    }


    .loading-content {
      text-align: center;
    }


    .loader {

      width: 34px;
      height: 34px;

      border-radius: 50%;

      border:
        3px solid
        rgba(255,255,255,.1);

      border-top-color:
        #ff7418;

      animation:
        spin .8s linear infinite;

      margin:
        0 auto 12px;
    }


    @keyframes spin {

      to {
        transform: rotate(360deg);
      }

    }


    /* =====================================================
       RIGHT PANEL
    ===================================================== */

    .right-panel {

      grid-column: 3;
      grid-row: 2;

      background:
        rgba(3,11,18,.97);

      border-left:
        1px solid
        rgba(255,255,255,.07);

      padding: 20px;

      overflow-y: auto;

      z-index: 10;
    }


    .details-empty {

      height: 100%;

      min-height: 300px;

      display: flex;

      align-items: center;

      justify-content: center;

      text-align: center;

      color: #506674;

      font-size: 12px;

      line-height: 1.6;
    }


    .details {
      display: none;
    }


    .details.show {
      display: block;
    }


    .country-badge {

      display: inline-flex;

      padding: 5px 8px;

      background:
        rgba(255,108,20,.1);

      color: #ff8a3d;

      border:
        1px solid
        rgba(255,108,20,.2);

      border-radius: 5px;

      font-size: 9px;

      font-weight: 800;

      letter-spacing: 1px;

      text-transform: uppercase;

      margin-bottom: 12px;
    }


    .details h2 {

      margin: 0;

      font-size: 22px;

      line-height: 1.2;
    }


    .details-role {

      margin-top: 5px;

      color: #738896;

      font-size: 11px;
    }


    .details-divider {

      height: 1px;

      background:
        rgba(255,255,255,.07);

      margin: 18px 0;
    }


    .detail-row {

      margin-bottom: 16px;
    }


    .detail-label {

      color: #566e7c;

      font-size: 9px;

      text-transform: uppercase;

      letter-spacing: 1px;

      margin-bottom: 5px;
    }


    .detail-value {

      color: #d8e2e8;

      font-size: 12px;

      line-height: 1.5;
    }


    .detail-value a {

      color: #ff8530;

      text-decoration: none;
    }


    .detail-value a:hover {
      text-decoration: underline;
    }


    .focus-btn {

      width: 100%;

      margin-top: 10px;

      padding: 11px;

      border:
        1px solid
        rgba(255,110,20,.4);

      border-radius: 6px;

      background:
        rgba(255,110,20,.1);

      color: #ff9145;

      cursor: pointer;

      font-size: 11px;

      font-weight: 700;
    }


    .focus-btn:hover {

      background:
        rgba(255,110,20,.18);
    }


    /* =====================================================
       MOBILE
    ===================================================== */

    @media (max-width: 1000px) {

      .app {

        grid-template-columns:
          230px
          minmax(0,1fr);

        grid-template-rows:
          58px
          minmax(0,1fr);
      }


      .topbar {
        grid-column: 1 / 3;
      }


      .right-panel {
        display: none;
      }


      .left-panel {
        grid-column: 1;
      }


      .globe-panel {
        grid-column: 2;
      }

    }


    @media (max-width: 700px) {

      .app {

        grid-template-columns: 1fr;

        grid-template-rows:
          56px
          minmax(0,1fr);
      }


      .topbar {
        grid-column: 1;
      }


      .left-panel {

        position: absolute;

        left: 10px;
        top: 66px;

        width: 235px;

        height:
          calc(100vh - 76px);

        z-index: 30;

        border:
          1px solid
          rgba(255,255,255,.08);

        border-radius: 10px;

        box-shadow:
          0 10px 30px
          rgba(0,0,0,.5);
      }


      .globe-panel {

        grid-column: 1;
        grid-row: 2;
      }


      .brand-sub {
        display: none;
      }


      .top-btn {
        padding: 7px 9px;
      }

    }

  </style>

</head>



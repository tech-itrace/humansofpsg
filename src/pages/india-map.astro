---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>PSG World Network</title>

    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />
  </head>

  <body>
    <div class="app">

      <!-- TOP BAR -->
      <header class="topbar">
        <div class="brand">
          <div class="brand-mark">PSG</div>

          <div>
            <div class="brand-title">PSG WORLD</div>
            <div class="brand-subtitle">
              Humans of PSG
            </div>
          </div>
        </div>

        <div class="top-actions">
          <button id="randomBtn">Random</button>
          <button id="resetBtn">Reset</button>
        </div>
      </header>


      <!-- MAIN -->
      <main class="main">

        <!-- LEFT -->
        <aside class="left-panel">

          <div class="intro">
            <div class="eyebrow">GLOBAL NETWORK</div>

            <h1>
              PSGians<br />
              <span>around the world.</span>
            </h1>

            <p>
              Explore PSG branches and PSGians across the world.
            </p>
          </div>


          <div class="search-box">
            <span>⌕</span>

            <input
              id="searchInput"
              type="text"
              placeholder="Search city, person or branch..."
            />
          </div>


          <div class="location-header">
            <span>LOCATIONS</span>
            <strong id="count">20</strong>
          </div>


          <div id="locationList" class="location-list"></div>

        </aside>


        <!-- MAP -->
        <section class="map-panel">

          <div id="map"></div>

          <div class="map-help">
            <span>Drag</span> to move
            <span>Scroll</span> to zoom
            <span>Click</span> a marker
          </div>

        </section>


        <!-- RIGHT -->
        <aside id="detailsPanel" class="details-panel">

          <div class="empty-state">

            <div class="empty-icon">+</div>

            <h2>Select a location</h2>

            <p>
              Click a PSG marker on the world map
              or choose a city from the list.
            </p>

          </div>

        </aside>

      </main>

    </div>


    <script
      src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    ></script>


    <script
      id="psgLocationData"
      type="application/json"
      set:html={locationsJson}
    ></script>


    <script is:inline>
      const locations = JSON.parse(
        document.getElementById("psgLocationData").textContent
      );

      const map = L.map("map", {
        zoomControl: false,
        minZoom: 2,
        maxZoom: 7,
        worldCopyJump: true
      }).setView([20, 20], 2);


      L.control.zoom({
        position: "bottomright"
      }).addTo(map);


      /*
       * WORLD COUNTRY BOUNDARIES
       */
      fetch(
        "https://cdn.jsdelivr.net/npm/three-globe/example/country-polygons/ne_110m_admin_0_countries.geojson"
      )
        .then(response => response.json())
        .then(world => {

          L.geoJSON(world, {

            style: {
              color: "#26364b",
              weight: 1,
              fillColor: "#111c2c",
              fillOpacity: 0.92
            },

            onEachFeature: (feature, layer) => {

              layer.on({

                mouseover: event => {
                  event.target.setStyle({
                    fillColor: "#1b3048",
                    color: "#607d9d",
                    weight: 1.2
                  });
                },

                mouseout: event => {
                  event.target.setStyle({
                    fillColor: "#111c2c",
                    color: "#26364b",
                    weight: 1
                  });
                }

              });

              const name =
                feature.properties?.ADMIN ||
                feature.properties?.NAME ||
                "";

              if (name) {
                layer.bindTooltip(name, {
                  sticky: true,
                  className: "country-tooltip"
                });
              }
            }

          }).addTo(map);

        })
        .catch(error => {
          console.error("World GeoJSON failed:", error);
        });


      /*
       * PSG MARKERS
       */

      const markerLayer = L.layerGroup().addTo(map);

      const markerObjects = [];


      function createMarker(location) {

        const marker = L.circleMarker(
          [location.lat, location.lng],
          {
            radius: 7,
            color: "#ffffff",
            weight: 2,
            fillColor: "#ff6b35",
            fillOpacity: 1
          }
        );


        marker.bindTooltip(
          `<strong>${location.city}</strong><br>${location.branch}`,
          {
            direction: "top",
            offset: [0, -8]
          }
        );


        marker.on("click", () => {
          showDetails(location);

          map.flyTo(
            [location.lat, location.lng],
            5,
            {
              duration: 1.2
            }
          );
        });


        marker.addTo(markerLayer);

        markerObjects.push({
          marker,
          location
        });

        return marker;
      }


      locations.forEach(createMarker);


      /*
       * DETAILS PANEL
       */

      function showDetails(location) {

        const panel =
          document.getElementById("detailsPanel");

        panel.innerHTML = `

          <div class="details-content">

            <button
              class="close-btn"
              id="closeDetails"
            >
              ×
            </button>


            <div class="detail-label">
              PSG NETWORK
            </div>


            <div class="person-avatar">
              ${location.person
                .split(" ")
                .map(word => word[0])
                .slice(0, 2)
                .join("")
                .toUpperCase()}
            </div>


            <h2 class="person-name">
              ${location.person}
            </h2>


            <div class="person-role">
              ${location.role}
            </div>


            <div class="location-name">
              ${location.city}
            </div>


            <div class="branch-name">
              ${location.branch}
            </div>


            <div class="info-list">

              <div class="info-row">
                <span>Country</span>
                <strong>${location.country}</strong>
              </div>

              ${
                location.state
                  ? `
                    <div class="info-row">
                      <span>State</span>
                      <strong>${location.state}</strong>
                    </div>
                  `
                  : ""
              }

              <div class="info-row">
                <span>Address</span>
                <strong>${location.address}</strong>
              </div>

              <div class="info-row">
                <span>Phone</span>
                <strong>${location.phone}</strong>
              </div>

              <div class="info-row">
                <span>Email</span>
                <strong>${location.email}</strong>
              </div>

            </div>


            <button
              class="focus-btn"
              id="focusBtn"
            >
              Focus on location
            </button>

          </div>
        `;


        document
          .getElementById("closeDetails")
          ?.addEventListener("click", () => {

            panel.innerHTML = `
              <div class="empty-state">
                <div class="empty-icon">+</div>
                <h2>Select a location</h2>
                <p>
                  Click a PSG marker on the world map
                  or choose a city from the list.
                </p>
              </div>
            `;

          });


        document
          .getElementById("focusBtn")
          ?.addEventListener("click", () => {

            map.flyTo(
              [location.lat, location.lng],
              6,
              {
                duration: 1
              }
            );

          });


        markerObjects.forEach(item => {

          item.marker.setStyle({
            radius:
              item.location.id === location.id
                ? 11
                : 7,

            fillColor:
              item.location.id === location.id
                ? "#ffffff"
                : "#ff6b35",

            color:
              item.location.id === location.id
                ? "#ff6b35"
                : "#ffffff"
          });

        });

      }


      /*
       * LOCATION LIST
       */

      const list =
        document.getElementById("locationList");

      const count =
        document.getElementById("count");


      function renderList(items) {

        list.innerHTML = "";

        count.textContent = items.length;


        items.forEach(location => {

          const button =
            document.createElement("button");

          button.className = "location-item";

          button.innerHTML = `
            <span class="location-dot"></span>

            <span class="location-text">
              <strong>${location.city}</strong>
              <small>
                ${location.country}
              </small>
            </span>
          `;


          button.addEventListener("click", () => {

            showDetails(location);

            map.flyTo(
              [location.lat, location.lng],
              5,
              {
                duration: 1.2
              }
            );

          });


          list.appendChild(button);

        });

      }


      renderList(locations);


      /*
       * SEARCH
       */

      document
        .getElementById("searchInput")
        .addEventListener("input", event => {

          const query =
            event.target.value
              .toLowerCase()
              .trim();


          const filtered =
            locations.filter(location => {

              return (

                location.city
                  .toLowerCase()
                  .includes(query)

                ||

                location.country
                  .toLowerCase()
                  .includes(query)

                ||

                location.branch
                  .toLowerCase()
                  .includes(query)

                ||

                location.person
                  .toLowerCase()
                  .includes(query)

                ||

                location.role
                  .toLowerCase()
                  .includes(query)

              );

            });


          renderList(filtered);


          markerObjects.forEach(item => {

            const visible =
              filtered.some(
                location =>
                  location.id ===
                  item.location.id
              );

            if (visible) {
              item.marker.addTo(markerLayer);
            } else {
              markerLayer.removeLayer(
                item.marker
              );
            }

          });

        });


      /*
       * RANDOM
       */

      document
        .getElementById("randomBtn")
        .addEventListener("click", () => {

          const random =
            locations[
              Math.floor(
                Math.random() *
                locations.length
              )
            ];

          showDetails(random);

          map.flyTo(
            [random.lat, random.lng],
            5,
            {
              duration: 1.5
            }
          );

        });


      /*
       * RESET
       */

      document
        .getElementById("resetBtn")
        .addEventListener("click", () => {

          document
            .getElementById("searchInput")
            .value = "";

          renderList(locations);

          markerObjects.forEach(item => {
            item.marker.addTo(markerLayer);
            item.marker.setStyle({
              radius: 7,
              fillColor: "#ff6b35",
              color: "#ffffff"
            });
          });


          map.flyTo(
            [20, 20],
            2,
            {
              duration: 1
            }
          );

        });
    </script>
  </body>
</html>


<style is:global>

  * {
    box-sizing: border-box;
  }


  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family:
      Inter,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    background: #060a10;
    color: #ffffff;
  }


  button,
  input {
    font: inherit;
  }


  .app {
    width: 100vw;
    height: 100vh;
    background: #060a10;
  }


  /* TOP */

  .topbar {
    height: 72px;
    padding: 0 28px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    border-bottom: 1px solid #182230;

    background: #080d15;
  }


  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }


  .brand-mark {
    width: 38px;
    height: 38px;

    display: grid;
    place-items: center;

    border-radius: 9px;

    background: #ffffff;
    color: #060a10;

    font-size: 11px;
    font-weight: 900;
  }


  .brand-title {
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }


  .brand-subtitle {
    margin-top: 2px;

    font-size: 11px;
    color: #7f8da0;
  }


  .top-actions {
    display: flex;
    gap: 8px;
  }


  .top-actions button {
    border: 1px solid #293548;

    background: #0c131e;
    color: #cbd5e1;

    padding: 9px 15px;

    border-radius: 7px;

    cursor: pointer;
  }


  .top-actions button:hover {
    background: #162132;
  }


  /* MAIN */

  .main {
    height: calc(100vh - 72px);

    display: grid;

    grid-template-columns:
      310px
      minmax(0, 1fr)
      330px;
  }


  /* LEFT */

  .left-panel {
    overflow-y: auto;

    padding: 32px 22px;

    border-right: 1px solid #182230;

    background: #080d15;
  }


  .eyebrow {
    margin-bottom: 12px;

    color: #7c8ca2;

    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2px;
  }


  .intro h1 {
    margin: 0;

    font-size: 30px;
    line-height: 1.05;
    letter-spacing: -1.2px;
  }


  .intro h1 span {
    color: #6f8095;
  }


  .intro p {
    margin: 16px 0 25px;

    color: #8391a4;

    font-size: 13px;
    line-height: 1.6;
  }


  .search-box {
    height: 42px;

    display: flex;
    align-items: center;

    gap: 8px;

    padding: 0 12px;

    border: 1px solid #263244;
    border-radius: 7px;

    background: #0c131e;
  }


  .search-box span {
    color: #708097;
    font-size: 20px;
  }


  .search-box input {
    width: 100%;

    outline: none;
    border: 0;

    background: transparent;
    color: white;

    font-size: 12px;
  }


  .search-box input::placeholder {
    color: #647286;
  }


  .location-header {
    margin: 28px 0 12px;

    display: flex;
    justify-content: space-between;

    color: #718096;

    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }


  .location-header strong {
    color: #ffffff;
  }


  .location-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }


  .location-item {
    width: 100%;

    display: flex;
    align-items: center;

    gap: 12px;

    padding: 10px;

    border: 0;
    border-radius: 7px;

    background: transparent;
    color: white;

    text-align: left;

    cursor: pointer;
  }


  .location-item:hover {
    background: #111b29;
  }


  .location-dot {
    width: 7px;
    height: 7px;

    flex: 0 0 auto;

    border-radius: 50%;

    background: #ff6b35;

    box-shadow:
      0 0 0 4px rgba(255, 107, 53, 0.1);
  }


  .location-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }


  .location-text strong {
    font-size: 12px;
    font-weight: 600;
  }


  .location-text small {
    color: #69788c;
    font-size: 10px;
  }


  /* MAP */

  .map-panel {
    position: relative;

    min-width: 0;

    background:
      radial-gradient(
        circle at center,
        #0c1828 0%,
        #060a10 70%
      );
  }


  #map {
    width: 100%;
    height: 100%;

    background: #060a10;
  }


  .leaflet-container {
    background: #060a10;
    font-family: inherit;
  }


  .leaflet-control-zoom {
    border: 1px solid #293548 !important;
  }


  .leaflet-control-zoom a {

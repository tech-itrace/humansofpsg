/* =====================================================
   DOM
===================================================== */

const globeContainer =
  document.getElementById("globe");

const loading =
  document.getElementById("loading");

const loadingText =
  document.getElementById("loadingText");

const locationList =
  document.getElementById("locationList");

const locationCount =
  document.getElementById("locationCount");

const searchInput =
  document.getElementById("searchInput");

const countrySelected =
  document.getElementById("countrySelected");

const detailsEmpty =
  document.getElementById("detailsEmpty");

const details =
  document.getElementById("details");

const detailCountry =
  document.getElementById("detailCountry");

const detailName =
  document.getElementById("detailName");

const detailRole =
  document.getElementById("detailRole");

const detailBranch =
  document.getElementById("detailBranch");

const detailAddress =
  document.getElementById("detailAddress");

const detailPhone =
  document.getElementById("detailPhone");

const detailEmail =
  document.getElementById("detailEmail");

const focusBtn =
  document.getElementById("focusBtn");


/* =====================================================
   STATE
===================================================== */

let globe = null;

let countryData = [];

let selectedLocation = null;

let selectedCountryCode = null;

let selectedCountryName = null;


/* =====================================================
   COUNTRY HELPERS
===================================================== */

function getCountryName(feature) {

  const p =
    feature?.properties || {};

  return (
    p.ADMIN ||
    p.NAME_LONG ||
    p.NAME ||
    p.name ||
    "Country"
  );
}


function getCountryCode(feature) {

  const p =
    feature?.properties || {};

  const values = [

    p.ISO_A3,
    p.ADM0_A3,
    p.GU_A3,
    p.SOV_A3,
    p.WB_A3

  ];

  for (
    const value of values
  ) {

    if (
      value &&
      value !== "-99"
    ) {

      return String(value)
        .toUpperCase();
    }

  }

  return null;
}


function normalize(value) {

  return String(value || "")
    .toLowerCase()
    .trim()
    .replace(
      /[^a-z0-9]/g,
      ""
    );
}


/* =====================================================
   FIND PSG LOCATIONS FOR COUNTRY
===================================================== */

function getLocationsForCountry(
  countryCode,
  countryName
) {

  let result = [];


  if (countryCode) {

    result =
      locations.filter(
        item =>
          item.countryCode ===
          countryCode
      );

  }


  /*
    Important fallback:
    If GeoJSON country code
    does not match, use name.
  */

  if (!result.length) {

    const normalizedCountry =
      normalize(countryName);

    result =
      locations.filter(
        item =>
          normalize(item.country) ===
          normalizedCountry
      );

  }


  return result;
}


/* =====================================================
   RENDER LEFT PANEL
===================================================== */

function renderLocations() {

  let list =
    locations.slice();


  /* COUNTRY FILTER */

  if (selectedCountryCode) {

    list =
      getLocationsForCountry(
        selectedCountryCode,
        selectedCountryName
      );

  }


  /* SEARCH */

  const query =
    searchInput.value
      .trim()
      .toLowerCase();


  if (query) {

    list =
      list.filter(
        item =>

          item.name
            .toLowerCase()
            .includes(query)

          ||

          item.country
            .toLowerCase()
            .includes(query)

          ||

          item.branch
            .toLowerCase()
            .includes(query)

          ||

          item.address
            .toLowerCase()
            .includes(query)
      );

  }


  locationList.innerHTML = "";


  locationCount.textContent =
    `${list.length} LOCATION${
      list.length === 1
        ? ""
        : "S"
    }`;


  if (!list.length) {

    locationList.innerHTML = `

      <div class="empty-list">

        ${
          selectedCountryName
            ? `
              No PSG locations
              in ${selectedCountryName}.
            `
            : `
              No PSG locations found.
            `
        }

      </div>

    `;

    return;
  }


  /* CREATE LOCATION BUTTONS */

  list.forEach(
    location => {

      const button =
        document.createElement(
          "button"
        );


      button.type =
        "button";


      button.className =
        "location-item";


      button.dataset.id =
        location.id;


      button.innerHTML = `

        <span class="location-dot"></span>

        <span style="min-width:0">

          <div class="location-name">
            ${location.name}
          </div>

          <div class="location-meta">
            ${location.country}
          </div>

        </span>

      `;


      button.addEventListener(
        "click",
        () => {

          showLocation(
            location
          );

        }
      );


      locationList.appendChild(
        button
      );

    }
  );


  /* ACTIVE LOCATION */

  if (selectedLocation) {

    const active =
      document.querySelector(
        `.location-item[data-id="${selectedLocation.id}"]`
      );

    if (active) {

      active.classList.add(
        "active"
      );

    }

  }

}


/* =====================================================
   SHOW LOCATION DETAILS
===================================================== */

function showLocation(location) {

  selectedLocation =
    location;


  /*
    IMPORTANT:

    If user clicked an orange
    PSG point directly, automatically
    select that point's country.

    Therefore left panel will show
    ALL PSG locations in that country.
  */

  selectedCountryCode =
    location.countryCode;

  selectedCountryName =
    location.country;


  countrySelected.textContent =
    `✕ ${location.country}`;


  searchInput.value =
    "";


  renderLocations();


  /* RIGHT DETAILS */

  detailsEmpty.style.display =
    "none";

  details.classList.add(
    "show"
  );


  detailCountry.textContent =
    location.country;


  detailName.textContent =
    location.name;


  detailRole.textContent =
    location.role;


  detailBranch.textContent =
    location.branch;


  detailAddress.textContent =
    location.address;


  detailPhone.innerHTML = `

    <a href="tel:${location.phone}">
      ${location.phone}
    </a>

  `;


  detailEmail.innerHTML = `

    <a href="mailto:${location.email}">
      ${location.email}
    </a>

  `;


  /*
    Focus location
  */

  if (globe) {

    globe.pointOfView(

      {
        lat: location.lat,
        lng: location.lng,
        altitude: 1.45
      },

      1000

    );


    globe.controls()
      .autoRotate = false;

  }

}


/* =====================================================
   SHOW COUNTRY
===================================================== */

function showCountry(
  countryName,
  countryCode,
  polygon
) {

  selectedLocation =
    null;


  selectedCountryCode =
    countryCode;


  selectedCountryName =
    countryName;


  /*
    Get ALL locations
    inside clicked country.
  */

  const countryLocations =
    getLocationsForCountry(
      countryCode,
      countryName
    );


  /*
    LEFT PANEL
  */

  countrySelected.textContent =
    `✕ ${countryName}`;


  searchInput.value =
    "";


  renderLocations();


  /*
    RIGHT PANEL
  */

  detailsEmpty.style.display =
    "none";


  details.classList.add(
    "show"
  );


  detailCountry.textContent =
    "COUNTRY";


  detailName.textContent =
    countryName;


  detailRole.textContent =
    "Country selected";


  detailBranch.textContent =
    `${countryLocations.length} PSG location${
      countryLocations.length === 1
        ? ""
        : "s"
    }`;


  if (countryLocations.length) {

    detailAddress.textContent =
      countryLocations
        .map(
          item =>
            item.name
        )
        .join(", ");

  } else {

    detailAddress.textContent =
      "No PSG location available";

  }


  detailPhone.textContent =
    "-";

  detailEmail.textContent =
    "-";


  /*
    COUNTRY CENTER

    If PSG locations exist,
    calculate their center.
  */

  let lat = 20;

  let lng = 0;


  if (
    countryLocations.length
  ) {

    lat =
      countryLocations.reduce(
        (sum, item) =>
          sum + item.lat,
        0
      ) /
      countryLocations.length;


    lng =
      countryLocations.reduce(
        (sum, item) =>
          sum + item.lng,
        0
      ) /
      countryLocations.length;

  }


  /*
    Better centers
  */

  const centers = {

    IND: {
      lat: 20.5937,
      lng: 78.9629
    },

    SGP: {
      lat: 1.3521,
      lng: 103.8198
    },

    ARE: {
      lat: 23.4241,
      lng: 53.8478
    }

  };


  if (
    centers[countryCode]
  ) {

    lat =
      centers[countryCode].lat;

    lng =
      centers[countryCode].lng;

  }


  if (globe) {

    globe.pointOfView(

      {
        lat,
        lng,
        altitude:
          countryLocations.length <= 1
            ? 1.45
            : 1.75
      },

      1200

    );


    globe.controls()
      .autoRotate = false;

  }


  /*
    Highlight selected country.
  */

  updateCountryColors();

}


/* =====================================================
   COUNTRY COLORS
===================================================== */

function updateCountryColors() {

  if (!globe) return;


  globe.polygonCapColor(
    feature => {

      const code =
        getCountryCode(
          feature
        );


      if (
        selectedCountryCode &&
        code ===
        selectedCountryCode
      ) {

        return "#2c6682";

      }


      return "#173444";

    }
  );

}


/* =====================================================
   SEARCH
===================================================== */

searchInput.addEventListener(
  "input",
  () => {

    renderLocations();

  }
);


/* =====================================================
   CLEAR COUNTRY
===================================================== */

countrySelected.addEventListener(
  "click",
  () => {

    selectedCountryCode =
      null;

    selectedCountryName =
      null;

    selectedLocation =
      null;


    countrySelected.textContent =
      "🌍 All Countries";


    searchInput.value =
      "";


    renderLocations();


    detailsEmpty.style.display =
      "flex";


    details.classList.remove(
      "show"
    );


    if (globe) {

      globe
        .polygonCapColor(
          () =>
            "#173444"
        );

    }

  }
);


/* =====================================================
   LOAD GEOJSON
===================================================== */

async function loadCountries() {

  const url =
    "https://cdn.jsdelivr.net/npm/three-globe/example/country-polygons/ne_110m_admin_0_countries.geojson";


  const response =
    await fetch(url);


  if (!response.ok) {

    throw new Error(
      "Country GeoJSON could not be loaded"
    );

  }


  const data =
    await response.json();


  return data.features || [];

}


/* =====================================================
   CREATE GLOBE
===================================================== */

async function createGlobe() {

  try {

    loadingText.textContent =
      "Loading countries...";


    countryData =
      await loadCountries();


    loadingText.textContent =
      "Building 3D globe...";


    globe =
      Globe({

        animateIn: true,

        waitForGlobeReady: false

      })(globeContainer);


    /* =================================================
       GLOBE
    ================================================= */

    globe

      .globeImageUrl(null)

      .backgroundColor(
        "rgba(0,0,0,0)"
      )

      .showAtmosphere(true)

      .atmosphereColor(
        "#1c8ed1"
      )

      .atmosphereAltitude(
        0.13
      );


    /* =================================================
       COUNTRIES
    ================================================= */

    globe

      .polygonsData(
        countryData
      )

      .polygonGeoJsonGeometry(
        feature =>
          feature.geometry
      )

      .polygonCapColor(
        () =>
          "#173444"
      )

      .polygonSideColor(
        () =>
          "rgba(15,48,65,.85)"
      )

      .polygonStrokeColor(
        () =>
          "#4f7183"
      )

      .polygonAltitude(
        0.006
      )


      /*
        COUNTRY LABEL
      */

      .polygonLabel(
        feature => {

          const name =
            getCountryName(
              feature
            );


          const code =
            getCountryCode(
              feature
            );


          const count =
            getLocationsForCountry(
              code,
              name
            ).length;


          return `

            <div style="
              background:#07121b;
              border:1px solid
                rgba(255,255,255,.15);
              color:#fff;
              padding:8px 10px;
              border-radius:5px;
              font-size:11px;
            ">

              <strong>
                ${name}
              </strong>

              ${
                count
                  ? `
                    <br>

                    <span style="
                      color:#ff9145;
                      font-size:10px;
                    ">

                      ${count}
                      PSG location${
                        count === 1
                          ? ""
                          : "s"
                      }

                    </span>
                  `
                  : ""
              }

            </div>

          `;

        }
      )


      /*
        HOVER
      */

      .onPolygonHover(
        (polygon) => {

          globe
            .polygonCapColor(
              feature => {

                const code =
                  getCountryCode(
                    feature
                  );


                if (
                  feature ===
                  polygon
                ) {

                  return "#28566c";

                }


                if (
                  selectedCountryCode &&
                  code ===
                  selectedCountryCode
                ) {

                  return "#2c6682";

                }


                return "#173444";

              }
            );

        }
      )


      /*
        =================================================
        IMPORTANT COUNTRY CLICK
        =================================================

        Click any country
        -> left panel changes
        -> all PSG locations in that country
        -> country focus
      */

      .onPolygonClick(
        polygon => {

          if (!polygon) return;


          const countryName =
            getCountryName(
              polygon
            );


          const countryCode =
            getCountryCode(
              polygon
            );


          showCountry(
            countryName,
            countryCode,
            polygon
          );

        }
      );


    /* =================================================
       PSG POINTS
    ================================================= */

    globe

      .pointsData(
        locations
      )

      .pointLat(
        item =>
          item.lat
      )

      .pointLng(
        item =>
          item.lng
      )

      .pointAltitude(
        0.025
      )

      .pointRadius(
        0.35
      )

      .pointColor(
        () =>
          "#ff7418"
      )

      .pointResolution(
        12
      )


      .pointLabel(
        location => `

          <div style="
            background:#07121b;
            color:#fff;
            border:
              1px solid
              rgba(255,110,20,.5);
            padding:8px 10px;
            border-radius:6px;
            font-size:11px;
          ">

            <strong>
              ${location.name}
            </strong>

            <br>

            <span style="
              color:#899daa;
              font-size:10px;
            ">

              ${location.country}

            </span>

          </div>

        `
      )


      /*
        ORANGE POINT CLICK

        This now also changes
        left panel to that country.
      */

      .onPointClick(
        location => {

          showLocation(
            location
          );

        }
      );


    /* =================================================
       CONTROLS
    ================================================= */

    const controls =
      globe.controls();


    controls.enablePan =
      false;

    controls.enableZoom =
      true;

    controls.enableDamping =
      true;

    controls.dampingFactor =
      0.08;

    controls.minDistance =
      180;

    controls.maxDistance =
      500;


    controls.autoRotate =
      true;

    controls.autoRotateSpeed =
      0.35;


    /* =================================================
       INITIAL CAMERA
    ================================================= */

    globe.pointOfView(

      {
        lat: 20,
        lng: 78,
        altitude: 2.25
      },

      0

    );


    /* =================================================
       LOADING OFF
    ================================================= */

    setTimeout(
      () => {

        loading.classList.add(
          "hidden"
        );

      },
      700
    );


    console.log(
      "PSG World 3D Globe loaded"
    );

  }

  catch (error) {

    console.error(
      error
    );


    loadingText.innerHTML = `

      <div style="
        color:#ff8a5b;
        max-width:280px;
        line-height:1.6;
      ">

        Unable to load the 3D globe.

        <br><br>

        Please check your internet
        connection and reload.

      </div>

    `;

  }

}


/* =====================================================
   RANDOM
===================================================== */

document
  .getElementById("randomBtn")
  .addEventListener(
    "click",
    () => {

      let list =
        locations;


      if (
        selectedCountryCode
      ) {

        list =
          getLocationsForCountry(
            selectedCountryCode,
            selectedCountryName
          );

      }


      if (!list.length)
        return;


      const random =
        list[
          Math.floor(
            Math.random() *
            list.length
          )
        ];


      showLocation(
        random
      );

    }
  );


/* =====================================================
   RESET
===================================================== */

document
  .getElementById("resetBtn")
  .addEventListener(
    "click",
    () => {

      selectedCountryCode =
        null;

      selectedCountryName =
        null;

      selectedLocation =
        null;


      countrySelected.textContent =
        "🌍 All Countries";


      searchInput.value =
        "";


      renderLocations();


      detailsEmpty.style.display =
        "flex";


      details.classList.remove(
        "show"
      );


      if (globe) {

        globe
          .polygonCapColor(
            () =>
              "#173444"
          );


        globe.pointOfView(

          {
            lat: 20,
            lng: 78,
            altitude: 2.25
          },

          1000

        );


        globe.controls()
          .autoRotate = true;

      }

    }
  );


/* =====================================================
   ZOOM IN
===================================================== */

document
  .getElementById("zoomIn")
  .addEventListener(
    "click",
    () => {

      if (!globe) return;


      const controls =
        globe.controls();


      controls.dollyIn(
        1.25
      );


      controls.update();

    }
  );


/* =====================================================
   ZOOM OUT
===================================================== */

document
  .getElementById("zoomOut")
  .addEventListener(
    "click",
    () => {

      if (!globe) return;


      const controls =
        globe.controls();


      controls.dollyOut(
        1.25
      );


      controls.update();

    }
  );


/* =====================================================
   FOCUS
===================================================== */

focusBtn.addEventListener(
  "click",
  () => {

    if (
      !globe ||
      !selectedLocation
    ) return;


    globe.pointOfView(

      {
        lat:
          selectedLocation.lat,

        lng:
          selectedLocation.lng,

        altitude: 1.45
      },

      1000

    );


    globe.controls()
      .autoRotate = false;

  }
);


/* =====================================================
   INITIAL
===================================================== */

renderLocations();

createGlobe();

</script>


<script define:vars={{ locations }}>

  const emptyState = document.getElementById("empty-state");
  const details = document.getElementById("location-details");

  const detailCity = document.getElementById("detail-city");
  const detailCity2 = document.getElementById("detail-city-2");
  const detailName = document.getElementById("detail-name");
  const detailBranch = document.getElementById("detail-branch");
  const detailAddress = document.getElementById("detail-address");
  const detailPhone = document.getElementById("detail-phone");
  const detailEmail = document.getElementById("detail-email");


  function showLocation(cityId) {

    const location = locations.find(
      (item) => item.id === cityId
    );

    if (!location) return;

    emptyState.classList.add("hidden");
    details.classList.remove("hidden");

    detailCity.textContent = location.city;
    detailCity2.textContent = location.city;
    detailName.textContent = location.name;
    detailBranch.textContent = location.branch;
    detailAddress.textContent = location.address;
    detailPhone.textContent = location.phone;
    detailEmail.textContent = location.email;

    // Highlight selected markers
    document
      .querySelectorAll(".city-marker")
      .forEach((marker) => {
        marker.classList.remove("selected");

        if (marker.dataset.city === cityId) {
          marker.classList.add("selected");
        }
      });
  }


  document
    .querySelectorAll("[data-city]")
    .forEach((element) => {

      element.addEventListener("click", () => {

        const cityId = element.dataset.city;

        showLocation(cityId);

      });

    });

</script>

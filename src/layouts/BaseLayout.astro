---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description = 'Humans of PSG | Stories from every PSGian, near and far.',
  image,
  structuredData,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Humans of PSG',
  url: 'https://www.humansofpsg.org',
  logo: 'https://www.humansofpsg.org/favicon-512.png',
  sameAs: [
    'https://www.instagram.com/hop_humansofpsg',
    'https://www.linkedin.com/company/humansofpsg',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Humans of PSG',
  url: Astro.site?.toString(),
  description: 'The Milestones archive of the Humans of PSG 5M framework — stories of the PSG alumni community.',
  publisher: {
    '@type': 'Organization',
    name: 'Humans of PSG',
    url: 'https://www.humansofpsg.org',
    sameAs: [
      'https://www.instagram.com/hop_humansofpsg',
      'https://www.linkedin.com/company/humansofpsg',
    ],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Jost:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="alternate" type="application/rss+xml" title="Humans of PSG" href={`${base}rss.xml`} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <title>{title}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
    {structuredData && <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      document.documentElement.classList.add('js-reveal-ready');

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
    <script>
      // Right-click content protection, matching humansofpsg.org: block the
      // native context menu and show a small "HOP © Copyright" toast instead.
      let rcToast: HTMLDivElement | null = null;
      let rcHideTimer: ReturnType<typeof setTimeout> | undefined;

      const hideRcToast = () => {
        rcToast?.classList.remove('is-visible');
      };

      document.addEventListener('contextmenu', (event) => {
        event.preventDefault();

        if (!rcToast) {
          rcToast = document.createElement('div');
          rcToast.className = 'rc-protect-toast';
          rcToast.textContent = 'HOP © Copyright';
          document.body.appendChild(rcToast);
        }

        const { clientX, clientY } = event;
        const offset = 12;
        rcToast.style.left = `${clientX + offset}px`;
        rcToast.style.top = `${clientY + offset}px`;
        rcToast.classList.add('is-visible');

        clearTimeout(rcHideTimer);
        rcHideTimer = setTimeout(hideRcToast, 1800);
      });

      document.addEventListener('click', hideRcToast);
      document.addEventListener('scroll', hideRcToast, { passive: true });

      // Discourage casual image dragging/copying alongside the context menu.
      document.addEventListener('dragstart', (event) => {
        if ((event.target as HTMLElement)?.tagName === 'IMG') {
          event.preventDefault();
        }
      });
    </script>
  </body>
</html>
